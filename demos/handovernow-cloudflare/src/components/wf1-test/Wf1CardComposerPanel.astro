---
import ActionForm from "../rental/ActionForm.astro";

interface Props {
	availableCardTypes: Array<Record<string, unknown>>;
	workflowInstanceId: string;
	workspaceHref: string;
	viewerRole?: string;
}

type McqOption = {
	value: string;
	label: string;
};

const { availableCardTypes, workflowInstanceId, workspaceHref, viewerRole = "unknown" } = Astro.props;
const ownerView = viewerRole === "owner";

function objectValue(value: unknown): Record<string, unknown> {
	return value && typeof value === "object" && !Array.isArray(value)
		? value as Record<string, unknown>
		: {};
}

function uiFor(cardType: Record<string, unknown>) {
	return objectValue(cardType.ui);
}

function answerSchemaFor(cardType: Record<string, unknown>) {
	return objectValue(cardType.answerSchema);
}

function isCustomMcqTask(cardTypeId: string): boolean {
	return cardTypeId === "mcq_single" ||
		cardTypeId === "mcq_single_required_evidence" ||
		cardTypeId === "mcq_multi" ||
		cardTypeId === "mcq_multi_required_evidence";
}

function isRequiredEvidenceTask(cardTypeId: string): boolean {
	return cardTypeId.includes("required_evidence");
}

function panelKicker(): string {
	return ownerView ? "Applicant requests" : "Owner updates";
}

function panelTitle(): string {
	return ownerView ? "Need something from the applicant?" : "Need to tell the owner something?";
}

function panelDescription(): string {
	return ownerView
		? "Create a request card. The applicant answers it in their workspace; evidence cards can require image/PDF proof."
		: "Send an update or acknowledgement card to the owner. Owner-facing cards appear in the same work queue.";
}

function openButtonLabel(): string {
	return ownerView ? "Request from applicant" : "Send update to owner";
}

function stepTitle(): string {
	return ownerView ? "Choose what you need" : "Choose what to send";
}

function stepDescription(): string {
	return ownerView
		? "Select a request type. The exact compose form appears only after you choose."
		: "Select the update type. The exact compose form appears only after you choose.";
}

function emptyComposerText(): string {
	return ownerView
		? "Choose one request type above. The owner creates the card; the applicant answers it."
		: "Choose one update type above. You send the card; the owner sees it in their work queue.";
}

function noTypesText(): string {
	return ownerView
		? "No applicant request card types are available for your role now."
		: "No owner update card types are available for your role now.";
}

function requestTypeLabel(): string {
	return ownerView ? "Request type" : "Update type";
}

function requestTitleFor(cardTypeId: string, fallback: unknown): string {
	if (cardTypeId === "info_ack_to_counterparty" || cardTypeId === "info_ack_to_owner") {
		return ownerView ? "Send information" : "Send information to owner";
	}

	if (cardTypeId === "mcq_single") {
		return ownerView ? "Ask yes/no or single-choice" : "Ask owner yes/no";
	}

	if (cardTypeId === "mcq_single_required_evidence") {
		return ownerView ? "Ask choice + request proof" : "Ask owner choice + proof";
	}

	if (cardTypeId === "mcq_multi") {
		return ownerView ? "Ask checklist" : "Send checklist to owner";
	}

	if (cardTypeId === "mcq_multi_required_evidence") {
		return ownerView ? "Ask checklist + request proof" : "Send checklist + proof request";
	}

	if (cardTypeId === "free_text") {
		return ownerView ? "Ask written question" : "Send written update";
	}

	if (cardTypeId === "free_text_required_evidence") {
		return ownerView ? "Request document or evidence" : "Send update with evidence";
	}

	return String(fallback ?? cardTypeId);
}

function requestDescriptionFor(cardTypeId: string, fallback: unknown): string {
	if (cardTypeId === "info_ack_to_counterparty" || cardTypeId === "info_ack_to_owner") {
		return ownerView
			? "Tell the applicant something and ask them to acknowledge."
			: "Tell the owner something and ask them to acknowledge.";
	}

	if (cardTypeId === "mcq_single") {
		return ownerView
			? "Ask one question where the applicant chooses one answer."
			: "Ask one question where the owner chooses one answer.";
	}

	if (cardTypeId === "mcq_single_required_evidence") {
		return ownerView
			? "Ask one question and require image/PDF evidence."
			: "Ask one question and require image/PDF evidence from the owner.";
	}

	if (cardTypeId === "mcq_multi") {
		return ownerView
			? "Ask the applicant to select all matching items."
			: "Ask the owner to select all matching items.";
	}

	if (cardTypeId === "mcq_multi_required_evidence") {
		return ownerView
			? "Ask for multiple selections and require image/PDF evidence."
			: "Ask for multiple selections and require image/PDF evidence from the owner.";
	}

	if (cardTypeId === "free_text") {
		return ownerView ? "Ask for a written reply." : "Send a written update.";
	}

	if (cardTypeId === "free_text_required_evidence") {
		return ownerView
			? "Ask for a written reply with image/PDF evidence."
			: "Send or request a written reply with image/PDF evidence.";
	}

	return String(fallback ?? "Create a workflow card.");
}

function shortHelpFor(cardTypeId: string, fallback: unknown): string {
	if (cardTypeId === "info_ack_to_counterparty" || cardTypeId === "info_ack_to_owner") {
		return ownerView
			? "This creates an acknowledgement card. The applicant confirms they have read it."
			: "This creates an acknowledgement card for the owner.";
	}

	if (cardTypeId === "mcq_single") {
		return ownerView
			? "This creates a single-choice request card for the applicant."
			: "This creates a single-choice card for the owner.";
	}

	if (cardTypeId === "mcq_single_required_evidence") {
		return ownerView
			? "This creates a required request card. The applicant must choose one answer and attach proof."
			: "This creates a required card. The owner must choose one answer and attach proof.";
	}

	if (cardTypeId === "mcq_multi") {
		return ownerView
			? "This creates a checklist-style request card for the applicant."
			: "This creates a checklist-style card for the owner.";
	}

	if (cardTypeId === "mcq_multi_required_evidence") {
		return ownerView
			? "This creates a required checklist card. The applicant must answer and attach proof."
			: "This creates a required checklist card. The owner must answer and attach proof.";
	}

	if (cardTypeId === "free_text") {
		return ownerView
			? "This creates a written-answer request card for the applicant."
			: "This creates a written update card for the owner.";
	}

	if (cardTypeId === "free_text_required_evidence") {
		return ownerView
			? "This creates a required evidence card. The applicant must answer and attach image/PDF evidence."
			: "This creates a required evidence card for the owner.";
	}

	return String(fallback ?? "Create a task card.");
}

function promptPlaceholderFor(cardTypeId: string, fallback: unknown): string {
	if (cardTypeId === "mcq_single" || cardTypeId === "mcq_single_required_evidence") {
		return ownerView
			? "Example: Do you agree to the 11-month minimum stay and security deposit deduction terms?"
			: "Example: Do you approve this move-in timing?";
	}

	if (cardTypeId === "mcq_multi" || cardTypeId === "mcq_multi_required_evidence") {
		return ownerView
			? "Example: Which items have you received in working condition?"
			: "Example: Which owner approvals are pending?";
	}

	if (cardTypeId === "info_ack_to_counterparty" || cardTypeId === "info_ack_to_owner") {
		return ownerView
			? "Example: Please note that society move-in timing is 9 AM to 5 PM."
			: "Example: I have reviewed the move-in timing and will follow it.";
	}

	if (cardTypeId === "free_text" || cardTypeId === "free_text_required_evidence") {
		return ownerView
			? "Example: Please confirm your planned move-in date and who will be staying."
			: "Example: I want to share an update about my move-in plan.";
	}

	return String(fallback ?? "Write the card clearly.");
}

function mcqOptionsFor(cardType: Record<string, unknown>): McqOption[] {
	const schema = answerSchemaFor(cardType);
	const options = Array.isArray(schema.options)
		? schema.options
				.filter((option) => option && typeof option === "object")
				.map((option) => {
					const row = option as Record<string, unknown>;
					const value = String(row.value ?? "").trim();
					const label = String(row.label ?? value).trim();

					return { value, label };
				})
				.filter((option) => option.value && option.label)
		: [];

	const yes = options.find((option) => option.value === "yes") ?? { value: "yes", label: "Yes" };
	const no = options.find((option) => option.value === "no") ?? { value: "no", label: "No" };

	return [yes, no];
}
---

<section class="rental-panel wf1-panel" data-testid="wf1-card-composer">
	<div class="wf1-composer-head">
		<div>
			<p class="rental-kicker">{panelKicker()}</p>
			<h2>{panelTitle()}</h2>
			<p class="rental-muted">{panelDescription()}</p>
		</div>
		{availableCardTypes.length ? (
			<button class="rental-button" type="button" data-wf1-open-composer>
				{openButtonLabel()}
			</button>
		) : null}
	</div>

	{availableCardTypes.length ? (
		<div class="wf1-task-builder" data-wf1-task-builder hidden>
			<div class="wf1-request-picker">
				<div>
					<p class="rental-kicker">Compose card</p>
					<h3>{stepTitle()}</h3>
					<p class="rental-muted">{stepDescription()}</p>
				</div>

				<div class="rental-field full">
					<label for="wf1-task-type">{requestTypeLabel()}</label>
					<select id="wf1-task-type" data-wf1-task-type>
						<option value="" selected>Choose a type...</option>
						{availableCardTypes.map((cardType) => {
							const cardTypeId = String(cardType.id ?? "");

							return (
								<option value={cardTypeId}>
									{requestTitleFor(cardTypeId, cardType.label)}
								</option>
							);
						})}
					</select>
				</div>

				<div class="wf1-type-grid">
					{availableCardTypes.map((cardType) => {
						const cardTypeId = String(cardType.id ?? "");

						return (
							<button class="wf1-type-card" type="button" data-wf1-type-pill={cardTypeId}>
								<strong>{requestTitleFor(cardTypeId, cardType.label)}</strong>
								<span>{requestDescriptionFor(cardTypeId, uiFor(cardType).helpText)}</span>
							</button>
						);
					})}
				</div>
			</div>

			<div class="wf1-compose-forms">
				<div class="wf1-empty-composer" data-wf1-empty-composer>
					<p class="rental-muted">{emptyComposerText()}</p>
				</div>

				{availableCardTypes.map((cardType) => {
					const cardTypeId = String(cardType.id ?? "");
					const ui = uiFor(cardType);
					const customMcqTask = isCustomMcqTask(cardTypeId);
					const options = mcqOptionsFor(cardType);
					const evidenceText = isRequiredEvidenceTask(cardTypeId)
						? "This card blocks the next stage until the answering side replies and attaches image/PDF evidence."
						: "";

					return (
						<div class="wf1-compose-form" data-wf1-compose-form={cardTypeId} hidden>
							<ActionForm
								title={`Compose: ${requestTitleFor(cardTypeId, cardType.label)}`}
								action="/test-corridor/api/wf1-rental/workflow/cards"
								submitLabel={String(ui.submitLabel ?? "Send card")}
								successRedirect={workspaceHref}
							>
								<input type="hidden" name="workflowInstanceId" value={workflowInstanceId} />
								<input type="hidden" name="cardType" value={cardTypeId} />

								<div class="rental-field full">
									<label for={`prompt-${cardTypeId}`}>{String(ui.promptLabel ?? "Message")}</label>
									<textarea
										id={`prompt-${cardTypeId}`}
										name="prompt"
										required
										placeholder={promptPlaceholderFor(cardTypeId, ui.defaultPrompt)}
									></textarea>
								</div>

								{customMcqTask ? (
									<fieldset class="rental-field full wf1-option-editor">
										<legend>Answer options</legend>
										<p class="rental-muted">
											Edit the labels if needed. The answering side will choose from these options.
										</p>

										{options.map((option, index) => (
											<div class="wf1-option-row">
												<input type="hidden" name={`cardSpec.options.${index}.value`} value={option.value} />
												<label for={`option-${cardTypeId}-${index}`}>Option {index + 1}</label>
												<input
													id={`option-${cardTypeId}-${index}`}
													name={`cardSpec.options.${index}.label`}
													value={option.label}
													required
												/>
											</div>
										))}
									</fieldset>
								) : null}

								{evidenceText ? <p class="rental-muted wf1-evidence-note">{evidenceText}</p> : null}
								<p class="rental-muted">{shortHelpFor(cardTypeId, ui.helpText)}</p>
							</ActionForm>
						</div>
					);
				})}
			</div>
		</div>
	) : (
		<p class="rental-muted">{noTypesText()}</p>
	)}
</section>

<script>
	const builder = document.querySelector<HTMLElement>("[data-wf1-task-builder]");
	const openButton = document.querySelector<HTMLButtonElement>("[data-wf1-open-composer]");
	const taskType = document.querySelector<HTMLSelectElement>("[data-wf1-task-type]");
	const forms = [...document.querySelectorAll<HTMLElement>("[data-wf1-compose-form]")];
	const emptyComposer = document.querySelector<HTMLElement>("[data-wf1-empty-composer]");
	const typeButtons = [...document.querySelectorAll<HTMLButtonElement>("[data-wf1-type-pill]")];

	function markSelectedType(selected: string) {
		for (const button of typeButtons) {
			button.dataset.selected = button.dataset.wf1TypePill === selected ? "true" : "false";
		}
	}

	function showSelectedComposer() {
		const selected = taskType?.value ?? "";

		for (const form of forms) {
			form.hidden = !selected || form.dataset.wf1ComposeForm !== selected;
		}

		if (emptyComposer) {
			emptyComposer.hidden = selected !== "";
		}

		markSelectedType(selected);
	}

	openButton?.addEventListener("click", () => {
		if (!builder) return;

		builder.hidden = false;
		openButton.hidden = true;
		showSelectedComposer();
		taskType?.focus();
	});

	for (const button of typeButtons) {
		button.addEventListener("click", () => {
			const selected = button.dataset.wf1TypePill ?? "";
			if (!taskType || selected === "") return;

			taskType.value = selected;
			showSelectedComposer();

			const selectedForm = forms.find((form) => form.dataset.wf1ComposeForm === selected);
			selectedForm?.scrollIntoView({ behavior: "smooth", block: "nearest" });
		});
	}

	taskType?.addEventListener("change", showSelectedComposer);
	showSelectedComposer();
</script>

<style>
	.wf1-panel {
		display: grid;
		gap: 14px;
	}

	.wf1-composer-head {
		display: flex;
		flex-wrap: wrap;
		align-items: start;
		justify-content: space-between;
		gap: 12px;
	}

	.wf1-composer-head h2,
	.wf1-request-picker h3 {
		margin: 0;
	}

	.wf1-task-builder,
	.wf1-request-picker,
	.wf1-compose-forms,
	.wf1-compose-form {
		display: grid;
		gap: 14px;
	}

	.wf1-request-picker {
		padding: 14px;
		border: 1px solid var(--r-border);
		border-radius: var(--r-radius);
		background: var(--r-panel-soft);
	}

	.wf1-type-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 10px;
	}

	.wf1-type-card {
		display: grid;
		gap: 6px;
		width: 100%;
		padding: 12px;
		border: 1px solid var(--r-border);
		border-radius: 14px;
		background: var(--r-panel);
		color: var(--r-text);
		text-align: left;
		cursor: pointer;
	}

	.wf1-type-card:hover,
	.wf1-type-card[data-selected="true"] {
		border-color: var(--r-accent, var(--r-border));
		box-shadow: 0 0 0 2px rgba(234, 88, 12, 0.12);
	}

	.wf1-type-card strong {
		font-size: 0.92rem;
		line-height: 1.25;
	}

	.wf1-type-card span {
		color: var(--r-muted);
		font-size: 0.82rem;
		line-height: 1.35;
	}

	.wf1-empty-composer {
		padding: 14px;
		border: 1px dashed var(--r-border);
		border-radius: var(--r-radius);
		background: var(--r-panel-soft);
	}

	.wf1-option-editor {
		display: grid;
		gap: 10px;
		border: 1px solid var(--r-border);
		border-radius: var(--r-radius);
		padding: 12px;
	}

	.wf1-option-editor legend {
		color: var(--r-text);
		font-size: 0.94rem;
		font-weight: 850;
		padding: 0 6px;
	}

	.wf1-option-row {
		display: grid;
		gap: 6px;
	}

	.wf1-option-row label {
		color: var(--r-muted);
		font-size: 0.84rem;
		font-weight: 800;
	}

	.wf1-evidence-note {
		padding: 10px;
		border: 1px solid var(--r-border);
		border-radius: var(--r-radius);
		background: var(--r-panel-soft);
	}

	@media (max-width: 760px) {
		.wf1-composer-head {
			display: grid;
		}

		.wf1-composer-head .rental-button {
			width: 100%;
		}

		.wf1-type-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
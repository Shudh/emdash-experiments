---
import "../../styles/rental-responsive-hardening.css";

interface Props {
	title: string;
	description?: string;
}

const { title, description = "Rental record route" } = Astro.props;
const user = Astro.locals.user as { email?: string | null; role?: string | null } | undefined;
const isWf1SuperadminViewer = String(user?.role ?? "") === "50" || user?.email === "shudh.datta@gmail.com";

const fullTitle = title === "WF1" ? "HandoverNow" : `${title} - HandoverNow`;
const currentPath = Astro.url.pathname + Astro.url.search;
const safeCurrentPath =
	currentPath.startsWith("/") && !currentPath.startsWith("//") && !currentPath.includes("\\")
		? currentPath
		: "/test-corridor/wf1";
const loginHref = `/login?redirect=${encodeURIComponent(safeCurrentPath)}`;
const registerHref = `${loginHref}#signup-request`;
const logoutRedirect = `/login?redirect=${encodeURIComponent(safeCurrentPath)}`;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<title>{fullTitle}</title>
		<style is:global>
			:root {
				color-scheme: light;
				--r-bg: #fffaf3;
				--r-panel: #ffffff;
				--r-panel-soft: #fff1df;
				--r-text: #1b1b18;
				--r-muted: #6f5f4f;
				--r-border: #e8d8c6;
				--r-brand: #ea580c;
				--r-brand-strong: #9a3412;
				--r-accent: #c2410c;
				--r-success: #1f7a4d;
				--r-danger: #9f2f24;
				--r-radius: 8px;
				--r-shadow: 0 18px 50px rgba(89, 52, 20, 0.08);

				--wide-width: 1180px;
				--content-width: 780px;
				--spacing-1: 0.25rem;
				--spacing-2: 0.5rem;
				--spacing-3: 0.75rem;
				--spacing-4: 1rem;
				--spacing-5: 1.25rem;
				--spacing-6: 1.5rem;
				--spacing-8: 2rem;
				--spacing-10: 2.5rem;
				--spacing-12: 3rem;
				--spacing-16: 4rem;
				--spacing-20: 5rem;
				--font-size-xs: 0.75rem;
				--font-size-sm: 0.875rem;
				--font-size-base: 1rem;
				--font-size-lg: 1.125rem;
				--font-size-xl: 1.25rem;
				--font-size-2xl: 1.5rem;
				--font-size-3xl: 1.875rem;
				--font-size-4xl: 2.25rem;
				--leading-tight: 1.12;
				--leading-snug: 1.25;
				--leading-relaxed: 1.65;
				--tracking-tight: -0.04em;
				--tracking-snug: -0.02em;
				--tracking-wider: 0.08em;
				--radius: var(--r-radius);
				--radius-lg: 18px;
				--tag-padding-y: 0.3rem;
				--avatar-size-xs: 1.25rem;
				--avatar-size-md: 1.75rem;
				--transition-fast: 160ms ease;
				--color-text: var(--r-text);
				--color-text-secondary: var(--r-muted);
				--color-muted: var(--r-muted);
				--color-surface: var(--r-panel-soft);
				--color-border: var(--r-border);
				--color-border-subtle: rgba(232, 216, 198, 0.72);
				--color-accent: var(--r-brand);
				--color-accent-hover: var(--r-brand-strong);
				--color-on-accent: #ffffff;

				font-family:
					Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
					sans-serif;
			}

			* {
				box-sizing: border-box;
				min-width: 0;
			}

			html {
				overflow-x: hidden;
				scroll-behavior: smooth;
			}

			body {
				margin: 0;
				padding-top: 74px;
				min-height: 100vh;
				background:
					linear-gradient(180deg, rgba(234, 88, 12, 0.11), transparent 34rem),
					var(--r-bg);
				color: var(--r-text);
				-webkit-font-smoothing: antialiased;
				overflow-x: hidden;
			}

			a {
				color: inherit;
				text-decoration: none;
			}

			button,
			input,
			select,
			textarea {
				font: inherit;
			}

			section[id] {
				scroll-margin-top: 104px;
			}

			.rental-shell {
				max-width: 1180px;
				margin: 0 auto;
				padding: 0 20px;
			}

			.rental-section {
				padding: 56px 0;
			}

			.rental-section-header {
				display: flex;
				align-items: end;
				justify-content: space-between;
				gap: 24px;
				margin-bottom: 24px;
			}

			.rental-kicker {
				margin: 0 0 8px;
				color: var(--r-accent);
				font-size: 0.78rem;
				font-weight: 800;
				letter-spacing: 0.08em;
				text-transform: uppercase;
			}

			h1,
			h2,
			h3 {
				margin: 0;
				line-height: 1.08;
				letter-spacing: 0;
			}

			p {
				line-height: 1.65;
				overflow-wrap: anywhere;
			}

			.rental-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
				gap: 18px;
			}

			.rental-card,
			.rental-panel {
				border: 1px solid var(--r-border);
				border-radius: var(--r-radius);
				background: color-mix(in srgb, var(--r-panel) 94%, transparent);
				box-shadow: var(--r-shadow);
				overflow-wrap: anywhere;
			}

			.rental-panel {
				padding: 22px;
			}

			.rental-muted {
				color: var(--r-muted);
			}

			.rental-badges {
				display: flex;
				flex-wrap: wrap;
				gap: 8px;
			}

			.rental-badge {
				display: inline-flex;
				align-items: center;
				max-width: 100%;
				border: 1px solid var(--r-border);
				border-radius: 999px;
				padding: 5px 10px;
				background: var(--r-panel-soft);
				color: var(--r-muted);
				font-size: 0.82rem;
				font-weight: 650;
				overflow-wrap: anywhere;
				white-space: normal;
			}

			.rental-button {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				max-width: 100%;
				border: 1px solid transparent;
				border-radius: var(--r-radius);
				padding: 10px 14px;
				background: var(--r-brand);
				color: white;
				font-weight: 800;
				cursor: pointer;
				text-align: center;
				white-space: normal;
			}

			.rental-button:hover {
				background: var(--r-brand-strong);
			}

			.rental-button.secondary {
				border-color: var(--r-border);
				background: var(--r-panel);
				color: var(--r-text);
			}

			.rental-button.danger {
				background: var(--r-danger);
			}

			.rental-form-grid {
				display: grid;
				grid-template-columns: repeat(2, minmax(0, 1fr));
				gap: 14px;
			}

			.rental-field {
				display: grid;
				gap: 6px;
			}

			.rental-field.full {
				grid-column: 1 / -1;
			}

			.rental-field label {
				color: var(--r-muted);
				font-size: 0.84rem;
				font-weight: 750;
			}

			.rental-field input,
			.rental-field select,
			.rental-field textarea {
				width: 100%;
				border: 1px solid var(--r-border);
				border-radius: var(--r-radius);
				padding: 10px 12px;
				background: var(--r-panel);
				color: var(--r-text);
				min-width: 0;
			}

			.rental-field textarea {
				min-height: 96px;
				resize: vertical;
			}

			.rental-status {
				margin-top: 12px;
				color: var(--r-muted);
				font-size: 0.92rem;
			}

			.rental-status[data-state="error"] {
				color: var(--r-danger);
			}

			@media (max-width: 820px) {
				body {
					padding-top: 132px;
				}

				section[id] {
					scroll-margin-top: 156px;
				}
			}

			@media (max-width: 760px) {
				.rental-shell {
					padding-inline: 14px;
				}

				.rental-section {
					padding: 36px 0;
				}

				.rental-section-header {
					display: grid;
				}

				.rental-form-grid {
					grid-template-columns: 1fr;
				}
			}

			@media (max-width: 380px) {
				.rental-shell {
					padding-inline: 10px;
				}

				.rental-panel {
					padding: 16px;
				}
			}
		</style>
	</head>
	<body>
		<header class="wf1-topbar">
			<div class="rental-shell wf1-topbar-inner">
				<a class="wf1-brand" href="/test-corridor/wf1">
					<span class="wf1-brand-mark">HN</span>
					<span>
						<strong>HandoverNow</strong>
						<small>Rental records for flats and villas</small>
					</span>
				</a>

				<nav class="wf1-nav" aria-label="HandoverNow navigation">
					<a href="/test-corridor/wf1">Landing</a>
					<a href="/test-corridor/wf1">Home</a>
					<a href="/test-corridor/wf1">Guides</a>
					<a href="/test-corridor/wf1/marketplace">Available flats</a>
					<a href="/test-corridor/wf1/owner">Owner</a>
					<a href="/test-corridor/wf1/owner/assets/new">List asset</a>
					{isWf1SuperadminViewer ? (
						<a class="rental-button secondary" href="/test-corridor/wf1/admin">Admin</a>
					) : null}
					{
						user?.email ? (
							<>
								<span class="wf1-account">Welcome {user.email}</span>
								<button type="button" data-wf1-logout>
									Logout
								</button>
							</>
						) : (
							<>
								<a href={loginHref}>Login</a>
								<a href={registerHref}>Register</a>
							</>
						)
					}
				</nav>
			</div>
		</header>

		<main>
			<slot />
		</main>

		<footer class="wf1-footer">
			<div class="rental-shell">
				<span>HandoverNow keeps rental records clear from agreement to move-out.</span>
			</div>
		</footer>

		<script is:inline define:vars={{ logoutRedirect }}>
			document.querySelectorAll("[data-wf1-logout]").forEach((button) => {
				button.addEventListener("click", async () => {
					button.setAttribute("disabled", "disabled");
					button.textContent = "Logging out...";

					try {
						await fetch("/_emdash/api/auth/logout", {
							method: "POST",
							credentials: "same-origin",
							headers: { "X-EmDash-Request": "1" },
						});
					} finally {
						window.location.assign(logoutRedirect);
					}
				});
			});
		</script>

		<style>
			.wf1-topbar {
				position: fixed;
				top: 0;
				left: 0;
				right: 0;
				z-index: 1000;
				border-bottom: 1px solid rgba(194, 65, 12, 0.26);
				background:
					linear-gradient(90deg, rgba(255, 247, 237, 0.96), rgba(255, 237, 213, 0.96));
				backdrop-filter: blur(16px);
				-webkit-backdrop-filter: blur(16px);
			}

			.wf1-topbar-inner {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 22px;
				min-height: 72px;
				padding-block: 10px;
			}

			.wf1-brand {
				display: inline-flex;
				align-items: center;
				gap: 10px;
				color: var(--r-brand-strong);
			}

			.wf1-brand-mark {
				display: inline-grid;
				place-items: center;
				width: 44px;
				height: 44px;
				border-radius: 14px;
				background: var(--r-brand);
				color: white;
				font-weight: 950;
				letter-spacing: -0.04em;
			}

			.wf1-brand strong,
			.wf1-brand small {
				display: block;
			}

			.wf1-brand strong {
				font-size: 1rem;
				font-weight: 950;
			}

			.wf1-brand small {
				color: var(--r-muted);
				font-size: 0.78rem;
				font-weight: 750;
			}

			.wf1-nav {
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				justify-content: flex-end;
				gap: 10px;
			}

			.wf1-nav a,
			.wf1-nav button {
				border: 1px solid rgba(194, 65, 12, 0.22);
				border-radius: 999px;
				padding: 8px 12px;
				background: var(--r-panel);
				color: var(--r-text);
				font: inherit;
				font-size: 0.88rem;
				font-weight: 850;
				line-height: 1;
				text-decoration: none;
				cursor: pointer;
			}

			.wf1-nav a:hover,
			.wf1-nav button:hover {
				border-color: var(--r-brand);
				color: var(--r-brand-strong);
			}

			.wf1-account {
				display: inline-flex;
				align-items: center;
				max-width: 18rem;
				border: 1px solid rgba(194, 65, 12, 0.18);
				border-radius: 999px;
				padding: 8px 12px;
				background: rgba(255, 250, 243, 0.72);
				color: var(--r-muted);
				font-size: 0.82rem;
				font-weight: 800;
				line-height: 1;
				overflow: hidden;
				text-overflow: ellipsis;
				white-space: nowrap;
			}

			.wf1-footer {
				border-top: 1px solid var(--r-border);
				padding: 28px 0;
				color: var(--r-muted);
			}

			@media (max-width: 820px) {
				.wf1-topbar-inner {
					align-items: flex-start;
					flex-direction: column;
				}

				.wf1-nav {
					justify-content: flex-start;
				}
			}
		</style>
	</body>
</html>
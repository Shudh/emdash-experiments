---
import ConditionBox from "../../../../../components/rental/ConditionBox.astro";
import SpecTable from "../../../../../components/rental/SpecTable.astro";
import Wf1PrescreenChatbotifyIsland from "../../../../../components/wf1/Wf1PrescreenChatbotifyIsland.astro";
import Wf1TestBase from "../../../../../components/wf1-test/Wf1TestBase.astro";

import { getWorkflowMarketplaceAsset } from "../../../../../lib/wf1/queries/marketplace.js";
import { getWf1PageContext } from "../../../../../lib/wf1/server/context.js";
import { createHumanCheckChallenge } from "../../../../../lib/wf1/security/human-check.js";
import { getRuntimeEnvFromLocals } from "../../../../../lib/wf1/security/runtime-env.js";
import { publicTurnstileSiteKeyFromEnv } from "../../../../../lib/wf1/security/turnstile.js";
import {
	wf1AssetHref,
	wf1LoginHref,
	wf1MarketplaceHref,
	wf1RentalApiPath,
	wf1WorkspaceHref,
} from "../../../../../lib/wf1/routing/lane.js";

import Wf1TestLaneBanner from "../../../../../components/wf1-test/Wf1TestLaneBanner.astro";

import {
	applyTestLaneNoStoreHeaders,
	testLaneHostRejectionResponse,
} from "../../../../../lib/wf1/routing/host-policy.js";

export const prerender = false;

const rejection = testLaneHostRejectionResponse(Astro.request);

if (rejection) {
	return rejection;
}

applyTestLaneNoStoreHeaders(Astro.response.headers);

const WF1_TEST_LANE = "test" as const;

type JsonObject = Record<string, unknown>;

type OwnerConditions = {
	version?: unknown;
	hash?: unknown;
	spec?: JsonObject | null;
};

type AssetDetails = {
	asset?: JsonObject;
	ownerConditions?: OwnerConditions | null;
};

const assetId = Astro.params.id;

function isObjectRecord(value: unknown): value is JsonObject {
	return value !== null && typeof value === "object" && !Array.isArray(value);
}

function normalizeOwnerConditions(value: unknown): OwnerConditions | null | undefined {
	if (value === null || value === undefined) {
		return value;
	}

	if (!isObjectRecord(value)) {
		return undefined;
	}

	const spec = value.spec;

	return {
		version: value.version,
		hash: value.hash,
		spec: isObjectRecord(spec) ? spec : spec === null || spec === undefined ? spec : null,
	};
}

function normalizeAssetDetails(value: unknown): AssetDetails | null {
	if (!isObjectRecord(value)) {
		return null;
	}

	const rawAsset = value.asset;
	const rawOwnerConditions = value.ownerConditions;

	return {
		asset: isObjectRecord(rawAsset) ? rawAsset : undefined,
		ownerConditions: normalizeOwnerConditions(rawOwnerConditions),
	};
}

async function loadDetails(): Promise<AssetDetails | null> {
	if (!assetId) return null;

	try {
		const { store, user } = await getWf1PageContext(Astro);
		const result = await getWorkflowMarketplaceAsset(store, user, assetId, { lane: "test" });
		return normalizeAssetDetails(result);
	} catch (error) {
		console.error("[wf1] Failed to load marketplace asset details", error);
		return null;
	}
}

function specFor(value: unknown): Record<string, unknown> {
	return isObjectRecord(value) ? value : {};
}

function configFor(asset: JsonObject | undefined): Record<string, unknown> {
	return specFor(asset?.config_spec);
}

function conditionFor(asset: JsonObject | undefined): Record<string, unknown> {
	return specFor(asset?.condition_spec);
}

function mediaUrlFromStorageKey(storageKey: string): string {
	return `/_emdash/api/media/file/${storageKey
		.split("/")
		.map((part) => encodeURIComponent(part))
		.join("/")}`;
}

function moneyLabel(asset: JsonObject | undefined): string {
	const amount = Number(asset?.public_price ?? 0);
	const currency = String(asset?.currency ?? "INR");

	if (!Number.isFinite(amount) || amount <= 0) {
		return "";
	}

	return new Intl.NumberFormat("en-IN", {
		style: "currency",
		currency,
		maximumFractionDigits: 0,
	}).format(amount);
}

function minimumMonthsLabel(asset: JsonObject | undefined): string {
	const months = Number(asset?.minimum_months ?? 0);

	if (!Number.isFinite(months) || months <= 0) {
		return "";
	}

	return `Minimum stay: ${months} month${months === 1 ? "" : "s"}`;
}

function thumbnailFor(asset: JsonObject | undefined) {
	const config = configFor(asset);
	const thumbnail =
		config.thumbnailMediaRef && typeof config.thumbnailMediaRef === "object"
			? (config.thumbnailMediaRef as JsonObject)
			: null;
	const mediaRefs = Array.isArray(config.mediaRefs)
		? (config.mediaRefs.filter((item) => isObjectRecord(item)) as Array<JsonObject>)
		: [];
	const media = thumbnail ?? mediaRefs[0] ?? null;

	if (!media) return null;

	const url =
		typeof media.url === "string" && media.url
			? media.url
			: typeof media.storageKey === "string" && media.storageKey
				? mediaUrlFromStorageKey(media.storageKey)
				: "";

	if (!url) return null;

	return {
		url,
		mimeType: String(media.mimeType ?? ""),
		filename: String(media.filename ?? "Asset media"),
	};
}

const details = await loadDetails();
const asset = details?.asset;
const ownerConditions = details?.ownerConditions;
const viewer = isObjectRecord(asset?.viewer) ? asset.viewer : {};
const relationship = String(viewer.relationship ?? "anonymous");
const workflowInstanceId =
	typeof viewer.workflowInstanceId === "string" ? viewer.workflowInstanceId : "";
const canExpressInterest = viewer.canExpressInterest === true;
function assetIdForRoute(asset: JsonObject | undefined): string {
	const value = asset?.id;

	if (typeof value === "string") {
		return value.trim();
	}

	if (typeof value === "number" && Number.isFinite(value)) {
		return String(value);
	}

	return "";
}

const assetIdForLinks = assetIdForRoute(asset);
const loginRedirect =
	assetIdForLinks !== ""
		? wf1AssetHref(WF1_TEST_LANE, assetIdForLinks)
		: wf1MarketplaceHref(WF1_TEST_LANE);
const loginHref = wf1LoginHref(loginRedirect);
const expressInterestAction =
	assetIdForLinks !== ""
		? wf1RentalApiPath(WF1_TEST_LANE, `/marketplace/assets/${assetIdForLinks}/express-interest`)
		: "";
const thumbnail = thumbnailFor(asset);
const isImage = thumbnail?.mimeType.startsWith("image/") ?? false;
const price = moneyLabel(asset);
const minimumMonths = minimumMonthsLabel(asset);
const runtimeEnv = getRuntimeEnvFromLocals(Astro.locals);
const humanCheckChallenge = asset?.id ? await createHumanCheckChallenge(String(asset.id), runtimeEnv) : null;
const turnstileSiteKey = publicTurnstileSiteKeyFromEnv(runtimeEnv);
---

<Wf1TestBase title={asset ? String(asset.title) : "WF1 asset"} description="WF1 asset details">
	<Wf1TestLaneBanner />

	<section class="rental-section">
		<div class="rental-shell detail-grid">
			{
				asset ? (
					<>
						<article class="rental-panel detail-main">
							<div class="detail-hero-media">
								{thumbnail && isImage ? (
									<img src={thumbnail.url} alt={thumbnail.filename} loading="lazy" />
								) : thumbnail ? (
									<a class="rental-button secondary" href={thumbnail.url} target="_blank" rel="noreferrer">
										Open asset media: {thumbnail.filename}
									</a>
								) : (
									<span>No primary image yet</span>
								)}
							</div>

							<p class="rental-kicker">{String(asset.asset_kind ?? "asset")}</p>
							<h1>{String(asset.title ?? "Untitled asset")}</h1>
							<p class="rental-muted">{String(asset.location_label ?? "Location pending")}</p>
							{price ? <p class="asset-price">{price} / month</p> : null}
							{minimumMonths ? <p class="rental-muted asset-minimum">{minimumMonths}</p> : null}
							<div class="rental-badges">
								<span class="rental-badge">Asset State: {String(asset.business_state ?? "listed")}</span>
								<span class="rental-badge">{String(asset.visibility_state ?? "marketplace")}</span>
							</div>
						</article>

						<div class="detail-side">
							<ConditionBox conditions={ownerConditions} />

							{relationship === "owner" ? (
								<div class="rental-panel">
									<h2>This is your asset</h2>
									<a class="rental-button" href="/test-corridor/wf1/owner">
										Owner dashboard
									</a>
								</div>
							) : relationship === "interested_applicant" && workflowInstanceId ? (
								<div class="rental-panel">
									<h2>Application submitted</h2>
									<a class="rental-button" href={wf1WorkspaceHref(WF1_TEST_LANE, workflowInstanceId)}>
										Open workspace
									</a>
								</div>
							) : humanCheckChallenge ? (
								<div class="rental-panel">
									<Wf1PrescreenChatbotifyIsland
										asset={asset}
										ownerConditions={ownerConditions}
										action={expressInterestAction}
										loginHref={loginHref}
										canSubmit={canExpressInterest}
										humanCheckChallenge={humanCheckChallenge}
										turnstileSiteKey={turnstileSiteKey}
									/>
								</div>
							) : (
								<div class="rental-panel">
									<h2>Screening unavailable</h2>
									<p class="rental-muted">This asset is not accepting applications right now.</p>
								</div>
							)}
						</div>

						<div class="rental-panel">
							<SpecTable title="Configuration" spec={configFor(asset)} />
						</div>

						<div class="rental-panel">
							<SpecTable title="Physical condition" spec={conditionFor(asset)} />
						</div>
					</>
				) : (
					<div class="rental-panel">
						<h1>Asset not found</h1>
						<p class="rental-muted">This WF1 asset is unavailable.</p>
					</div>
				)
			}
		</div>
	</section>
</Wf1TestBase>

<style>
	.detail-grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 380px;
		gap: 18px;
		align-items: start;
	}

	.detail-main {
		display: grid;
		gap: 14px;
		align-content: start;
	}

	.detail-hero-media {
		display: grid;
		place-items: center;
		width: 100%;
		min-height: 280px;
		border: 1px solid var(--r-border);
		border-radius: var(--r-radius);
		background: var(--r-panel-soft);
		color: var(--r-muted);
		font-weight: 850;
		overflow: hidden;
	}

	.detail-hero-media img {
		width: 100%;
		height: 100%;
		min-height: 280px;
		object-fit: cover;
		display: block;
	}

	.detail-side {
		display: grid;
		gap: 18px;
	}

	@media (max-width: 900px) {
		.detail-grid {
			grid-template-columns: 1fr;
		}
	}

	.asset-price {
		margin: 0;
		font-size: 1.2rem;
		font-weight: 900;
		color: var(--r-text);
	}

	.asset-minimum {
		font-size: 0.9rem;
	}
</style>
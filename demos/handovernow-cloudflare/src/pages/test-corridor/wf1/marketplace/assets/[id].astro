---
import ConditionBox from "../../../../../components/rental/ConditionBox.astro";
import SpecTable from "../../../../../components/rental/SpecTable.astro";
import Wf1PrescreenChatbotifyIsland from "../../../../../components/wf1/Wf1PrescreenChatbotifyIsland.astro";
import Wf1TestBase from "../../../../../components/wf1-test/Wf1TestBase.astro";

import { getWorkflowMarketplaceAsset } from "../../../../../lib/wf1/queries/marketplace.js";
import { getWf1PageContext } from "../../../../../lib/wf1/server/context.js";
import { createHumanCheckChallenge } from "../../../../../lib/wf1/security/human-check.js";
import { getRuntimeEnvFromLocals } from "../../../../../lib/wf1/security/runtime-env.js";
import { publicTurnstileSiteKeyFromEnv } from "../../../../../lib/wf1/security/turnstile.js";
import {
	wf1AssetHref,
	wf1LoginHref,
	wf1MarketplaceHref,
	wf1RentalApiPath,
	wf1WorkspaceHref,
} from "../../../../../lib/wf1/routing/lane.js";

import Wf1TestLaneBanner from "../../../../../components/wf1-test/Wf1TestLaneBanner.astro";

import {
	applyTestLaneNoStoreHeaders,
	testLaneHostRejectionResponse,
} from "../../../../../lib/wf1/routing/host-policy.js";

export const prerender = false;

const rejection = testLaneHostRejectionResponse(Astro.request);

if (rejection) {
	return rejection;
}

applyTestLaneNoStoreHeaders(Astro.response.headers);

const WF1_TEST_LANE = "test" as const;

type JsonObject = Record<string, unknown>;

type OwnerConditions = {
	version?: unknown;
	hash?: unknown;
	spec?: JsonObject | null;
};

type AssetDetails = {
	asset?: JsonObject;
	ownerConditions?: OwnerConditions | null;
	application?: JsonObject | null;
};

const assetId = Astro.params.id;

function isObjectRecord(value: unknown): value is JsonObject {
	return value !== null && typeof value === "object" && !Array.isArray(value);
}

function stringValue(value: unknown, fallback = ""): string {
	return typeof value === "string" && value.trim() !== "" ? value.trim() : fallback;
}

function numberValue(value: unknown, fallback = 0): number {
	if (typeof value === "number" && Number.isFinite(value)) {
		return value;
	}

	if (typeof value === "string" && value.trim() !== "") {
		const parsed = Number(value);
		return Number.isFinite(parsed) ? parsed : fallback;
	}

	return fallback;
}

function normalizeOwnerConditions(value: unknown): OwnerConditions | null | undefined {
	if (value === null || value === undefined) {
		return value;
	}

	if (!isObjectRecord(value)) {
		return undefined;
	}

	const spec = value.spec;

	return {
		version: value.version,
		hash: value.hash,
		spec: isObjectRecord(spec) ? spec : spec === null || spec === undefined ? spec : null,
	};
}

function normalizeAssetDetails(value: unknown): AssetDetails | null {
	if (!isObjectRecord(value)) {
		return null;
	}

	const rawAsset = value.asset;
	const rawOwnerConditions = value.ownerConditions;
	const rawApplication = value.application;

	return {
		asset: isObjectRecord(rawAsset) ? rawAsset : undefined,
		ownerConditions: normalizeOwnerConditions(rawOwnerConditions),
		application: isObjectRecord(rawApplication) ? rawApplication : undefined,
	};
}

async function loadDetails(): Promise<AssetDetails | null> {
	if (!assetId) return null;

	try {
		const { store, user } = await getWf1PageContext(Astro);
		const result = await getWorkflowMarketplaceAsset(store, user, assetId, { lane: "test" });
		return normalizeAssetDetails(result);
	} catch (error) {
		console.error("[wf1] Failed to load marketplace asset details", error);
		return null;
	}
}

function specFor(value: unknown): Record<string, unknown> {
	return isObjectRecord(value) ? value : {};
}

function configFor(asset: JsonObject | undefined): Record<string, unknown> {
	return specFor(asset?.config_spec);
}

function conditionFor(asset: JsonObject | undefined): Record<string, unknown> {
	return specFor(asset?.condition_spec);
}


function mediaArrayFor(asset: JsonObject | undefined): Array<JsonObject> {
	const candidates: unknown[] = [];

	if (isObjectRecord(asset?.thumbnail)) {
		candidates.push(asset.thumbnail);
	}

	if (Array.isArray(asset?.photos)) {
		candidates.push(...asset.photos);
	}

	if (Array.isArray(asset?.media)) {
		candidates.push(...asset.media);
	}

	return candidates.filter((entry): entry is JsonObject => isObjectRecord(entry));
}

function thumbnailFor(asset: JsonObject | undefined) {
	const media = mediaArrayFor(asset)[0] ?? null;

	if (!media) return null;

	const url = typeof media.url === "string" && media.url.trim() !== "" ? media.url.trim() : "";

	if (!url) return null;

	return {
		url,
		mimeType: String(media.mimeType ?? ""),
		filename: String(media.filename ?? "Asset media"),
	};
}


function moneyLabel(asset: JsonObject | undefined): string {
const amount = Number(asset?.public_price ?? 0);
const currency = String(asset?.currency ?? "INR");

if (!Number.isFinite(amount) || amount <= 0) {
return "";
}

return new Intl.NumberFormat("en-IN", {
style: "currency",
currency,
maximumFractionDigits: 0,
}).format(amount);
}

function minimumMonthsLabel(asset: JsonObject | undefined): string {
const months = Number(asset?.minimum_months ?? 0);

if (!Number.isFinite(months) || months <= 0) {
return "";
}

return `Minimum stay: ${months} month${months === 1 ? "" : "s"}`;
}

function assetIdForRoute(asset: JsonObject | undefined): string {
	const value = asset?.id;

	if (typeof value === "string") {
		return value.trim();
	}

	if (typeof value === "number" && Number.isFinite(value)) {
		return String(value);
	}

	return "";
}

const details = await loadDetails();
const asset = details?.asset;
const ownerConditions = details?.ownerConditions;
const application = isObjectRecord(details?.application) ? details.application : {};
const viewer = isObjectRecord(asset?.viewer) ? asset.viewer : {};
const relationship = String(viewer.relationship ?? "anonymous");
const workflowInstanceId =
	typeof viewer.workflowInstanceId === "string" ? viewer.workflowInstanceId : "";
const canExpressInterest = viewer.canExpressInterest === true;

const assetIdForLinks = assetIdForRoute(asset);
const loginRedirect =
	assetIdForLinks !== ""
		? wf1AssetHref(WF1_TEST_LANE, assetIdForLinks)
		: wf1MarketplaceHref(WF1_TEST_LANE);
const loginHref = wf1LoginHref(loginRedirect);
const expressInterestAction =
	assetIdForLinks !== ""
		? wf1RentalApiPath(WF1_TEST_LANE, `/marketplace/assets/${assetIdForLinks}/express-interest`)
		: "";
const thumbnail = thumbnailFor(asset);
const isImage = thumbnail?.mimeType.startsWith("image/") ?? false;
const price = moneyLabel(asset);
const minimumMonths = minimumMonthsLabel(asset);
const runtimeEnv = getRuntimeEnvFromLocals(Astro.locals);
const humanCheckChallenge = asset?.id ? await createHumanCheckChallenge(String(asset.id), runtimeEnv) : null;
const turnstileSiteKey = publicTurnstileSiteKeyFromEnv(runtimeEnv);
const ownerConditionVersion = numberValue(application.acceptedConditionsVersion, 0);
const ownerConditionHash = stringValue(application.acceptedConditionsHash);
const prescreenQuestions = Array.isArray(application.prescreenQuestions) ? application.prescreenQuestions : [];
const chatbotifyOwnerConditions: OwnerConditions = {
	version: ownerConditionVersion,
	hash: ownerConditionHash,
	spec: {
		preScreenQuestions: prescreenQuestions,
	},
};
const prescreenStartedAt = new Date().toISOString();
---

<Wf1TestBase title={asset ? String(asset.title) : "WF1 asset"} description="WF1 asset details">
	<Wf1TestLaneBanner />

	<section class="rental-section">
		<div class="rental-shell detail-grid">
			{
				asset ? (
					<>
						<article class="rental-panel detail-main">
							<div class="detail-hero-media">
								{thumbnail && isImage ? (
									<img src={thumbnail.url} alt={thumbnail.filename} loading="lazy" />
								) : thumbnail ? (
									<a class="rental-button secondary" href={thumbnail.url} target="_blank" rel="noreferrer">
										Open asset media: {thumbnail.filename}
									</a>
								) : (
									<span>No primary image yet</span>
								)}
							</div>

							<p class="rental-kicker">{String(asset.asset_kind ?? "asset")}</p>
							<h1>{String(asset.title ?? "Untitled asset")}</h1>
							<p class="rental-muted">{String(asset.location_label ?? "Location pending")}</p>
							{price ? <p class="asset-price">{price} / month</p> : null}
							{minimumMonths ? <p class="rental-muted asset-minimum">{minimumMonths}</p> : null}
							<div class="rental-badges">
								<span class="rental-badge">Asset State: {String(asset.business_state ?? "listed")}</span>
								<span class="rental-badge">{String(asset.visibility_state ?? "marketplace")}</span>
							</div>
						</article>

						<div class="detail-side">
							<ConditionBox conditions={ownerConditions} />

							{relationship === "owner" ? (
								<div class="rental-panel">
									<h2>This is your asset</h2>
									<a class="rental-button" href="/test-corridor/wf1/owner">
										Owner dashboard
									</a>
								</div>
							) : relationship === "interested_applicant" && workflowInstanceId ? (
								<div class="rental-panel">
									<h2>Application submitted</h2>
									<a class="rental-button" href={wf1WorkspaceHref(WF1_TEST_LANE, workflowInstanceId)}>
										Open workspace
									</a>
								</div>
							) : humanCheckChallenge ? (
								<div class="rental-panel application-panel">
									{canExpressInterest || relationship === "anonymous" ? (
										<form
											class="express-interest-form"
											data-express-interest-form
											data-express-can-submit={canExpressInterest ? "true" : "false"}
											data-login-href={loginHref}
											action={expressInterestAction}
											method="post"
										>
											<div>
												<p class="rental-kicker">Application</p>
												<h2>Express interest</h2>
												<p class="rental-muted">
													Use the normal form, or chat with the HandoverNow agent if you prefer guided screening.
												</p>
											</div>

											<input type="hidden" name="acceptedConditionsVersion" value={ownerConditionVersion} data-number="true" />
											<input type="hidden" name="acceptedConditionsHash" value={ownerConditionHash} />
											<input type="hidden" name="prescreenStartedAt" value={prescreenStartedAt} />

											<input type="hidden" name="humanCheck.challenge.v" value={humanCheckChallenge.v} data-number="true" />
											<input type="hidden" name="humanCheck.challenge.assetId" value={humanCheckChallenge.assetId} />
											<input type="hidden" name="humanCheck.challenge.issuedAt" value={humanCheckChallenge.issuedAt} data-number="true" />
											<input type="hidden" name="humanCheck.challenge.expiresAt" value={humanCheckChallenge.expiresAt} data-number="true" />
											<input type="hidden" name="humanCheck.challenge.nonce" value={humanCheckChallenge.nonce} />
											<input type="hidden" name="humanCheck.challenge.a" value={humanCheckChallenge.a} data-number="true" />
											<input type="hidden" name="humanCheck.challenge.b" value={humanCheckChallenge.b} data-number="true" />
											<input type="hidden" name="humanCheck.challenge.op" value={humanCheckChallenge.op} />
											<input type="hidden" name="humanCheck.challenge.question" value={humanCheckChallenge.question} />
											<input type="hidden" name="humanCheck.challenge.checksum" value={humanCheckChallenge.checksum} />
											<input type="hidden" name="turnstileToken" data-express-turnstile-token />

											<div class="rental-form-grid">
												<div class="rental-field">
													<label for="name">Name</label>
													<input id="name" name="name" required autocomplete="name" />
												</div>

												<div class="rental-field">
													<label for="officialEmail">Official email</label>
													<input id="officialEmail" name="officialEmail" type="email" autocomplete="email" />
												</div>

												<div class="rental-field">
													<label for="phone">Phone / WhatsApp</label>
													<input id="phone" name="phone" type="tel" required autocomplete="tel" />
												</div>

												<div class="rental-field">
													<label for="employerName">Employer / income source</label>
													<input id="employerName" name="employerName" />
												</div>

												<div class="rental-field">
													<label for="offeredPrice">Offer</label>
													<input id="offeredPrice" name="offeredPrice" type="number" data-number="true" />
												</div>

												<div class="rental-field">
													<label for="requestedStartDate">Move-in date</label>
													<input id="requestedStartDate" name="requestedStartDate" type="date" />
												</div>

												<div class="rental-field">
													<label for="requestedMinimumMonths">Expected stay in months</label>
													<input id="requestedMinimumMonths" name="requestedMinimumMonths" type="number" data-number="true" />
												</div>

												<div class="rental-field">
													<label for="humanCheckAnswer">Quick check: what is {humanCheckChallenge.question}?</label>
													<input id="humanCheckAnswer" name="humanCheck.answer" type="number" inputmode="numeric" required />
												</div>

												<div class="rental-field full">
													<label for="message">Message</label>
													<textarea id="message" name="message">I am interested in this property.</textarea>
												</div>

												{turnstileSiteKey !== "" && canExpressInterest ? (
													<div class="rental-field full">
														<div
															class="express-interest-turnstile"
															data-express-turnstile
															data-site-key={turnstileSiteKey}
														></div>
														<p class="rental-muted" data-express-turnstile-status>
															Loading spam verification...
														</p>
													</div>
												) : null}
											</div>

											<div class="application-action-row">
												<button class="rental-button" type="submit" data-express-interest-submit data-express-locked-action hidden={turnstileSiteKey !== "" && canExpressInterest} disabled={turnstileSiteKey !== "" && canExpressInterest}>
													{canExpressInterest ? "Express interest" : "Continue securely"}
												</button>
												<button class="rental-button secondary" type="button" data-chatbotify-open data-express-locked-action hidden={turnstileSiteKey !== "" && canExpressInterest} disabled={turnstileSiteKey !== "" && canExpressInterest}>
													Chat with agent
												</button>
											</div>

											<p class="rental-status" data-express-interest-status></p>
										</form>
									) : (
										<div class="login-application-panel">
											<div>
												<p class="rental-kicker">Application</p>
												<h2>Continue when ready</h2>
												<p class="rental-muted">
													You can answer screening questions now. Your answers are saved in this browser; continue securely only when submitting.
												</p>
											</div>

											<div class="application-action-row">
												<a class="rental-button" href={loginHref}>Continue securely</a>
												<button class="rental-button secondary" type="button" data-chatbotify-open>
													Chat with agent
												</button>
											</div>
										</div>
									)}

									<dialog class="chatbotify-agent-dialog" data-chatbotify-dialog>
										<div class="chatbotify-agent-shell">
											<div class="chatbotify-agent-header">
												<div>
													<p class="rental-kicker">HandoverNow agent</p>
													<h2>Chat screening</h2>
													<p class="rental-muted">
														A guided chat surface for the same application workflow.
													</p>
												</div>
												<button class="rental-button secondary" type="button" data-chatbotify-close>
													Close
												</button>
											</div>

											<Wf1PrescreenChatbotifyIsland
												asset={asset}
												ownerConditions={chatbotifyOwnerConditions}
												action={expressInterestAction}
												loginHref={loginHref}
												canSubmit={canExpressInterest}
												humanCheckChallenge={humanCheckChallenge}
												turnstileSiteKey={turnstileSiteKey}
											/>
										</div>
									</dialog>
								</div>
							) : (
								<div class="rental-panel">
									<h2>Screening unavailable</h2>
									<p class="rental-muted">This asset is not accepting applications right now.</p>
								</div>
							)}
						</div>

						<div class="rental-panel">
							<SpecTable title="Configuration" spec={configFor(asset)} />
						</div>

						<div class="rental-panel">
							<SpecTable title="Physical condition" spec={conditionFor(asset)} />
						</div>
					</>
				) : (
					<div class="rental-panel">
						<h1>Asset not found</h1>
						<p class="rental-muted">This WF1 asset is unavailable.</p>
					</div>
				)
			}
		</div>
	</section>
</Wf1TestBase>

<script is:inline>
	(function () {
		const REDIRECT_TOKEN_PATTERN = /:([A-Za-z0-9_]+)/g;
		const INDEX_PATTERN = /^\d+$/;
		const TURNSTILE_SCRIPT_URL = "https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit";
		const MIN_PRESCREEN_SECONDS = 8;
		const EXPRESS_DRAFT_KEY = "hn:wf1:test:express-interest:normal:v1";

		function assignNestedValue(target, key, value) {
			const existing = target[key];

			if (existing === undefined) {
				target[key] = value;
				return;
			}

			if (Array.isArray(existing)) {
				if (Array.isArray(value)) {
					existing.push(...value);
				} else {
					existing.push(value);
				}
				return;
			}

			target[key] = Array.isArray(value) ? [existing, ...value] : [existing, value];
		}

		function setNested(target, path, value) {
			const parts = path.split(".");
			let cursor = target;

			for (let index = 0; index < parts.length; index += 1) {
				const part = parts[index];
				const last = index === parts.length - 1;
				const nextPart = parts[index + 1];
				const key = INDEX_PATTERN.test(part) ? Number(part) : part;
				const nextContainer = nextPart && INDEX_PATTERN.test(nextPart) ? [] : {};

				if (last) {
					assignNestedValue(cursor, key, value);
					return;
				}

				if (cursor[key] === undefined) {
					cursor[key] = nextContainer;
				}

				cursor = cursor[key];
			}
		}

		function valueFrom(rawValue, element) {
			const value = String(rawValue).trim();

			if (element instanceof HTMLInputElement && element.type === "checkbox") {
				if (!element.checked) return false;
				if (element.dataset.checkboxValue === "true") {
					return element.dataset.array === "true" ? [value] : value;
				}
				return true;
			}

			if (element instanceof HTMLElement && element.dataset.number === "true") {
				return value ? Number(value) : undefined;
			}

			if (element instanceof HTMLElement && element.dataset.lines === "true") {
				return value
					.split("\n")
					.map((line) => line.trim())
					.filter(Boolean);
			}

			if (element instanceof HTMLElement && element.dataset.array === "true") {
				return value ? [value] : undefined;
			}

			return value || undefined;
		}

		function findPayloadValue(source, key) {
			if (!source || typeof source !== "object") return undefined;

			if (Array.isArray(source)) {
				for (const item of source) {
					const value = findPayloadValue(item, key);
					if (value !== undefined) return value;
				}
				return undefined;
			}

			const record = source;
			const direct = record[key];

			if (typeof direct === "string" || typeof direct === "number") {
				return String(direct);
			}

			for (const value of Object.values(record)) {
				const nested = findPayloadValue(value, key);
				if (nested !== undefined) return nested;
			}

			return undefined;
		}

		function applyRedirectTemplate(template, payload) {
			return template.replace(REDIRECT_TOKEN_PATTERN, function (_match, key) {
				const value = findPayloadValue(payload, key);
				return value ? encodeURIComponent(value) : "";
			});
		}

		function statusMessageForError(error) {
			if (error instanceof Error && error.message.trim() !== "") {
				return error.message;
			}

			const message = String(error).trim();
			return message === "" ? "Request failed" : message;
		}

		function formElapsedSeconds(form) {
			const input = form.querySelector('[name="prescreenStartedAt"]');
			if (!(input instanceof HTMLInputElement)) return MIN_PRESCREEN_SECONDS;

			const timestamp = Date.parse(input.value);
			if (!Number.isFinite(timestamp)) return MIN_PRESCREEN_SECONDS;

			return Math.floor((Date.now() - timestamp) / 1000);
		}

		function validateClientTiming(form) {
			const elapsedSeconds = formElapsedSeconds(form);

			if (elapsedSeconds >= MIN_PRESCREEN_SECONDS) {
				return "";
			}

			const remainingSeconds = MIN_PRESCREEN_SECONDS - elapsedSeconds;
			return `Please review the application for ${remainingSeconds} more second(s), then submit.`;
		}

		function buildBodyFromForm(form) {
			const body = {};
			const data = new FormData(form);

			for (const [name, raw] of data.entries()) {
				const element = form.querySelector(`[name="${CSS.escape(name)}"]`);
				if (!element) continue;

				const value = valueFrom(raw, element);

				if (value === undefined || value === false) {
					continue;
				}

				setNested(body, name, value);
			}

			return body;
		}

		function localRedirectFromPayload(payload, fallbackTemplate) {
			const redirectTo = findPayloadValue(payload, "redirectTo");

			if (redirectTo && redirectTo.startsWith("/")) {
				return redirectTo;
			}

			if (fallbackTemplate) {
				return applyRedirectTemplate(fallbackTemplate, payload);
			}

			return "";
		}

		function saveNormalExpressDraft(form) {
			const fields = {};
			for (const control of form.querySelectorAll("input, textarea, select")) {
				const key = control.name || control.id;
				if (!key) continue;
				if (control.type === "password") continue;
				if (control.type === "checkbox" || control.type === "radio") {
					fields[key] = { checked: Boolean(control.checked), value: control.value };
				} else {
					fields[key] = { value: control.value };
				}
			}
			try { sessionStorage.setItem(EXPRESS_DRAFT_KEY, JSON.stringify({ savedAt: Date.now(), fields })); } catch {}
		}

		function restoreNormalExpressDraft(form) {
			let parsed = null;
			try { parsed = JSON.parse(sessionStorage.getItem(EXPRESS_DRAFT_KEY) || "null"); } catch {}
			if (!parsed || !parsed.fields) return;
			for (const control of form.querySelectorAll("input, textarea, select")) {
				const key = control.name || control.id;
				const saved = parsed.fields[key];
				if (!saved) continue;
				if (control.type === "checkbox" || control.type === "radio") {
					control.checked = Boolean(saved.checked);
				} else if (typeof saved.value === "string" && !control.value) {
					control.value = saved.value;
				}
			}
		}

		function initExpressInterestForm() {
			const form = document.querySelector("[data-express-interest-form]");

			if (!(form instanceof HTMLFormElement)) {
				return;
			}

			const status = form.querySelector("[data-express-interest-status]");
			const submit = form.querySelector("[data-express-interest-submit]");
			const canSubmit = form.dataset.expressCanSubmit === "true";
			restoreNormalExpressDraft(form);
			form.addEventListener("input", function () { saveNormalExpressDraft(form); }, { passive: true });
			form.addEventListener("change", function () { saveNormalExpressDraft(form); }, { passive: true });

			form.addEventListener("submit", async function (event) {
				event.preventDefault();

				if (status instanceof HTMLElement) {
					status.removeAttribute("data-state");
					status.textContent = "";
				}

				if (!canSubmit) {
					saveNormalExpressDraft(form);
					if (status instanceof HTMLElement) status.textContent = "Your answers are saved. Continuing securely...";
					location.href = form.dataset.loginHref || "/login";
					return;
				}

				const timingError = validateClientTiming(form);

				if (timingError !== "") {
					if (status instanceof HTMLElement) {
						status.dataset.state = "error";
						status.textContent = timingError;
					}
					return;
				}

				if (status instanceof HTMLElement) {
					status.textContent = "Submitting...";
				}

				if (submit instanceof HTMLButtonElement) {
					submit.disabled = true;
				}

				try {
					const body = buildBodyFromForm(form);
					const response = await fetch(form.action, {
						method: "POST",
						headers: {
							"Content-Type": "application/json",
							"X-EmDash-Request": "1",
						},
						body: JSON.stringify(body),
					});

					const payload = await response.json().catch(function () {
						return {};
					});

					if (!response.ok) {
						throw new Error(payload?.error?.message ?? "Request failed");
					}

					const redirectTo = localRedirectFromPayload(payload, form.dataset.success);

					if (redirectTo !== "") {
						location.href = redirectTo;
						return;
					}

					if (status instanceof HTMLElement) {
						status.textContent = "Application submitted.";
					}
				} catch (error) {
					if (status instanceof HTMLElement) {
						status.dataset.state = "error";
						status.textContent = statusMessageForError(error);
					}
				} finally {
					if (submit instanceof HTMLButtonElement) {
						submit.disabled = false;
					}
				}
			});
		}

		function existingTurnstileScriptElement() {
			return document.querySelector(`script[src="${TURNSTILE_SCRIPT_URL}"]`);
		}

		function loadTurnstileScript() {
			return new Promise(function (resolve, reject) {
				if (window.turnstile) {
					resolve();
					return;
				}

				const existingScript = existingTurnstileScriptElement();

				if (existingScript instanceof HTMLScriptElement) {
					existingScript.addEventListener("load", function () {
						resolve();
					}, { once: true });
					existingScript.addEventListener("error", function () {
						reject(new Error("Turnstile failed to load."));
					}, { once: true });
					return;
				}

				const script = document.createElement("script");
				script.src = TURNSTILE_SCRIPT_URL;
				script.async = true;
				script.addEventListener("load", function () {
					resolve();
				}, { once: true });
				script.addEventListener("error", function () {
					reject(new Error("Turnstile failed to load."));
				}, { once: true });
				document.head.appendChild(script);
			});
		}

		function initTurnstileForNormalForm() {
			const turnstileSlot = document.querySelector("[data-express-turnstile]");
			const tokenInput = document.querySelector("[data-express-turnstile-token]");
			const status = document.querySelector("[data-express-turnstile-status]");
			const submit = document.querySelector("[data-express-interest-submit]");
			const lockedActions = document.querySelectorAll("[data-express-locked-action]");

			function setSubmitReady(ready, message) {
				for (const action of lockedActions) {
					if (action instanceof HTMLButtonElement) {
						action.disabled = !ready;
						action.hidden = !ready;
					}
				}
				if (submit instanceof HTMLButtonElement) {
					submit.disabled = !ready;
					submit.hidden = !ready;
				}
				if (status instanceof HTMLElement && message) status.textContent = message;
			}

			if (!(turnstileSlot instanceof HTMLElement)) {
				return;
			}

			setSubmitReady(false, "Complete verification to continue.");

			if (!(tokenInput instanceof HTMLInputElement)) {
				return;
			}

			const siteKey = turnstileSlot.dataset.siteKey || "";

			if (siteKey === "") {
				return;
			}

			loadTurnstileScript()
				.then(function () {
					if (!window.turnstile) {
						throw new Error("Turnstile API is unavailable.");
					}

					window.turnstile.render(turnstileSlot, {
						sitekey: siteKey,
						appearance: "interaction-only",
						callback: function (token) {
							tokenInput.value = token;
							if (status instanceof HTMLElement) {
								setSubmitReady(true, "Spam verification complete.");
							}
						},
						"expired-callback": function () {
							tokenInput.value = "";
							if (status instanceof HTMLElement) {
								setSubmitReady(false, "Spam verification expired. Please verify again.");
							}
						},
						"error-callback": function () {
							tokenInput.value = "";
							if (status instanceof HTMLElement) {
								setSubmitReady(false, "Spam verification failed. Please retry.");
							}
						},
					});
				})
				.catch(function (error) {
					if (status instanceof HTMLElement) {
						status.textContent = statusMessageForError(error);
					}
				});
		}

		function initChatbotifyDialog() {
			const openButton = document.querySelector("[data-chatbotify-open]");
			const closeButton = document.querySelector("[data-chatbotify-close]");
			const dialog = document.querySelector("[data-chatbotify-dialog]");

			if (!(openButton instanceof HTMLButtonElement)) return;
			if (!(closeButton instanceof HTMLButtonElement)) return;
			if (!(dialog instanceof HTMLDialogElement)) return;

			openButton.addEventListener("click", function () {
				if (!dialog.open) {
					dialog.showModal();
				}
			});

			closeButton.addEventListener("click", function () {
				dialog.close();
			});

			dialog.addEventListener("click", function (event) {
				if (event.target === dialog) {
					dialog.close();
				}
			});
		}

		initExpressInterestForm();
		initTurnstileForNormalForm();
		initChatbotifyDialog();
	})();
</script>


---
import Wf1TestBase from "../../../../../components/wf1-test/Wf1TestBase.astro";
import Wf1MediaUpload from "../../../../../components/wf1-test/Wf1MediaUpload.astro";
import Wf1OwnerScreeningQuestionBuilderIsland from "../../../../../components/wf1/Wf1OwnerScreeningQuestionBuilderIsland.astro";

import Wf1TestLaneBanner from "../../../../../components/wf1-test/Wf1TestLaneBanner.astro";
import { getRuntimeEnvFromLocals } from "../../../../../lib/wf1/security/runtime-env.js";
import { publicTurnstileSiteKeyFromEnv } from "../../../../../lib/wf1/security/turnstile.js";

import {
	applyTestLaneNoStoreHeaders,
	testLaneHostRejectionResponse,
} from "../../../../../lib/wf1/routing/host-policy.js";

export const prerender = false;

const rejection = testLaneHostRejectionResponse(Astro.request);

if (rejection) {
	return rejection;
}

applyTestLaneNoStoreHeaders(Astro.response.headers);

const assetDraftId = crypto.randomUUID();
const wf1UploadUrl = "/test-corridor/api/wf1-rental/uploads";
const runtimeEnv = getRuntimeEnvFromLocals(Astro.locals);
const turnstileSiteKey = publicTurnstileSiteKeyFromEnv(runtimeEnv) ?? "";
const formStartedAt = new Date().toISOString();
---

<Wf1TestBase title="Add asset under management" description="Create a managed rental asset">
	<Wf1TestLaneBanner />

	<section class="rental-section">
		<div class="rental-shell create-grid">
			<div>
				<p class="rental-kicker">Owner asset</p>
				<h1>Create draft asset</h1>
				<p class="rental-muted">
					Create the property or rentable asset here. Add the listing image, owner conditions,
					furnishings, fixtures, and optional evidence. The application workflow starts only
					after an interested applicant applies. This configuration specification will be used to manage asset lifecycle changes.
				</p>
			</div>

			<form class="rental-panel create-form" id="asset-form" data-asset-draft-id={assetDraftId} data-wf1-upload-url={wf1UploadUrl} data-turnstile-site-key={turnstileSiteKey} data-form-started-at={formStartedAt} data-asset-create-locked="true">
				<input type="hidden" name="assetDraftToken" value="" data-asset-draft-token />
				<input type="hidden" name="draftId" value={assetDraftId} />
				<input type="hidden" name="formStartedAt" value={formStartedAt} />
				<input class="hn-hidden-trap-input" type="text" name="companyWebsite" autocomplete="off" tabindex="-1" aria-hidden="true" value="" hidden style="position:absolute;left:-10000px;top:auto;width:1px;height:1px;overflow:hidden;opacity:0;pointer-events:none;" />
				<div class="asset-draft-guard" data-hn-asset-draft-guard-v1>
					<p class="rental-muted" data-asset-draft-guard-status>Your typed listing is saved in this browser. Verification unlocks photo upload and review submission.</p>
					<div data-asset-draft-turnstile data-site-key={turnstileSiteKey}></div>
				</div>
				<div class="rental-form-grid">
					<div class="rental-field">
						<label for="assetKind">Asset kind</label>
						<select id="assetKind" name="assetKind">
							<option value="flat">Flat</option>
							<option value="villa">Villa</option>
							<option value="independent_house">Independent house</option>
							<option value="room">Room / PG unit</option>
							<option value="commercial_unit">Commercial unit</option>
							<option value="rentable_asset">Other rentable asset</option>
						</select>
					</div>

					<div class="rental-field">
						<label for="title">Title</label>
						<input id="title" name="title" required />
					</div>

					<div class="rental-field">
						<label for="locationLabel">Location</label>
						<input id="locationLabel" name="locationLabel" value="Bangalore" />
					</div>

					<div class="rental-field">
						<label for="publicPrice">Price</label>
						<input id="publicPrice" name="publicPrice" type="number" value="60000" required />
					</div>

					<div class="rental-field">
						<label for="minimumMonths">Minimum months</label>
						<input id="minimumMonths" name="minimumMonths" type="number" value="11" />
					</div>

					<div class="rental-field">
						<label for="bedrooms">Bedrooms</label>
						<input id="bedrooms" name="bedrooms" type="number" value="2" />
					</div>

					<div class="rental-field">
						<label for="furnishing">Furnishing</label>
						<input id="furnishing" name="furnishing" value="semi_furnished" />
					</div>

					<div class="rental-field">
						<label for="walls">Physical condition</label>
						<input id="walls" name="walls" value="freshly_painted" />
					</div>

					<div class="rental-field full">
						<label for="depositPolicy">Owner rental conditions</label>
						<textarea id="depositPolicy" name="depositPolicy">Two months deposit covers chargeable damage.</textarea>
					</div>

					<Wf1OwnerScreeningQuestionBuilderIsland fieldName="preScreenQuestionsJson" />

					<Wf1MediaUpload
						prefix="assetMedia"
						label="Primary property image"
						required={true}
						accept="image/*"
						uploadUrl={wf1UploadUrl}
						purpose="asset_draft_media"
						draftId={assetDraftId}
						clientItemId="primary"
					/>

					<div class="rental-field">
						<label>
							<input name="publish" type="checkbox" checked hidden />
							Marketplace review is required before listing
						</label>
					</div>
				</div>

				<section class="form-section" aria-labelledby="inventory-heading">
					<div class="section-head">
						<div>
							<p class="rental-kicker">Inventory</p>
							<h2 id="inventory-heading">Asset config items</h2>
							<p class="rental-muted">
								Each item can carry its own optional image/PDF evidence.
							</p>
						</div>
						<div class="section-actions">
							<button class="rental-button secondary" type="button" id="add-starter-inventory">
								Add starter flat inventory
							</button>
							<button class="rental-button secondary" type="button" id="add-inventory-row">
								Add row
							</button>
						</div>
					</div>

					<div class="inventory-editor" id="inventory-editor"></div>
				</section>

				<button class="rental-button" type="submit" hidden disabled data-asset-create-submit>Create asset</button>
				<p class="rental-status" id="asset-status"></p>
			</form>
		</div>
	</section>


<style is:global>

	.hn-hidden-trap-input {
		position: absolute !important;
		left: -10000px !important;
		top: auto !important;
		width: 1px !important;
		height: 1px !important;
		overflow: hidden !important;
		opacity: 0 !important;
		pointer-events: none !important;
	}

	[data-asset-create-locked="true"] input[type="file"],
	[data-asset-create-locked="true"] button[type="submit"] {
		display: none !important;
	}
	.hn-create-asset-auth-notice {
		border: 1px solid rgba(234, 88, 12, 0.35);
		border-radius: var(--r-radius);
		padding: 12px 14px;
		margin: 0 0 16px;
		background: rgba(255, 247, 237, 0.92);
		color: var(--r-brand-strong);
		font-weight: 750;
	}

	.hn-review-required-pill {
		display: inline-flex;
		align-items: center;
		border: 1px solid var(--r-border);
		border-radius: 999px;
		padding: 6px 10px;
		background: var(--r-panel-soft);
		color: var(--r-muted);
		font-weight: 800;
	}
</style>

</Wf1TestBase>

<script>
	const form = document.querySelector<HTMLFormElement>("#asset-form");
	const status = document.querySelector<HTMLElement>("#asset-status");
	const inventoryEditor = document.querySelector<HTMLElement>("#inventory-editor");
	const addInventoryRowButton = document.querySelector<HTMLButtonElement>("#add-inventory-row");
	const addStarterInventoryButton = document.querySelector<HTMLButtonElement>("#add-starter-inventory");
	const assetDraftId = form?.dataset.assetDraftId ?? crypto.randomUUID();
	const wf1UploadUrl = form?.dataset.wf1UploadUrl ?? "/test-corridor/api/wf1-rental/uploads";

	const TURNSTILE_SCRIPT_URL = "https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit";
	const CREATE_DRAFT_KEY = "hn:wf1:test:create-asset:login-redirect:v4";
	const CREATE_DRAFT_SCHEMA_VERSION = 4;

	type BrowserWindowWithTurnstile = Window & {
		turnstile?: {
			render: (element: HTMLElement, options: Record<string, unknown>) => string;
		};
	};

	function browserTurnstile() {
		return (window as BrowserWindowWithTurnstile).turnstile;
	}

	function createAssetControls() {
		return {
			fileInputs: [...document.querySelectorAll<HTMLInputElement>("#asset-form input[type='file']")],
			submitButton: document.querySelector<HTMLButtonElement>("#asset-form button[type='submit']"),
			status: document.querySelector<HTMLElement>("[data-asset-draft-guard-status]"),
			turnstileSlot: document.querySelector<HTMLElement>("[data-asset-draft-turnstile]"),
			tokenInput: document.querySelector<HTMLInputElement>("[data-asset-draft-token]"),
		};
	}

	function userIsLoggedIn() {
		const bodyText = document.body.textContent || "";
		return bodyText.includes("Logout") || /Welcome\s+[^\s@]+@[^\s@]+/.test(bodyText);
	}


	const CREATE_DRAFT_ALLOWED_FIELD_NAMES = new Set([
		"assetKind",
		"title",
		"locationLabel",
		"publicPrice",
		"minimumMonths",
		"bedrooms",
		"furnishing",
		"walls",
		"depositPolicy",
		"preScreenQuestionsJson",
		"publish",
	]);

	const CREATE_DRAFT_ALLOWED_FIELD_PREFIXES = ["inventory."];

	function createAssetDraftKeyForControl(control: HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement) {
		const key = control.name || control.id;
		if (!key) return "";
		if (CREATE_DRAFT_ALLOWED_FIELD_NAMES.has(key)) return key;
		if (CREATE_DRAFT_ALLOWED_FIELD_PREFIXES.some((prefix) => key.startsWith(prefix))) return key;
		return "";
	}

	function purgeOldCreateAssetDrafts() {
		for (const storage of [window.sessionStorage, window.localStorage]) {
			for (const key of Object.keys(storage)) {
				if (key === CREATE_DRAFT_KEY) continue;
				if (key.startsWith("hn:wf1:test:create-asset")) storage.removeItem(key);
			}
		}
	}

	function draftControlHasMeaningfulValue(control: HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement) {
		if (control instanceof HTMLInputElement && (control.type === "checkbox" || control.type === "radio")) {
			return control.checked;
		}
		return control.value.trim() !== "";
	}

	function saveCreateAssetDraft() {
		if (!form) return false;
		const fields: Record<string, unknown> = {};
		let hasMeaningfulField = false;

		for (const control of form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>("input, textarea, select")) {
			if (control instanceof HTMLInputElement && control.type === "file") continue;
			if (control instanceof HTMLInputElement && control.type === "password") continue;

			const key = createAssetDraftKeyForControl(control);
			if (!key) continue;

			if (draftControlHasMeaningfulValue(control)) hasMeaningfulField = true;

			if (control instanceof HTMLInputElement && (control.type === "checkbox" || control.type === "radio")) {
				fields[key] = { checked: control.checked, value: control.value };
			} else {
				fields[key] = { value: control.value };
			}
		}

		if (!hasMeaningfulField) return false;

		try {
			window.sessionStorage.setItem(CREATE_DRAFT_KEY, JSON.stringify({
				schemaVersion: CREATE_DRAFT_SCHEMA_VERSION,
				savedAt: Date.now(),
				fields,
			}));
			return true;
		} catch {
			return false;
		}
	}

	function restoreCreateAssetDraft() {
		purgeOldCreateAssetDrafts();
		if (!form) return false;

		let parsed: { schemaVersion?: number; fields?: Record<string, { value?: string; checked?: boolean }> } | null = null;
		try { parsed = JSON.parse(window.sessionStorage.getItem(CREATE_DRAFT_KEY) || "null"); } catch {}
		if (!parsed?.fields || parsed.schemaVersion !== CREATE_DRAFT_SCHEMA_VERSION) return false;

		let restored = false;
		for (const control of form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>("input, textarea, select")) {
			const key = createAssetDraftKeyForControl(control);
			if (!key) continue;

			const saved = parsed.fields[key];
			if (!saved) continue;

			if (control instanceof HTMLInputElement && (control.type === "checkbox" || control.type === "radio")) {
				control.checked = Boolean(saved.checked);
				restored = true;
			} else if (typeof saved.value === "string" && control.value === "") {
				control.value = saved.value;
				restored = true;
			}
		}

		window.sessionStorage.removeItem(CREATE_DRAFT_KEY);
		return restored;
	}

	function clearCreateAssetDraft() {
		window.sessionStorage.removeItem(CREATE_DRAFT_KEY);
	}

	function safeLoginUrl() {
		return `/login?redirect=${encodeURIComponent(location.pathname + location.search)}`;
	}

	function setAssetCreateLocked(locked: boolean, message: string) {
		if (form) {
			if (locked) {
				form.dataset.assetCreateLocked = "true";
			} else {
				delete form.dataset.assetCreateLocked;
			}
		}
		const controls = createAssetControls();
		for (const fileInput of controls.fileInputs) fileInput.disabled = locked;
		if (controls.submitButton) {
			controls.submitButton.disabled = locked;
			controls.submitButton.hidden = locked;
		}
		if (controls.status) controls.status.textContent = message;
	}

	function ensureLoggedInForCreate(event?: Event) {
		if (userIsLoggedIn()) return true;
		if (event) event.preventDefault();
		saveCreateAssetDraft();
		setAssetCreateLocked(true, "Your listing is saved in this browser. Continue securely to add photos and request review.");
		setTimeout(() => { location.href = safeLoginUrl(); }, 120);
		return false;
	}

	async function loadTurnstileScript() {
		if (browserTurnstile()) return;
		const existing = document.querySelector<HTMLScriptElement>(`script[src="${TURNSTILE_SCRIPT_URL}"]`);
		if (existing) {
			await new Promise<void>((resolve, reject) => {
				existing.addEventListener("load", () => resolve(), { once: true });
				existing.addEventListener("error", () => reject(new Error("Turnstile failed to load.")), { once: true });
			});
			return;
		}
		await new Promise<void>((resolve, reject) => {
			const script = document.createElement("script");
			script.src = TURNSTILE_SCRIPT_URL;
			script.async = true;
			script.addEventListener("load", () => resolve(), { once: true });
			script.addEventListener("error", () => reject(new Error("Turnstile failed to load.")), { once: true });
			document.head.appendChild(script);
		});
	}

	async function issueAssetDraftIntent(turnstileToken: string) {
		if (!form) throw new Error("Asset form is missing.");
		const payload = {
			draftId: assetDraftId,
			turnstileToken,
			formStartedAt: form.dataset.formStartedAt || new Date().toISOString(),
			companyWebsite: (form.querySelector<HTMLInputElement>("[name='companyWebsite']")?.value ?? ""),
		};
		const response = await fetch("/test-corridor/api/wf1-rental/owner/assets/draft-intent", {
			method: "POST",
			credentials: "same-origin",
			headers: { "Content-Type": "application/json", "X-EmDash-Request": "1" },
			body: JSON.stringify(payload),
		});
		const data = await response.json().catch(() => ({}));
		if (!response.ok) throw new Error(data?.error?.message ?? "Verification failed.");
		return String((data?.data ?? data)?.assetDraftToken ?? "");
	}

	async function initAssetCreateGuard() {
		restoreCreateAssetDraft();
		if (!form) return;
		for (const fileInput of form.querySelectorAll<HTMLInputElement>("input[type='file']")) {
			fileInput.addEventListener("click", (event) => { ensureLoggedInForCreate(event); });
		}
		form.addEventListener("submit", (event) => { if (!ensureLoggedInForCreate(event)) return; });
		if (!userIsLoggedIn()) {
			setAssetCreateLocked(true, "Fill the listing now. Your data is safe in this browser; continue securely only when adding photos or sending for review.");
			return;
		}

		const controls = createAssetControls();
		const siteKey = form.dataset.turnstileSiteKey || controls.turnstileSlot?.dataset.siteKey || "";
		if (!siteKey || !controls.turnstileSlot || !controls.tokenInput) {
			setAssetCreateLocked(true, "Verification is not configured. Ask admin to configure Turnstile before asset creation.");
			return;
		}
		setAssetCreateLocked(true, "Complete verification to unlock photo upload and review submission.");
		try {
			await loadTurnstileScript();
			const api = browserTurnstile();
			if (!api) throw new Error("Turnstile API is unavailable.");
			api.render(controls.turnstileSlot, {
				sitekey: siteKey,
				appearance: "interaction-only",
				callback: async (token: unknown) => {
					try {
						const assetDraftToken = await issueAssetDraftIntent(String(token));
						controls.tokenInput!.value = assetDraftToken;
						setAssetCreateLocked(false, "Verified. You can now upload one primary image and request marketplace review.");
					} catch (error) {
						controls.tokenInput!.value = "";
						setAssetCreateLocked(true, error instanceof Error ? error.message : "Verification failed.");
					}
				},
				"expired-callback": () => {
					controls.tokenInput!.value = "";
					setAssetCreateLocked(true, "Verification expired. Please verify again.");
				},
				"error-callback": () => {
					controls.tokenInput!.value = "";
					setAssetCreateLocked(true, "Verification failed. Please retry.");
				},
			});
		} catch (error) {
			setAssetCreateLocked(true, error instanceof Error ? error.message : "Verification could not load.");
		}
	}

	window.addEventListener("pageshow", (event) => {
		if (event.persisted) window.location.reload();
	});

	void initAssetCreateGuard();

	type MediaRef = {
		mediaId: string;
		uploadId?: string;
		storageKey: string;
		mimeType: string;
		filename: string;
		url: string;
		kind: string;
		scope: string;
		createdAt: string;
	};

	type InventoryItem = {
		itemLabel: string;
		itemKind: string;
		itemGroup: string;
		quantity: string;
		ownerDeclaredState: string;
		conditionDetails: string;
	};

	const starterInventory: InventoryItem[] = [
		{ itemLabel: "Geyser", itemKind: "appliance", itemGroup: "bathroom", quantity: "1", ownerDeclaredState: "working", conditionDetails: "Heats water, no leakage." },
		{ itemLabel: "Fridge", itemKind: "appliance", itemGroup: "kitchen", quantity: "1", ownerDeclaredState: "working", conditionDetails: "Silent, cooling is ok." },
		{ itemLabel: "Washing machine", itemKind: "appliance", itemGroup: "utility", quantity: "1", ownerDeclaredState: "working", conditionDetails: "" },
		{ itemLabel: "RO purifier", itemKind: "appliance", itemGroup: "kitchen", quantity: "1", ownerDeclaredState: "working", conditionDetails: "" },
		{ itemLabel: "Fans", itemKind: "fixture", itemGroup: "all rooms", quantity: "4", ownerDeclaredState: "working", conditionDetails: "" },
		{ itemLabel: "Lights", itemKind: "fixture", itemGroup: "all rooms", quantity: "8", ownerDeclaredState: "working", conditionDetails: "" },
		{ itemLabel: "Curtains", itemKind: "furnishing", itemGroup: "bedrooms", quantity: "4", ownerDeclaredState: "good", conditionDetails: "" },
		{ itemLabel: "Wardrobe", itemKind: "furniture", itemGroup: "bedroom", quantity: "2", ownerDeclaredState: "good", conditionDetails: "" },
		{ itemLabel: "Sofa", itemKind: "furniture", itemGroup: "living room", quantity: "1", ownerDeclaredState: "worn", conditionDetails: "Minor fabric marks." },
		{ itemLabel: "Dining table", itemKind: "furniture", itemGroup: "dining", quantity: "1", ownerDeclaredState: "good", conditionDetails: "" },
		{ itemLabel: "Bed", itemKind: "furniture", itemGroup: "bedroom", quantity: "2", ownerDeclaredState: "good", conditionDetails: "" },
		{ itemLabel: "Mattress", itemKind: "furnishing", itemGroup: "bedroom", quantity: "2", ownerDeclaredState: "good", conditionDetails: "" },
		{ itemLabel: "Keys", itemKind: "access", itemGroup: "main door", quantity: "2", ownerDeclaredState: "handed over", conditionDetails: "Two physical keys." },
		{ itemLabel: "Remote controls", itemKind: "accessory", itemGroup: "living room", quantity: "2", ownerDeclaredState: "working", conditionDetails: "" },
	];

	function htmlEscape(value = "") {
		return value.replaceAll("&", "&amp;").replaceAll("<", "&lt;").replaceAll(">", "&gt;").replaceAll('"', "&quot;");
	}

	function mediaRefFromHidden(prefix: string, kind: string, scope: string): MediaRef | null {
		if (!form) return null;

		const read = (name: string) =>
			(form.querySelector<HTMLInputElement>(`[name="${prefix}.${name}"]`)?.value ?? "").trim();

		const mediaId = read("mediaId");
		const uploadId = read("uploadId");
		const storageKey = read("storageKey");
		const mimeType = read("mimeType");
		const filename = read("filename");
		const url = read("url");

		if (!mediaId && !storageKey && !url) return null;

		return {
			mediaId,
			uploadId,
			storageKey,
			mimeType,
			filename,
			url,
			kind,
			scope,
			createdAt: new Date().toISOString(),
		};
	}

	async function uploadMediaFile(file: File, kind: string, scope: string, clientItemId: string): Promise<MediaRef> {
		const body = new FormData();
		body.append("file", file);
		body.append("purpose", "asset_draft_media");
		body.append("draftId", assetDraftId);
		body.append("clientItemId", clientItemId);

		const assetDraftToken = form?.querySelector<HTMLInputElement>("[name='assetDraftToken']")?.value ?? "";

		if (!assetDraftToken) {
			throw new Error("Complete verification before uploading asset media.");
		}

		body.append("assetDraftToken", assetDraftToken);

		const response = await fetch(wf1UploadUrl, {
			method: "POST",
			credentials: "same-origin",
			headers: {
				"X-EmDash-Request": "1",
			},
			body,
		});

		const payload = await response.json().catch(() => ({}));

		if (response.status === 401 || response.status === 403) {
			saveCreateAssetDraft();
		}

		if (!response.ok) {
			throw new Error(payload?.error?.message ?? "Media upload failed");
		}

		const data = payload?.data ?? payload;
		const item = data?.item ?? {};
		const upload = data?.upload ?? {};

		return {
			mediaId: String(item?.id ?? ""),
			uploadId: String(upload?.id ?? ""),
			storageKey: String(item?.storageKey ?? ""),
			mimeType: String(item?.mimeType ?? file.type),
			filename: String(item?.filename ?? file.name),
			url: String(item?.url ?? ""),
			kind,
			scope,
			createdAt: new Date().toISOString(),
		};
	}

	function addInventoryRow(item: Partial<InventoryItem> = {}) {
		if (!inventoryEditor) return;

		const row = document.createElement("article");
		row.className = "inventory-row";
		row.dataset.clientItemId = crypto.randomUUID();
		row.innerHTML = `
			<label>
				Item label
				<input name="itemLabel" value="${htmlEscape(item.itemLabel)}" />
			</label>
			<label>
				Item kind
				<input name="itemKind" value="${htmlEscape(item.itemKind ?? "fixture")}" />
			</label>
			<label>
				Room / group
				<input name="itemGroup" value="${htmlEscape(item.itemGroup)}" />
			</label>
			<label>
				Quantity
				<input name="quantity" type="number" value="${htmlEscape(item.quantity ?? "1")}" />
			</label>
			<label>
				Owner declared state
				<input name="ownerDeclaredState" value="${htmlEscape(item.ownerDeclaredState ?? "working")}" />
			</label>
			<label>
				Item image/PDF evidence
				<input name="mediaFile" type="file" accept="image/*,application/pdf" />
				<span class="media-note">Optional. Stored through HandoverNow upload API using EmDash media storage.</span>
			</label>
			<label class="wide">
				Condition details
				<textarea name="conditionDetails">${htmlEscape(item.conditionDetails ?? "")}</textarea>
			</label>
			<button class="rental-button secondary remove-row" type="button">Delete row</button>
		`;

		row.querySelector(".remove-row")?.addEventListener("click", () => row.remove());
		inventoryEditor.append(row);
	}

	async function collectInventoryRows() {
		const rows = [...document.querySelectorAll<HTMLElement>(".inventory-row")];
		const items = [];

		for (const row of rows) {
			const scoped = (name: string) =>
				(row.querySelector<HTMLInputElement | HTMLTextAreaElement>(`[name="${name}"]`)?.value ?? "").trim();

			const itemLabel = scoped("itemLabel");
			if (!itemLabel) continue;

			const clientItemId = row.dataset.clientItemId ?? crypto.randomUUID();
			const mediaFile = row.querySelector<HTMLInputElement>('[name="mediaFile"]')?.files?.[0];
			const mediaRefs = mediaFile
				? [await uploadMediaFile(mediaFile, "item_evidence", "asset_config_item", clientItemId)]
				: [];

			items.push({
				itemKind: scoped("itemKind") || "fixture",
				itemGroup: scoped("itemGroup"),
				itemLabel,
				ownerDeclaredState: scoped("ownerDeclaredState") || "working",
				itemSpec: {
					quantity: Number(scoped("quantity") || "1"),
					room: scoped("itemGroup"),
					conditionDetails: scoped("conditionDetails"),
					draftId: assetDraftId,
					clientItemId,
				},
				mediaRefs,
			});
		}

		return items;
	}

	async function postJson(url: string, body: Record<string, unknown>) {
		const response = await fetch(url, {
			method: "POST",
			headers: {
				"Content-Type": "application/json",
				"X-EmDash-Request": "1",
			},
			body: JSON.stringify(body),
		});

		const payload = await response.json().catch(() => ({}));

		if (!response.ok) {
			throw new Error(payload?.error?.message ?? `${url} failed`);
		}

		return payload.data;
	}

	function readPreScreenQuestions(data: FormData): Array<Record<string, unknown>> {
		const raw = String(data.get("preScreenQuestionsJson") ?? "[]");

		try {
			const parsed = JSON.parse(raw);

			if (!Array.isArray(parsed)) {
				throw new Error("Screening questions must be an array.");
			}

			return parsed.filter((item) => item && typeof item === "object" && !Array.isArray(item)) as Array<Record<string, unknown>>;
		} catch (error) {
			if (error instanceof Error) {
				throw new Error(`Screening questions are invalid: ${error.message}`);
			}

			throw new Error("Screening questions are invalid.");
		}
	}

	form?.addEventListener("submit", async (event) => {
		event.preventDefault();

		const data = new FormData(form);

		if (status) status.textContent = "Creating asset...";

		try {
			const preScreenQuestions = readPreScreenQuestions(data);
			const ownerConditionsSpec = {
				depositPolicy: data.get("depositPolicy"),
				documentsRequired: [],
				preScreenQuestions,
			};

			const assetMediaRef = mediaRefFromHidden("assetMedia", "asset_thumbnail", "asset");
			const assetDraftToken = form.querySelector<HTMLInputElement>("[name='assetDraftToken']")?.value ?? "";

			if (!assetDraftToken) {
				throw new Error("Complete verification before sending this asset for review.");
			}

			if (!assetMediaRef || !assetMediaRef.mimeType.startsWith("image/")) {
				throw new Error("Upload one primary property image before creating this asset.");
			}

			const addData = await postJson("/test-corridor/api/wf1-rental/owner/assets/add", {
				draftId: assetDraftId,
				assetDraftToken,
				primaryMediaRef: assetMediaRef,
				assetKind: data.get("assetKind"),
				title: data.get("title"),
				locationLabel: data.get("locationLabel"),
				publicPrice: Number(data.get("publicPrice")),
				currency: "INR",
				ownerConditionsSpec,
				configSpec: {
					bedrooms: Number(data.get("bedrooms")),
					furnishing: data.get("furnishing"),
					thumbnailMediaRef: assetMediaRef,
					mediaRefs: [assetMediaRef],
					draftId: assetDraftId,
				},
			});

			const assetId = addData.asset.id;

			await postJson(`/test-corridor/api/wf1-rental/owner/assets/${assetId}/config`, {
				publicPrice: Number(data.get("publicPrice")),
				minimumMonths: Number(data.get("minimumMonths")),
				configSpec: {
					bedrooms: Number(data.get("bedrooms")),
					furnishing: data.get("furnishing"),
					thumbnailMediaRef: assetMediaRef,
					mediaRefs: assetMediaRef ? [assetMediaRef] : [],
					draftId: assetDraftId,
				},
				conditionSpec: {
					walls: data.get("walls"),
				},
				ownerConditionsSpec,
				items: await collectInventoryRows(),
			});

			if (data.get("publish")) {
				await postJson(`/test-corridor/api/wf1-rental/owner/assets/${assetId}/request-marketplace-review`, {});
			}

			clearCreateAssetDraft();
			location.href = `/test-corridor/wf1/marketplace/assets/${assetId}`;
		} catch (error) {
			if (status) {
				status.textContent = error instanceof Error ? error.message : "Create asset failed";
			}
		}
	});

	addInventoryRow({
		itemLabel: "Geyser",
		itemKind: "appliance",
		itemGroup: "bathroom",
		quantity: "1",
		ownerDeclaredState: "working",
		conditionDetails: "Heats water, no leakage.",
	});

	addInventoryRowButton?.addEventListener("click", () => addInventoryRow());

	addStarterInventoryButton?.addEventListener("click", () => {
		inventoryEditor?.replaceChildren();
		starterInventory.forEach(addInventoryRow);
	});

	(window as unknown as { __rentalFormsReady?: boolean }).__rentalFormsReady = true;
</script>


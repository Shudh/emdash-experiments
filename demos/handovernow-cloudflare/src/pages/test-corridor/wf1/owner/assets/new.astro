---
import Wf1TestBase from "../../../../../components/wf1-test/Wf1TestBase.astro";
import Wf1MediaUpload from "../../../../../components/wf1-test/Wf1MediaUpload.astro";
import Wf1OwnerScreeningQuestionBuilderIsland from "../../../../../components/wf1/Wf1OwnerScreeningQuestionBuilderIsland.astro";

import Wf1TestLaneBanner from "../../../../../components/wf1-test/Wf1TestLaneBanner.astro";

import {
	applyTestLaneNoStoreHeaders,
	testLaneHostRejectionResponse,
} from "../../../../../lib/wf1/routing/host-policy.js";

export const prerender = false;

const rejection = testLaneHostRejectionResponse(Astro.request);

if (rejection) {
	return rejection;
}

applyTestLaneNoStoreHeaders(Astro.response.headers);

const assetDraftId = crypto.randomUUID();
const wf1UploadUrl = "/test-corridor/api/wf1-rental/uploads";
---

<Wf1TestBase title="Add asset under management" description="Create a managed rental asset">
	<Wf1TestLaneBanner />

	<section class="rental-section">
		<div class="rental-shell create-grid">
			<div>
				<p class="rental-kicker">Owner asset</p>
				<h1>Create draft asset</h1>
				<p class="rental-muted">
					Create the property or rentable asset here. Add the listing image, owner conditions,
					furnishings, fixtures, and optional evidence. The application workflow starts only
					after an interested applicant applies. This configuration specification will be used to manage asset lifecycle changes.
				</p>
			</div>

			<form class="rental-panel create-form" id="asset-form" data-asset-draft-id={assetDraftId} data-wf1-upload-url={wf1UploadUrl}>
				<div class="rental-form-grid">
					<div class="rental-field">
						<label for="assetKind">Asset kind</label>
						<select id="assetKind" name="assetKind">
							<option value="flat">Flat</option>
							<option value="villa">Villa</option>
							<option value="independent_house">Independent house</option>
							<option value="room">Room / PG unit</option>
							<option value="commercial_unit">Commercial unit</option>
							<option value="rentable_asset">Other rentable asset</option>
						</select>
					</div>

					<div class="rental-field">
						<label for="title">Title</label>
						<input id="title" name="title" required />
					</div>

					<div class="rental-field">
						<label for="locationLabel">Location</label>
						<input id="locationLabel" name="locationLabel" value="Bangalore" />
					</div>

					<div class="rental-field">
						<label for="publicPrice">Price</label>
						<input id="publicPrice" name="publicPrice" type="number" value="60000" required />
					</div>

					<div class="rental-field">
						<label for="minimumMonths">Minimum months</label>
						<input id="minimumMonths" name="minimumMonths" type="number" value="11" />
					</div>

					<div class="rental-field">
						<label for="bedrooms">Bedrooms</label>
						<input id="bedrooms" name="bedrooms" type="number" value="2" />
					</div>

					<div class="rental-field">
						<label for="furnishing">Furnishing</label>
						<input id="furnishing" name="furnishing" value="semi_furnished" />
					</div>

					<div class="rental-field">
						<label for="walls">Physical condition</label>
						<input id="walls" name="walls" value="freshly_painted" />
					</div>

					<div class="rental-field full">
						<label for="depositPolicy">Owner rental conditions</label>
						<textarea id="depositPolicy" name="depositPolicy">Two months deposit covers chargeable damage.</textarea>
					</div>

					<Wf1OwnerScreeningQuestionBuilderIsland fieldName="preScreenQuestionsJson" />

					<Wf1MediaUpload
						prefix="assetMedia"
						label="Primary property image or PDF"
						required={false}
						uploadUrl={wf1UploadUrl}
						purpose="asset_draft_media"
						draftId={assetDraftId}
						clientItemId="primary"
					/>

					<div class="rental-field">
						<label>
							<input name="publish" type="checkbox" />
							Request marketplace review
						</label>
					</div>
				</div>

				<section class="form-section" aria-labelledby="inventory-heading">
					<div class="section-head">
						<div>
							<p class="rental-kicker">Inventory</p>
							<h2 id="inventory-heading">Asset config items</h2>
							<p class="rental-muted">
								Each item can carry its own optional image/PDF evidence.
							</p>
						</div>
						<div class="section-actions">
							<button class="rental-button secondary" type="button" id="add-starter-inventory">
								Add starter flat inventory
							</button>
							<button class="rental-button secondary" type="button" id="add-inventory-row">
								Add row
							</button>
						</div>
					</div>

					<div class="inventory-editor" id="inventory-editor"></div>
				</section>

				<button class="rental-button" type="submit">Create asset</button>
				<p class="rental-status" id="asset-status"></p>
			</form>
		</div>
	</section>


<script is:inline data-hn-create-asset-ux-v2>
(() => {
	const DRAFT_KEY = "hn:wf1:test:create-asset:draft:v2";
	const NOTICE_CLASS = "hn-create-asset-auth-notice";

	function loggedIn() {
		const bodyText = document.body.textContent || "";
		return bodyText.includes("Logout") || /Welcome\s+[^\s@]+@[^\s@]+/.test(bodyText);
	}

	function safeLoginUrl() {
		return `/login?redirect=${encodeURIComponent(location.pathname + location.search)}`;
	}

	function candidateForms() {
		return Array.from(document.querySelectorAll("form")).filter((form) => form.querySelector("input, textarea, select"));
	}

	function mainForm() {
		const forms = candidateForms();
		return forms.find((form) => /asset|flat|property|marketplace|bedroom|furnishing/i.test(form.textContent || "")) || forms[0] || null;
	}

	function controlsFor(form) {
		return Array.from(form.querySelectorAll("input, textarea, select")).filter((control) => {
			if (!control.name && !control.id) return false;
			if (control.type === "file") return false;
			if (control.type === "password") return false;
			return true;
		});
	}

	function saveDraft() {
		const form = mainForm();
		if (!form) return;
		const fields = {};
		for (const control of controlsFor(form)) {
			const key = control.name || control.id;
			if (!key) continue;
			if (control.type === "checkbox" || control.type === "radio") {
				fields[key] = { checked: Boolean(control.checked), value: control.value };
			} else {
				fields[key] = { value: control.value };
			}
		}
		try {
			sessionStorage.setItem(DRAFT_KEY, JSON.stringify({ savedAt: Date.now(), fields }));
		} catch {}
	}

	function restoreDraft() {
		const form = mainForm();
		if (!form) return;
		let parsed = null;
		try {
			parsed = JSON.parse(sessionStorage.getItem(DRAFT_KEY) || "null");
		} catch {}
		if (!parsed || !parsed.fields) return;
		for (const control of controlsFor(form)) {
			const key = control.name || control.id;
			const saved = parsed.fields[key];
			if (!saved) continue;
			if (control.type === "checkbox" || control.type === "radio") {
				control.checked = Boolean(saved.checked);
			} else if (typeof saved.value === "string" && !control.value) {
				control.value = saved.value;
			}
		}
		showNotice("We restored your saved form after login. Please reselect the photo/PDF, because browsers do not restore file inputs for security.");
	}

	function showNotice(message) {
		const form = mainForm();
		if (!form) return;
		let notice = document.querySelector(`.${NOTICE_CLASS}`);
		if (!notice) {
			notice = document.createElement("div");
			notice.className = NOTICE_CLASS;
			form.prepend(notice);
		}
		notice.textContent = message;
	}

	function guardLogin(event, message) {
		if (loggedIn()) return false;
		event.preventDefault();
		saveDraft();
		showNotice(message);
		setTimeout(() => {
			location.href = safeLoginUrl();
		}, 120);
		return true;
	}

	function improveMandatoryReviewCheckbox() {
		for (const checkbox of document.querySelectorAll("input[type='checkbox']")) {
			const label = checkbox.closest("label") || checkbox.parentElement;
			const labelText = label?.textContent || "";
			if (!/request marketplace review/i.test(labelText)) continue;
			checkbox.checked = true;
			checkbox.style.position = "absolute";
			checkbox.style.opacity = "0";
			checkbox.style.pointerEvents = "none";
			if (label && !label.querySelector("[data-review-required-pill]")) {
				const pill = document.createElement("span");
				pill.dataset.reviewRequiredPill = "true";
				pill.className = "hn-review-required-pill";
				pill.textContent = "Marketplace review is required before listing";
				label.textContent = "";
				label.append(checkbox, pill);
			}
		}
	}

	function attachGuards() {
		const form = mainForm();
		if (!form) return;

		form.addEventListener("input", saveDraft, { passive: true });
		form.addEventListener("change", saveDraft, { passive: true });

		for (const fileInput of form.querySelectorAll("input[type='file']")) {
			fileInput.addEventListener("click", (event) => {
				guardLogin(event, "Login is needed before photo/PDF upload. Your typed listing details are saved and will be restored after login.");
			});
		}

		form.addEventListener("submit", (event) => {
			guardLogin(event, "Login is needed before sending the asset for marketplace review. Your typed listing details are saved and will be restored after login.");
		});

		if (!loggedIn()) {
			showNotice("You can fill the listing now. Login is needed only before upload or final review request; typed fields are saved in this browser.");
		}
	}

	restoreDraft();
	improveMandatoryReviewCheckbox();
	attachGuards();
})();
</script>

<style is:global>
	.hn-create-asset-auth-notice {
		border: 1px solid rgba(234, 88, 12, 0.35);
		border-radius: var(--r-radius);
		padding: 12px 14px;
		margin: 0 0 16px;
		background: rgba(255, 247, 237, 0.92);
		color: var(--r-brand-strong);
		font-weight: 750;
	}

	.hn-review-required-pill {
		display: inline-flex;
		align-items: center;
		border: 1px solid var(--r-border);
		border-radius: 999px;
		padding: 6px 10px;
		background: var(--r-panel-soft);
		color: var(--r-muted);
		font-weight: 800;
	}
</style>

</Wf1TestBase>

<script>
	const form = document.querySelector<HTMLFormElement>("#asset-form");
	const status = document.querySelector<HTMLElement>("#asset-status");
	const inventoryEditor = document.querySelector<HTMLElement>("#inventory-editor");
	const addInventoryRowButton = document.querySelector<HTMLButtonElement>("#add-inventory-row");
	const addStarterInventoryButton = document.querySelector<HTMLButtonElement>("#add-starter-inventory");
	const assetDraftId = form?.dataset.assetDraftId ?? crypto.randomUUID();
	const wf1UploadUrl = form?.dataset.wf1UploadUrl ?? "/test-corridor/api/wf1-rental/uploads";

	type MediaRef = {
		mediaId: string;
		uploadId?: string;
		storageKey: string;
		mimeType: string;
		filename: string;
		url: string;
		kind: string;
		scope: string;
		createdAt: string;
	};

	type InventoryItem = {
		itemLabel: string;
		itemKind: string;
		itemGroup: string;
		quantity: string;
		ownerDeclaredState: string;
		conditionDetails: string;
	};

	const starterInventory: InventoryItem[] = [
		{ itemLabel: "Geyser", itemKind: "appliance", itemGroup: "bathroom", quantity: "1", ownerDeclaredState: "working", conditionDetails: "Heats water, no leakage." },
		{ itemLabel: "Fridge", itemKind: "appliance", itemGroup: "kitchen", quantity: "1", ownerDeclaredState: "working", conditionDetails: "Silent, cooling is ok." },
		{ itemLabel: "Washing machine", itemKind: "appliance", itemGroup: "utility", quantity: "1", ownerDeclaredState: "working", conditionDetails: "" },
		{ itemLabel: "RO purifier", itemKind: "appliance", itemGroup: "kitchen", quantity: "1", ownerDeclaredState: "working", conditionDetails: "" },
		{ itemLabel: "Fans", itemKind: "fixture", itemGroup: "all rooms", quantity: "4", ownerDeclaredState: "working", conditionDetails: "" },
		{ itemLabel: "Lights", itemKind: "fixture", itemGroup: "all rooms", quantity: "8", ownerDeclaredState: "working", conditionDetails: "" },
		{ itemLabel: "Curtains", itemKind: "furnishing", itemGroup: "bedrooms", quantity: "4", ownerDeclaredState: "good", conditionDetails: "" },
		{ itemLabel: "Wardrobe", itemKind: "furniture", itemGroup: "bedroom", quantity: "2", ownerDeclaredState: "good", conditionDetails: "" },
		{ itemLabel: "Sofa", itemKind: "furniture", itemGroup: "living room", quantity: "1", ownerDeclaredState: "worn", conditionDetails: "Minor fabric marks." },
		{ itemLabel: "Dining table", itemKind: "furniture", itemGroup: "dining", quantity: "1", ownerDeclaredState: "good", conditionDetails: "" },
		{ itemLabel: "Bed", itemKind: "furniture", itemGroup: "bedroom", quantity: "2", ownerDeclaredState: "good", conditionDetails: "" },
		{ itemLabel: "Mattress", itemKind: "furnishing", itemGroup: "bedroom", quantity: "2", ownerDeclaredState: "good", conditionDetails: "" },
		{ itemLabel: "Keys", itemKind: "access", itemGroup: "main door", quantity: "2", ownerDeclaredState: "handed over", conditionDetails: "Two physical keys." },
		{ itemLabel: "Remote controls", itemKind: "accessory", itemGroup: "living room", quantity: "2", ownerDeclaredState: "working", conditionDetails: "" },
	];

	function htmlEscape(value = "") {
		return value.replaceAll("&", "&amp;").replaceAll("<", "&lt;").replaceAll(">", "&gt;").replaceAll('"', "&quot;");
	}

	function mediaRefFromHidden(prefix: string, kind: string, scope: string): MediaRef | null {
		if (!form) return null;

		const read = (name: string) =>
			(form.querySelector<HTMLInputElement>(`[name="${prefix}.${name}"]`)?.value ?? "").trim();

		const mediaId = read("mediaId");
		const uploadId = read("uploadId");
		const storageKey = read("storageKey");
		const mimeType = read("mimeType");
		const filename = read("filename");
		const url = read("url");

		if (!mediaId && !storageKey && !url) return null;

		return {
			mediaId,
			uploadId,
			storageKey,
			mimeType,
			filename,
			url,
			kind,
			scope,
			createdAt: new Date().toISOString(),
		};
	}

	async function uploadMediaFile(file: File, kind: string, scope: string, clientItemId: string): Promise<MediaRef> {
		const body = new FormData();
		body.append("file", file);
		body.append("purpose", "asset_draft_media");
		body.append("draftId", assetDraftId);
		body.append("clientItemId", clientItemId);

		const response = await fetch(wf1UploadUrl, {
			method: "POST",
			credentials: "same-origin",
			headers: {
				"X-EmDash-Request": "1",
			},
			body,
		});

		const payload = await response.json().catch(() => ({}));

		if (!response.ok) {
			throw new Error(payload?.error?.message ?? "Media upload failed");
		}

		const data = payload?.data ?? payload;
		const item = data?.item ?? {};
		const upload = data?.upload ?? {};

		return {
			mediaId: String(item?.id ?? ""),
			uploadId: String(upload?.id ?? ""),
			storageKey: String(item?.storageKey ?? ""),
			mimeType: String(item?.mimeType ?? file.type),
			filename: String(item?.filename ?? file.name),
			url: String(item?.url ?? ""),
			kind,
			scope,
			createdAt: new Date().toISOString(),
		};
	}

	function addInventoryRow(item: Partial<InventoryItem> = {}) {
		if (!inventoryEditor) return;

		const row = document.createElement("article");
		row.className = "inventory-row";
		row.dataset.clientItemId = crypto.randomUUID();
		row.innerHTML = `
			<label>
				Item label
				<input name="itemLabel" value="${htmlEscape(item.itemLabel)}" />
			</label>
			<label>
				Item kind
				<input name="itemKind" value="${htmlEscape(item.itemKind ?? "fixture")}" />
			</label>
			<label>
				Room / group
				<input name="itemGroup" value="${htmlEscape(item.itemGroup)}" />
			</label>
			<label>
				Quantity
				<input name="quantity" type="number" value="${htmlEscape(item.quantity ?? "1")}" />
			</label>
			<label>
				Owner declared state
				<input name="ownerDeclaredState" value="${htmlEscape(item.ownerDeclaredState ?? "working")}" />
			</label>
			<label>
				Item image/PDF evidence
				<input name="mediaFile" type="file" accept="image/*,application/pdf" />
				<span class="media-note">Optional. Stored through HandoverNow upload API using EmDash media storage.</span>
			</label>
			<label class="wide">
				Condition details
				<textarea name="conditionDetails">${htmlEscape(item.conditionDetails ?? "")}</textarea>
			</label>
			<button class="rental-button secondary remove-row" type="button">Delete row</button>
		`;

		row.querySelector(".remove-row")?.addEventListener("click", () => row.remove());
		inventoryEditor.append(row);
	}

	async function collectInventoryRows() {
		const rows = [...document.querySelectorAll<HTMLElement>(".inventory-row")];
		const items = [];

		for (const row of rows) {
			const scoped = (name: string) =>
				(row.querySelector<HTMLInputElement | HTMLTextAreaElement>(`[name="${name}"]`)?.value ?? "").trim();

			const itemLabel = scoped("itemLabel");
			if (!itemLabel) continue;

			const clientItemId = row.dataset.clientItemId ?? crypto.randomUUID();
			const mediaFile = row.querySelector<HTMLInputElement>('[name="mediaFile"]')?.files?.[0];
			const mediaRefs = mediaFile
				? [await uploadMediaFile(mediaFile, "item_evidence", "asset_config_item", clientItemId)]
				: [];

			items.push({
				itemKind: scoped("itemKind") || "fixture",
				itemGroup: scoped("itemGroup"),
				itemLabel,
				ownerDeclaredState: scoped("ownerDeclaredState") || "working",
				itemSpec: {
					quantity: Number(scoped("quantity") || "1"),
					room: scoped("itemGroup"),
					conditionDetails: scoped("conditionDetails"),
					draftId: assetDraftId,
					clientItemId,
				},
				mediaRefs,
			});
		}

		return items;
	}

	async function postJson(url: string, body: Record<string, unknown>) {
		const response = await fetch(url, {
			method: "POST",
			headers: {
				"Content-Type": "application/json",
				"X-EmDash-Request": "1",
			},
			body: JSON.stringify(body),
		});

		const payload = await response.json().catch(() => ({}));

		if (!response.ok) {
			throw new Error(payload?.error?.message ?? `${url} failed`);
		}

		return payload.data;
	}

	function readPreScreenQuestions(data: FormData): Array<Record<string, unknown>> {
		const raw = String(data.get("preScreenQuestionsJson") ?? "[]");

		try {
			const parsed = JSON.parse(raw);

			if (!Array.isArray(parsed)) {
				throw new Error("Screening questions must be an array.");
			}

			return parsed.filter((item) => item && typeof item === "object" && !Array.isArray(item)) as Array<Record<string, unknown>>;
		} catch (error) {
			if (error instanceof Error) {
				throw new Error(`Screening questions are invalid: ${error.message}`);
			}

			throw new Error("Screening questions are invalid.");
		}
	}

	form?.addEventListener("submit", async (event) => {
		event.preventDefault();

		const data = new FormData(form);

		if (status) status.textContent = "Creating asset...";

		try {
			const preScreenQuestions = readPreScreenQuestions(data);
			const ownerConditionsSpec = {
				depositPolicy: data.get("depositPolicy"),
				documentsRequired: [],
				preScreenQuestions,
			};

			const assetMediaRef = mediaRefFromHidden("assetMedia", "asset_thumbnail", "asset");

			const addData = await postJson("/test-corridor/api/wf1-rental/owner/assets/add", {
				assetKind: data.get("assetKind"),
				title: data.get("title"),
				locationLabel: data.get("locationLabel"),
				publicPrice: Number(data.get("publicPrice")),
				currency: "INR",
				ownerConditionsSpec,
			});

			const assetId = addData.asset.id;

			await postJson(`/test-corridor/api/wf1-rental/owner/assets/${assetId}/config`, {
				publicPrice: Number(data.get("publicPrice")),
				minimumMonths: Number(data.get("minimumMonths")),
				configSpec: {
					bedrooms: Number(data.get("bedrooms")),
					furnishing: data.get("furnishing"),
					thumbnailMediaRef: assetMediaRef,
					mediaRefs: assetMediaRef ? [assetMediaRef] : [],
					draftId: assetDraftId,
				},
				conditionSpec: {
					walls: data.get("walls"),
				},
				ownerConditionsSpec,
				items: await collectInventoryRows(),
			});

			if (data.get("publish")) {
				await postJson(`/test-corridor/api/wf1-rental/owner/assets/${assetId}/request-marketplace-review`, {});
			}

			location.href = `/test-corridor/wf1/marketplace/assets/${assetId}`;
		} catch (error) {
			if (status) {
				status.textContent = error instanceof Error ? error.message : "Create asset failed";
			}
		}
	});

	addInventoryRow({
		itemLabel: "Geyser",
		itemKind: "appliance",
		itemGroup: "bathroom",
		quantity: "1",
		ownerDeclaredState: "working",
		conditionDetails: "Heats water, no leakage.",
	});

	addInventoryRowButton?.addEventListener("click", () => addInventoryRow());

	addStarterInventoryButton?.addEventListener("click", () => {
		inventoryEditor?.replaceChildren();
		starterInventory.forEach(addInventoryRow);
	});

	(window as unknown as { __rentalFormsReady?: boolean }).__rentalFormsReady = true;
</script>

<style>
	.create-grid,
	.create-form,
	.inventory-editor {
		display: grid;
		gap: 16px;
	}

	.create-grid {
		grid-template-columns: minmax(260px, 0.65fr) minmax(0, 1.35fr);
		gap: 28px;
		align-items: start;
	}

	.form-section {
		display: grid;
		gap: 14px;
		border-top: 1px solid var(--r-border);
		padding-top: 18px;
	}

	.section-head,
	.section-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
	}

	.section-head {
		align-items: end;
		justify-content: space-between;
	}

	.inventory-row {
		display: grid;
		grid-template-columns: repeat(4, minmax(130px, 1fr));
		gap: 10px;
		border: 1px solid var(--r-border);
		border-radius: var(--r-radius);
		padding: 12px;
		background: var(--r-bg);
	}

	.inventory-row label {
		display: grid;
		gap: 6px;
		color: var(--r-muted);
		font-size: 0.84rem;
		font-weight: 750;
	}

	.inventory-row label.wide {
		grid-column: span 2;
	}

	.inventory-row input,
	.inventory-row textarea {
		width: 100%;
		border: 1px solid var(--r-border);
		border-radius: var(--r-radius);
		padding: 9px 10px;
		background: var(--r-panel);
		color: var(--r-text);
	}

	.media-note {
		color: var(--r-muted);
		font-size: 0.78rem;
		font-weight: 650;
	}

	@media (max-width: 900px) {
		.create-grid {
			grid-template-columns: 1fr;
		}

		.inventory-row {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 560px) {
		.inventory-row,
		.inventory-row label.wide {
			grid-template-columns: 1fr;
			grid-column: span 1;

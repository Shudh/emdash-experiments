---
import Wf1TestBase from "../../../../components/wf1-test/Wf1TestBase.astro";
import Wf1ApplicationList from "../../../../components/wf1-test/Wf1ApplicationList.astro";

import { DomainError } from "../../../../lib/domain/types.js";
import { getWorkflowOwnerDashboard } from "../../../../lib/wf1/queries/owner-dashboard.js";
import { getRequiredWf1PageContext } from "../../../../lib/wf1/server/context.js";
import { isWf1Superadmin } from "../../../../lib/wf1/core/marketplace-review.js";

import Wf1TestLaneBanner from "../../../../components/wf1-test/Wf1TestLaneBanner.astro";

import {
	applyTestLaneNoStoreHeaders,
	testLaneHostRejectionResponse,
} from "../../../../lib/wf1/routing/host-policy.js";

export const prerender = false;

const rejection = testLaneHostRejectionResponse(Astro.request);

if (rejection) {
	return rejection;
}

applyTestLaneNoStoreHeaders(Astro.response.headers);


type JsonObject = Record<string, unknown>;

type DashboardLoadResult =
	| {
			ok: true;
			assets: Array<JsonObject>;
			applicationRows: Array<JsonObject>;
			isSuperadmin: boolean;
			error: null;
	  }
	| {
			ok: false;
			assets: Array<JsonObject>;
			applicationRows: Array<JsonObject>;
			isSuperadmin: boolean;
			error: string;
	  };

async function loadDashboardDirect(): Promise<DashboardLoadResult> {
	try {
		const { store, user } = await getRequiredWf1PageContext(Astro);
		const dashboard = await getWorkflowOwnerDashboard(store, user, { lane: "test" });

		return {
			ok: true,
			assets: Array.isArray(dashboard.assets) ? (dashboard.assets as Array<JsonObject>) : [],
			applicationRows: Array.isArray(dashboard.applicationRows)
				? (dashboard.applicationRows as Array<JsonObject>)
				: [],
			isSuperadmin: isWf1Superadmin(user),
			error: null,
		};
	} catch (error) {
		if (error instanceof DomainError) {
			return {
				ok: false,
				assets: [],
				applicationRows: [],
				isSuperadmin: false,
				error: `${error.code}: ${error.message}`,
			};
		}

		console.error("[wf1] Failed to load owner dashboard", error);

		return {
			ok: false,
			assets: [],
			applicationRows: [],
			isSuperadmin: false,
			error: "Owner dashboard could not be loaded.",
		};
	}
}

function rowsFrom(value: unknown): Array<JsonObject> {
	return Array.isArray(value)
		? value.filter((item): item is JsonObject => item !== null && typeof item === "object" && !Array.isArray(item))
		: [];
}

function objectValue(value: unknown): JsonObject {
	return value !== null && typeof value === "object" && !Array.isArray(value) ? value as JsonObject : {};
}

function numberTime(value: unknown): number {
	if (typeof value !== "string") return 0;

	const timestamp = Date.parse(value);
	return Number.isFinite(timestamp) ? timestamp : 0;
}

function latestStamp(row: JsonObject): number {
	return Math.max(
		numberTime(row.updated_at),
		numberTime(row.created_at),
		numberTime(row.published_at),
		numberTime(row.submitted_at),
	);
}

function latestApplicationStamp(application: JsonObject): number {
	const instance = application.instance && typeof application.instance === "object" && !Array.isArray(application.instance)
		? application.instance as JsonObject
		: {};
	const interest = application.interest && typeof application.interest === "object" && !Array.isArray(application.interest)
		? application.interest as JsonObject
		: application;

	return Math.max(latestStamp(application), latestStamp(instance), latestStamp(interest));
}

function latestFirst(rows: Array<JsonObject>): Array<JsonObject> {
	return rows.toSorted((left, right) => latestStamp(right) - latestStamp(left));
}

function latestApplicationsFirst(rows: Array<JsonObject>): Array<JsonObject> {
	return rows.toSorted((left, right) => latestApplicationStamp(right) - latestApplicationStamp(left));
}

const dashboard = await loadDashboardDirect();
const assetRows = latestFirst(dashboard.assets).map((asset) => ({
	asset,
	applications: latestApplicationsFirst(rowsFrom(asset.applications)),
}));
---

<Wf1TestBase title="WF1 owner dashboard" description="WF1 owner dashboard">
	<Wf1TestLaneBanner />

	<section class="rental-section">
		<div class="rental-shell">
			<div class="rental-section-header">
				<div>
					<p class="rental-kicker">Owner</p>
					<h1>Dashboard</h1>
					<p class="rental-muted">Latest assets are displayed first. Each asset shows application forms, Application Form State, and derived actions.</p>
				</div>
				<div class="asset-links">
					{dashboard.ok && dashboard.isSuperadmin ? <a class="rental-button secondary" href="/test-corridor/wf1/admin/publish-queue">Review queue</a> : null}
					<a class="rental-button" href="/test-corridor/wf1/owner/assets/new">Create asset</a>
				</div>
			</div>
			{!dashboard.ok ? (
				<div class="rental-panel">
					<h2>Login required</h2>
					<p class="rental-muted">{dashboard.error ?? "Owner dashboard requires a session."}</p>
				</div>
			) : (
				<div class="asset-sections">
					{assetRows.length ? assetRows.map((row) => {
						const assetId = String(row.asset.id ?? "");
						const assetState = String(row.asset.business_state ?? "draft");
						const visibilityState = String(row.asset.visibility_state ?? "private");
						const review = objectValue(row.asset.marketplaceReview);
						const reviewState = String(review.state ?? "not_requested");
						const rejectReason = String(review.rejectReason ?? "").trim();
						const configSpec = objectValue(row.asset.config_spec);
						const conditionSpec = objectValue(row.asset.condition_spec);
						const ownerConditionsSpec = objectValue(row.asset.owner_conditions_spec);
						const canPublish = (assetState === "draft_asset" || assetState === "listed") && visibilityState !== "marketplace";
						const canRequestReview = canPublish && reviewState !== "requested";
						return (
							<section class="rental-panel asset-management">
								<div class="asset-head">
									<div>
										<p class="rental-kicker">{String(row.asset.asset_kind ?? "asset")}</p>
										<h2>{String(row.asset.title ?? "Untitled asset")}</h2>
										<p class="rental-muted">{String(row.asset.location_label ?? "Location pending")}</p>
									</div>
									<div class="rental-badges">
										<span class="rental-badge">Asset State: {assetState}</span>
										<span class="rental-badge">{visibilityState}</span>
									</div>
								</div>
								<div class="asset-links">
									<a class="rental-button secondary" href={`/test-corridor/wf1/marketplace/assets/${assetId}`}>View listing</a>
									{canRequestReview ? (
										<form
											class="wf1-inline-publish"
											data-wf1-publish-form
											action={`/test-corridor/api/wf1-rental/owner/assets/${assetId}/request-marketplace-review`}
											method="post"
										>
											<button class="rental-button" type="submit">Request marketplace review</button>
											<span class="rental-muted" data-wf1-publish-status></span>
										</form>
									) : null}
								</div>

								{reviewState === "requested" ? (
									<p class="rental-muted wf1-review-status">Marketplace review is waiting for superadmin approval.</p>
								) : null}

								{reviewState === "rejected" ? (
									<div class="wf1-review-rejected">
										<strong>Marketplace review rejected.</strong>
										<p>{rejectReason || "No reason was provided."}</p>
									</div>
								) : null}

								<details class="wf1-owner-edit-panel">
									<summary>Edit listing details</summary>
									<form data-wf1-owner-config-form action={`/test-corridor/api/wf1-rental/owner/assets/${assetId}/config`}>
										<div class="rental-form-grid">
											<div class="rental-field"><label>Price<input name="publicPrice" type="number" value={String(row.asset.public_price ?? "")} /></label></div>
											<div class="rental-field"><label>Minimum months<input name="minimumMonths" type="number" value={String(row.asset.minimum_months ?? "")} /></label></div>
											<div class="rental-field"><label>Bedrooms<input name="bedrooms" type="number" value={String(configSpec.bedrooms ?? "")} /></label></div>
											<div class="rental-field"><label>Furnishing<input name="furnishing" value={String(configSpec.furnishing ?? "")} /></label></div>
											<div class="rental-field"><label>Physical condition<input name="walls" value={String(conditionSpec.walls ?? "")} /></label></div>
											<div class="rental-field full"><label>Owner rental conditions<textarea name="depositPolicy">{String(ownerConditionsSpec.depositPolicy ?? "")}</textarea></label></div>
										</div>
										<button class="rental-button secondary" type="submit">Save changes</button>
										<span class="rental-muted" data-wf1-owner-config-status></span>
									</form>
								</details>

								<h3>Applications</h3>
								<Wf1ApplicationList applications={row.applications} />
							</section>
						);
					}) : (
						<div class="rental-panel"><p class="rental-muted">No owned assets yet.</p></div>
					)}
				</div>
			)}
		</div>
	</section>
</Wf1TestBase>

<script>
	for (const form of document.querySelectorAll<HTMLFormElement>("[data-wf1-owner-config-form]")) {
		form.addEventListener("submit", async (event) => {
			event.preventDefault();
			const status = form.querySelector<HTMLElement>("[data-wf1-owner-config-status]");
			const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');
			const data = new FormData(form);
			if (submit) submit.disabled = true;
			if (status) status.textContent = "Saving changes...";
			try {
				const response = await fetch(form.action, {
					method: "POST",
					credentials: "same-origin",
					headers: { "Content-Type": "application/json", "X-EmDash-Request": "1" },
					body: JSON.stringify({
						publicPrice: Number(data.get("publicPrice") || "0"),
						minimumMonths: Number(data.get("minimumMonths") || "0"),
						configSpec: {
							bedrooms: Number(data.get("bedrooms") || "0"),
							furnishing: data.get("furnishing"),
						},
						conditionSpec: { walls: data.get("walls") },
						ownerConditionsSpec: { depositPolicy: data.get("depositPolicy"), documentsRequired: [] },
					}),
				});
				const payload = await response.json().catch(() => ({}));
				if (!response.ok) throw new Error(payload?.error?.message ?? "Save failed");
				if (status) status.textContent = "Saved.";
				setTimeout(() => location.reload(), 250);
			} catch (error) {
				if (status) status.textContent = error instanceof Error ? error.message : "Save failed";
				if (submit) submit.disabled = false;
			}
		});
	}

	for (const form of document.querySelectorAll<HTMLFormElement>("[data-wf1-publish-form]")) {
		form.addEventListener("submit", async (event) => {
			event.preventDefault();

			const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');
			const status = form.querySelector<HTMLElement>("[data-wf1-publish-status]");

			if (submit) submit.disabled = true;
			if (status) status.textContent = "Publishing...";

			try {
				const response = await fetch(form.action, {
					method: "POST",
					credentials: "same-origin",
					headers: {
						"Content-Type": "application/json",
						"X-EmDash-Request": "1",
					},
					body: "{}",
				});

				const payload = await response.json().catch(() => ({}));

				if (!response.ok) {
					throw new Error(payload?.error?.message ?? "Publish failed");
				}

				location.reload();
			} catch (error) {
				if (status) {
					status.textContent = error instanceof Error ? error.message : "Publish failed";
				}
				if (submit) submit.disabled = false;
			}
		});
	}
</script>

<style>
	.asset-sections,
	.asset-management {
		display: grid;
		gap: 16px;
	}

	.asset-head,
	.asset-links {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
	}

	.wf1-inline-publish,
	.wf1-owner-edit-panel form {
		display: grid;
		gap: 10px;
	}

	.wf1-review-rejected {
		border: 1px solid rgba(220, 38, 38, 0.28);
		border-radius: var(--r-radius);
		background: rgba(254, 242, 242, 0.9);
		padding: 12px;
	}

	.wf1-review-rejected p {
		margin: 6px 0 0;
	}

	.wf1-inline-publish {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 8px;
	}
</style>
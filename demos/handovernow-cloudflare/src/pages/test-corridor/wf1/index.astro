---
import Wf1TestBase from "../../../components/wf1-test/Wf1TestBase.astro";
import Wf1TestLaneBanner from "../../../components/wf1-test/Wf1TestLaneBanner.astro";

import { listMyWorkflowWorkspaces } from "../../../lib/wf1/queries/my-workspaces.js";
import { getWf1PageContext } from "../../../lib/wf1/server/context.js";

import {
	applyTestLaneNoStoreHeaders,
	testLaneHostRejectionResponse,
} from "../../../lib/wf1/routing/host-policy.js";

export const prerender = false;

const rejection = testLaneHostRejectionResponse(Astro.request);

if (rejection) {
	return rejection;
}

applyTestLaneNoStoreHeaders(Astro.response.headers);

type JsonObject = Record<string, unknown>;

const { store, user } = await getWf1PageContext(Astro);

function isObjectRecord(value: unknown): value is JsonObject {
	return value !== null && typeof value === "object" && !Array.isArray(value);
}

function stringValue(value: unknown, fallback = ""): string {
	return typeof value === "string" && value.trim() !== "" ? value.trim() : fallback;
}

function arrayValue(value: unknown): Array<JsonObject> {
	return Array.isArray(value)
		? value.filter((item): item is JsonObject => isObjectRecord(item))
		: [];
}

function objectValue(value: unknown): JsonObject {
	return isObjectRecord(value) ? value : {};
}

function roleLabel(value: unknown): string {
	const role = stringValue(value, "participant");
	if (role === "renter") return "tenant";
	if (role === "owner") return "owner";
	if (role === "applicant") return "applicant";
	return role.replaceAll("_", " ");
}

function workspaceHref(row: JsonObject): string {
	const links = objectValue(row.links);
	return stringValue(links.workspace) || stringValue(links.asset) || "/test-corridor/wf1/marketplace";
}

function workspaceActionLabel(row: JsonObject): string {
	const relationship = stringValue(row.relationship);
	const kind = stringValue(row.kind);
	const links = objectValue(row.links);

	if (stringValue(links.workspace) !== "") return "Open workspace";
	if (relationship === "owner" && kind === "asset") return "Manage asset";
	return "Open asset";
}

function stateBadge(row: JsonObject): string {
	const assetState = objectValue(row.assetState);
	const visibility = stringValue(assetState.visibility);
	const state = stringValue(assetState.id, "unknown");
	return visibility ? `${state} / ${visibility}` : state;
}

function applicationStateLabel(row: JsonObject): string {
	const applicationState = objectValue(row.applicationState);
	return stringValue(applicationState.label);
}

function descriptionFor(row: JsonObject): string {
	const applicationState = objectValue(row.applicationState);
	const description = stringValue(applicationState.description);
	if (description) return description;

	const relationship = stringValue(row.relationship);
	if (relationship === "owner") return "You own this asset or application workspace.";
	if (relationship === "renter") return "This protected owner-tenant workspace is available to you.";
	if (relationship === "applicant") return "This application workspace is available to you.";
	return "This workspace is available to you.";
}

let myWorkspaceIndex: JsonObject = { items: [], counts: {} };
let myWorkspaceError = "";

if (user?.id) {
	try {
		myWorkspaceIndex = await listMyWorkflowWorkspaces(store, user, { lane: "test", limit: 100 }) as unknown as JsonObject;
	} catch (error) {
		console.error("[wf1-test] Failed to load WF1 my workspaces", error);
		myWorkspaceError = "Your workspaces could not be loaded.";
	}
}

const myWorkspaces = arrayValue(myWorkspaceIndex.items);
const latestWorkspaceHref = myWorkspaces[0] ? workspaceHref(myWorkspaces[0]) : "/test-corridor/wf1/marketplace";
const counts = objectValue(myWorkspaceIndex.counts);
---

<Wf1TestBase title="WF1 test corridor" description="WF1 test corridor">
	<Wf1TestLaneBanner />

	<section class="rental-section wf1-home-hero">
		<div class="rental-shell">
			<div class="rental-section-header">
				<div>
					<p class="rental-kicker">WF1 Test Corridor</p>
					<h1>Clean rentals, safely isolated.</h1>
					<p class="rental-muted">
						Test-lane assets, applications, owner-tenant workspaces, task cards, gates, and projection-derived actions.
					</p>
				</div>
				<div class="wf1-actions">
					<a class="rental-button" href="/test-corridor/wf1/marketplace">Marketplace</a>
					<a class="rental-button secondary" href="/test-corridor/wf1/owner">Owner dashboard</a>
					<a class="rental-button secondary" href="/test-corridor/wf1/owner/assets/new">Create asset</a>
					{
						user?.email ? (
							<a class="rental-button secondary" href={latestWorkspaceHref}>My workspaces</a>
						) : null
					}
				</div>
			</div>
		</div>
	</section>

	<section id="my-workspaces" class="rental-section compact-section">
		<div class="rental-shell">
			<div class="rental-section-header">
				<div>
					<p class="rental-kicker">My protected workspaces</p>
					<h2>{myWorkspaces.length ? "Latest first." : user?.email ? "Nothing yet." : "Login to see your workspaces."}</h2>
					<p class="rental-muted">
						{
							myWorkspaces.length
								? `Owner: ${String(counts.owner ?? 0)} · Applicant: ${String(counts.applicant ?? 0)} · Tenant: ${String(counts.renter ?? 0)}`
								: user?.email
									? "Apply from the marketplace or create an asset. Accepted tenant workspaces stay visible here even after the flat leaves marketplace."
									: "Login first. Your owner, applicant, and tenant/renter workspaces will appear here."
						}
					</p>
				</div>
				<a class="rental-button secondary" href="/test-corridor/wf1/marketplace">Browse marketplace</a>
			</div>

			{
				myWorkspaceError ? (
					<div class="rental-panel empty-state">
						<p class="rental-muted">{myWorkspaceError}</p>
					</div>
				) : myWorkspaces.length ? (
					<div class="workspace-index-grid">
						{myWorkspaces.map((row) => (
							<article class:list={["rental-panel", "workspace-index-card", `role-${stringValue(row.relationship, "participant")}`]}>
								<div>
									<p class="rental-kicker">{roleLabel(row.relationship)} workspace</p>
									<h3>
										<a href={workspaceHref(row)}>{stringValue(row.assetTitle, "Untitled asset")}</a>
									</h3>
									<p class="rental-muted">{stringValue(row.locationLabel, "Location pending")}</p>
								</div>

								<div class="rental-badges">
									<span class="rental-badge">Role: {roleLabel(row.relationship)}</span>
									<span class="rental-badge">Asset: {stateBadge(row)}</span>
									{applicationStateLabel(row) ? (
										<span class="rental-badge">Application: {applicationStateLabel(row)}</span>
									) : null}
								</div>

								<p class="rental-muted">{descriptionFor(row)}</p>
								<a class="rental-button" href={workspaceHref(row)}>{workspaceActionLabel(row)}</a>
							</article>
						))}
					</div>
				) : (
					<div class="rental-panel empty-state">
						<p class="rental-muted">
							{user?.email
								? "No protected workspace yet. Go to the test marketplace, open a listed flat, and express interest."
								: "Login to see owner, applicant, and tenant workspaces."}
						</p>
						<a class="rental-button" href="/test-corridor/wf1/marketplace">Open marketplace</a>
					</div>
				)
			}
		</div>
	</section>
</Wf1TestBase>

<style>
	.wf1-home-hero {
		padding-bottom: 28px;
	}

	.wf1-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
	}

	.compact-section {
		padding-top: 24px;
	}

	.workspace-index-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
		gap: 16px;
	}

	.workspace-index-card,
	.empty-state {
		display: grid;
		gap: 12px;
		align-content: start;
	}

	.workspace-index-card h3 a {
		color: inherit;
		text-decoration: none;
	}

	.workspace-index-card h3 a:hover {
		text-decoration: underline;
	}

	.workspace-index-card.role-renter {
		border-color: rgba(22, 163, 74, 0.42);
		background:
			linear-gradient(180deg, rgba(240, 253, 244, 0.76), rgba(255, 255, 255, 0.96)),
			var(--r-panel);
	}

	.workspace-index-card.role-applicant {
		border-color: rgba(234, 88, 12, 0.42);
		background:
			linear-gradient(180deg, rgba(255, 247, 237, 0.76), rgba(255, 255, 255, 0.96)),
			var(--r-panel);
	}
</style>

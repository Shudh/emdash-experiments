---
const title = "Sandbox plugin test disabled";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<style>
			:root {
				color-scheme: light dark;
				font-family:
					Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
					"Segoe UI", sans-serif;
				background: #f8fafc;
				color: #0f172a;
			}

			body {
				margin: 0;
				min-height: 100vh;
				display: grid;
				place-items: center;
				padding: 24px;
			}

			main {
				width: min(720px, 100%);
				border: 1px solid #cbd5e1;
				border-radius: 18px;
				background: #ffffff;
				padding: 28px;
				box-shadow: 0 20px 60px rgba(15, 23, 42, 0.08);
			}

			h1 {
				margin: 0 0 12px;
				font-size: clamp(24px, 4vw, 34px);
				line-height: 1.1;
			}

			p {
				margin: 0 0 14px;
				font-size: 16px;
				line-height: 1.6;
			}

			code {
				padding: 2px 6px;
				border-radius: 6px;
				background: #e2e8f0;
				font-size: 0.95em;
			}

			a {
				color: #2563eb;
				font-weight: 600;
			}

			@media (prefers-color-scheme: dark) {
				:root {
					background: #020617;
					color: #e2e8f0;
				}

				main {
					background: #0f172a;
					border-color: #334155;
					box-shadow: none;
				}

				code {
					background: #1e293b;
				}

				a {
					color: #93c5fd;
				}
			}
		</style>
	</head>
	<body>
		<main>
			<h1>{title}</h1>
			<p>
				This copied demo route was intentionally disabled for the HandoverNow
				vanilla CMS deployment.
			</p>
			<p>
				The first deployment target is a free-plan-safe EmDash CMS using D1 and
				R2 only. The isolated third-party extension demo is not part of this
				milestone.
			</p>
			<p>
				Go to <a href="/_emdash/admin">/_emdash/admin</a> to continue CMS setup.
			</p>
		</main>
	</body>
</html>
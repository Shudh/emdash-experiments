---
import { getEmDashCollection } from "emdash";
import Wf1Base from "../components/wf1/Wf1Base.astro";

export const prerender = false;

const { entries: latestPosts, cacheHint } = await getEmDashCollection("posts", {
	status: "published",
	orderBy: { published_at: "desc" },
	limit: 3,
});

Astro.cache.set(cacheHint);

type LandingPost = (typeof latestPosts)[number];

function formatDate(date: Date | null | undefined): string {
	if (!date) return "";
	return date.toLocaleDateString("en-IN", {
		year: "numeric",
		month: "short",
		day: "numeric",
	});
}

function postHref(post: LandingPost): string {
	return `/posts/${post.id}`;
}

const heroActions = [
	{
		label: "Create rental record",
		href: "/wf1/owner/assets/new",
		tone: "primary",
	},
	{
		label: "See how it works",
		href: "#how-it-works",
		tone: "secondary",
	},
	{
		label: "Read rental guides",
		href: "/blog",
		tone: "secondary",
	},
] as const;

const recordBullets = [
	"Flat condition before move-in",
	"Furnishing and appliance record",
	"Repair and painting expectations",
	"Deposit and move-out rules",
] as const;

const moatCards = [
	{
		title: "Before move-in",
		copy: "Record condition, furnishing, documents, rent terms, deposit rules, and known defects before keys change hands.",
	},
	{
		title: "During tenancy",
		copy: "Keep requests, approvals, repairs, and changes attached to the same rental file.",
	},
	{
		title: "Before move-out",
		copy: "Compare final condition against the accepted record and close deductions with less drama.",
	},
] as const;

const processSteps = [
	{
		number: "01",
		title: "Create the property record",
		copy: "Add the flat, rent terms, deposit details, furnishings, appliances, known defects, and handover expectations.",
	},
	{
		number: "02",
		title: "Bring the tenant into the file",
		copy: "Use the rental file after the match, even when the tenant was found somewhere else.",
	},
	{
		number: "03",
		title: "Agree on the expensive facts",
		copy: "Record repairs, painting, cleaning, appliance status, keys, access cards, and deduction basis before move-in.",
	},
	{
		number: "04",
		title: "Close with evidence",
		copy: "Use the accepted record during move-out inspection and deposit settlement.",
	},
] as const;

const costCards = [
	{
		title: "Painting and wall marks",
		copy: "Record what exists before move-in and what will be treated as damage later.",
	},
	{
		title: "Furnished flats",
		copy: "Capture appliances, furniture, fixtures, keys, remotes, cards, and condition notes in one place.",
	},
	{
		title: "Deposit deductions",
		copy: "Tie deductions to agreed facts instead of last-minute memory and screenshots.",
	},
] as const;

const guideTopics = [
	"Flat handover checklist for Bangalore owners",
	"Tenant move-in photos that prevent deposit fights",
	"Painting and repair costs before move-out",
	"How written rental evidence beats verbal memory",
] as const;
---

<Wf1Base
	title="HandoverNow"
	description="Rental records for flats and villas before move-in, handover, and deposit settlement."
>
	<section class="landing-hero">
		<div class="rental-shell landing-hero-panel">
			<div class="landing-hero-grid">
				<div class="landing-hero-copy">
					<p class="rental-kicker">After the tenant is found</p>
					<h1>Put the rental on record before keys change hands.</h1>
					<p>
						Record condition, furnishings, documents, repair expectations, and deposit rules
						before move-in.
					</p>

					<div class="landing-actions">
						{heroActions.map((action) => (
							<a
								class:list={[
									"rental-button",
									action.tone === "secondary" ? "secondary" : "",
								]}
								href={action.href}
							>
								{action.label}
							</a>
						))}
					</div>
				</div>

				<aside class="rental-panel landing-side-card">
					<p class="rental-kicker">The missing step</p>
					<h2>Finding each other is only the start.</h2>
					<p>
						The expensive part begins after the match: what was agreed, what was already
						broken, what was furnished, and what can be deducted later.
					</p>
					<ul>
						{recordBullets.map((item) => <li>{item}</li>)}
					</ul>
				</aside>
			</div>
		</div>
	</section>

	<section class="rental-section">
		<div class="rental-shell">
			<div class="rental-section-header">
				<div>
					<p class="rental-kicker">Why this exists</p>
					<h2>Move-out should not become a memory contest.</h2>
				</div>
				<p class="rental-muted landing-section-copy">
					Painting, cleaning, appliance repairs, missing keys, wall marks, seepage, and
					deposit deductions should be linked to a record both sides saw earlier.
				</p>
			</div>

			<div class="rental-grid">
				{moatCards.map((card) => (
					<article class="rental-panel landing-card">
						<h3>{card.title}</h3>
						<p>{card.copy}</p>
					</article>
				))}
			</div>
		</div>
	</section>

	<section id="how-it-works" class="rental-section">
		<div class="rental-shell">
			<div class="rental-section-header">
				<div>
					<p class="rental-kicker">How it works</p>
					<h2>A cleaner rental trail from agreement to handover.</h2>
				</div>
				<p class="rental-muted landing-section-copy">
					HandoverNow gives owners and tenants a shared record before the agreement becomes
					a stack of loose messages and old templates.
				</p>
			</div>

			<div class="landing-steps">
				{processSteps.map((step) => (
					<article class="landing-step">
						<span>{step.number}</span>
						<h3>{step.title}</h3>
						<p>{step.copy}</p>
					</article>
				))}
			</div>
		</div>
	</section>

	<section class="rental-section">
		<div class="rental-shell">
			<div class="rental-section-header">
				<div>
					<p class="rental-kicker">Bangalore reality</p>
					<h2>Local costs should be discussed before they become deductions.</h2>
				</div>
				<p class="rental-muted landing-section-copy">
					Painting, deep cleaning, plumbing, appliance repair, and furniture damage can
					surprise tenants at move-out. HandoverNow helps owners record expectations early
					and helps tenants know what they accepted.
				</p>
			</div>

			<div class="rental-grid">
				{costCards.map((card) => (
					<article class="rental-panel landing-card">
						<h3>{card.title}</h3>
						<p>{card.copy}</p>
					</article>
				))}
			</div>
		</div>
	</section>

	<section class="rental-section">
		<div class="rental-shell landing-guides-grid">
			<div>
				<p class="rental-kicker">Guides and SEO</p>
				<h2>Write where real disputes begin.</h2>
				<p class="rental-muted">
					Practical guides for Bangalore owners and tenants on move-in checks, repair costs,
					deposit deductions, documents, and move-out settlement.
				</p>

				<div class="landing-topic-list">
					{guideTopics.map((topic) => <span>{topic}</span>)}
				</div>

				<div class="landing-actions">
					<a class="rental-button" href="/blog">Open guides</a>
					<a class="rental-button secondary" href="/posts">All articles</a>
				</div>
			</div>

			<div class="landing-blog-list">
				{
					latestPosts.length ? (
						latestPosts.map((post) => (
							<a class="rental-panel landing-blog-item" href={postHref(post)}>
								<small>{formatDate(post.data.publishedAt) || "Rental guide"}</small>
								<strong>{post.data.title}</strong>
								{post.data.excerpt && <span>{post.data.excerpt}</span>}
							</a>
						))
					) : (
						<div class="rental-panel landing-card">
							<p class="rental-kicker">No guides yet</p>
							<h3>Publish the first rental guide from EmDash admin.</h3>
							<p>
								Start with a move-in checklist, deposit dispute guide, or flat handover
								photo checklist.
							</p>
						</div>
					)
				}
			</div>
		</div>
	</section>

	<section class="rental-section">
		<div class="rental-shell">
			<div class="rental-panel landing-card">
				<p class="rental-kicker">Built first for real estate</p>
				<h2>Flats and villas first. Other rentals later.</h2>
				<p>
					The same record model can support any rental that needs condition, approval, and
					handover history.
				</p>
			</div>
		</div>
	</section>

	<section class="landing-final-cta">
		<div class="rental-shell">
			<div class="landing-final-panel">
				<div>
					<p class="rental-kicker">Next step</p>
					<h2>Agree before the handover. Don’t argue after move-out.</h2>
					<p>
						Start with one property, one tenant, one condition trail, and one clean rental
						file.
					</p>
				</div>

				<div class="landing-actions">
					<a class="rental-button secondary" href="/wf1/owner/assets/new">
						Create rental record
					</a>
					<a class="rental-button secondary" href="/blog">Read guides</a>
				</div>
			</div>
		</div>
	</section>

	<style>
		.landing-hero {
			padding: 54px 0 42px;
		}

		.landing-hero-panel {
			position: relative;
			overflow: hidden;
			border: 1px solid var(--r-border);
			border-radius: 28px;
			background:
				radial-gradient(circle at 96% 0%, rgba(234, 88, 12, 0.2), transparent 18rem),
				linear-gradient(135deg, rgba(255, 250, 243, 0.98), rgba(255, 237, 213, 0.82));
			box-shadow: var(--r-shadow);
			padding: clamp(28px, 5vw, 54px);
		}

		.landing-hero-grid {
			display: grid;
			grid-template-columns: minmax(0, 1.15fr) minmax(310px, 0.85fr);
			gap: 36px;
			align-items: center;
		}

		.landing-hero-copy h1 {
			max-width: 790px;
			font-size: clamp(3rem, 7.8vw, 6.2rem);
			line-height: 0.98;
			letter-spacing: -0.055em;
		}

		.landing-hero-copy > p:not(.rental-kicker) {
			max-width: 640px;
			color: var(--r-muted);
			font-size: clamp(1.08rem, 2vw, 1.24rem);
		}

		.landing-actions {
			display: flex;
			flex-wrap: wrap;
			gap: 12px;
			margin-top: 24px;
		}

		.landing-side-card h2 {
			margin-bottom: 12px;
			font-size: clamp(1.9rem, 3.8vw, 2.9rem);
			line-height: 1;
			letter-spacing: -0.045em;
		}

		.landing-side-card ul {
			margin: 18px 0 0;
			padding-left: 20px;
			color: var(--r-muted);
		}

		.landing-side-card li + li {
			margin-top: 9px;
		}

		.landing-section-copy {
			max-width: 620px;
		}

		.landing-card h2,
		.rental-section-header h2,
		.landing-guides-grid h2,
		.landing-final-panel h2 {
			font-size: clamp(2rem, 4.1vw, 3.6rem);
			line-height: 1.02;
			letter-spacing: -0.045em;
		}

		.landing-card p {
			color: var(--r-muted);
		}

		.landing-steps {
			display: grid;
			grid-template-columns: repeat(4, minmax(0, 1fr));
			gap: 16px;
		}

		.landing-step {
			border-top: 3px solid var(--r-brand);
			padding-top: 16px;
		}

		.landing-step span {
			color: var(--r-accent);
			font-weight: 950;
		}

		.landing-step p {
			color: var(--r-muted);
		}

		.landing-guides-grid {
			display: grid;
			grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
			gap: 24px;
			align-items: start;
		}

		.landing-topic-list {
			display: flex;
			flex-wrap: wrap;
			gap: 10px;
			margin-top: 18px;
		}

		.landing-topic-list span {
			border: 1px solid var(--r-border);
			border-radius: 999px;
			background: var(--r-panel-soft);
			color: var(--r-brand-strong);
			padding: 8px 12px;
			font-size: 0.9rem;
			font-weight: 850;
		}

		.landing-blog-list {
			display: grid;
			gap: 12px;
		}

		.landing-blog-item {
			display: grid;
			gap: 8px;
			padding: 18px;
		}

		.landing-blog-item small {
			color: var(--r-muted);
			font-weight: 800;
		}

		.landing-blog-item strong {
			font-size: 1.08rem;
		}

		.landing-blog-item span {
			color: var(--r-muted);
			line-height: 1.5;
		}

		.landing-final-cta {
			padding: 56px 0 72px;
		}

		.landing-final-panel {
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: 24px;
			border: 1px solid rgba(154, 52, 18, 0.26);
			border-radius: 28px;
			background:
				radial-gradient(circle at 90% 10%, rgba(255, 237, 213, 0.25), transparent 16rem),
				var(--r-brand-strong);
			box-shadow: var(--r-shadow);
			padding: clamp(26px, 5vw, 44px);
			color: #fffaf3;
		}

		.landing-final-panel .rental-kicker {
			color: #fed7aa;
		}

		.landing-final-panel p {
			max-width: 660px;
			color: rgba(255, 250, 243, 0.82);
		}

		@media (max-width: 900px) {
			.landing-hero-grid,
			.landing-steps,
			.landing-guides-grid {
				grid-template-columns: 1fr;
			}

			.landing-final-panel {
				align-items: flex-start;
				flex-direction: column;
			}
		}

		@media (max-width: 520px) {
			.landing-hero {
				padding-top: 28px;
			}

			.landing-hero-panel,
			.landing-final-panel {
				border-radius: 18px;
			}
		}
	</style>
</Wf1Base>
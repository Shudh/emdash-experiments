---
import "../styles/rental-responsive-hardening.css";
export const prerender = false;

interface Props {
	title?: string;
	description?: string;
}

const { title = "ALM Rentals", description = "Thin rental workflow over EmDash" } = Astro.props;
const fullTitle = title === "ALM Rentals" ? title : `${title} - ALM Rentals`;
const user = Astro.locals.user as { email?: string | null } | undefined;
const currentPath = Astro.url.pathname + Astro.url.search;
const safeCurrentPath =
	currentPath.startsWith("/") && !currentPath.startsWith("//") && !currentPath.startsWith("/_emdash")
		? currentPath
		: "/";
const loginHref = `/login?redirect=${encodeURIComponent(safeCurrentPath)}`;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<title>{fullTitle}</title>
		<style is:global>
			:root {
				color-scheme: light;
				--r-bg: #fbfaf7;
				--r-panel: #ffffff;
				--r-panel-soft: #f3f0e8;
				--r-text: #1b1b18;
				--r-muted: #63624f;
				--r-border: #ded9ca;
				--r-brand: #315f56;
				--r-brand-strong: #173f38;
				--r-accent: #b86f34;
				--r-success: #1f7a4d;
				--r-danger: #9f2f24;
				--r-radius: 8px;
				--r-shadow: 0 18px 50px rgba(41, 38, 27, 0.08);
				font-family:
					Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
					sans-serif;
			}

			* {
				box-sizing: border-box;
				min-width: 0;
			}

			html {
				overflow-x: hidden;
			}

			body {
				margin: 0;
				min-height: 100vh;
				background:
					linear-gradient(180deg, rgba(49, 95, 86, 0.08), transparent 34rem),
					var(--r-bg);
				color: var(--r-text);
				-webkit-font-smoothing: antialiased;
				overflow-x: hidden;
			}

			a {
				color: inherit;
				text-decoration: none;
			}

			button,
			input,
			select,
			textarea {
				font: inherit;
			}

			.rental-shell {
				max-width: 1180px;
				margin: 0 auto;
				padding: 0 20px;
			}

			.rental-section {
				padding: 56px 0;
			}

			.rental-section-header {
				display: flex;
				align-items: end;
				justify-content: space-between;
				gap: 24px;
				margin-bottom: 24px;
			}

			.rental-kicker {
				margin: 0 0 8px;
				color: var(--r-accent);
				font-size: 0.78rem;
				font-weight: 800;
				letter-spacing: 0.08em;
				text-transform: uppercase;
			}

			h1,
			h2,
			h3 {
				margin: 0;
				line-height: 1.08;
				letter-spacing: 0;
			}

			p {
				line-height: 1.65;
				overflow-wrap: anywhere;
			}

			.rental-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
				gap: 18px;
			}

			.rental-card,
			.rental-panel {
				border: 1px solid var(--r-border);
				border-radius: var(--r-radius);
				background: color-mix(in srgb, var(--r-panel) 94%, transparent);
				box-shadow: var(--r-shadow);
				overflow-wrap: anywhere;
			}

			.rental-panel {
				padding: 22px;
			}

			.rental-muted {
				color: var(--r-muted);
			}

			.rental-badges {
				display: flex;
				flex-wrap: wrap;
				gap: 8px;
			}

			.rental-badge {
				display: inline-flex;
				align-items: center;
				max-width: 100%;
				border: 1px solid var(--r-border);
				border-radius: 999px;
				padding: 5px 10px;
				background: var(--r-panel-soft);
				color: var(--r-muted);
				font-size: 0.82rem;
				font-weight: 650;
				overflow-wrap: anywhere;
				white-space: normal;
			}

			.rental-button {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				max-width: 100%;
				border: 1px solid transparent;
				border-radius: var(--r-radius);
				padding: 10px 14px;
				background: var(--r-brand);
				color: white;
				font-weight: 800;
				cursor: pointer;
				text-align: center;
				white-space: normal;
			}

			.rental-button:hover {
				background: var(--r-brand-strong);
			}

			.rental-button.secondary {
				border-color: var(--r-border);
				background: var(--r-panel);
				color: var(--r-text);
			}

			.rental-button.danger {
				background: var(--r-danger);
			}

			.rental-form-grid {
				display: grid;
				grid-template-columns: repeat(2, minmax(0, 1fr));
				gap: 14px;
			}

			.rental-field {
				display: grid;
				gap: 6px;
			}

			.rental-field.full {
				grid-column: 1 / -1;
			}

			.rental-field label {
				color: var(--r-muted);
				font-size: 0.84rem;
				font-weight: 750;
			}

			.rental-field input,
			.rental-field select,
			.rental-field textarea {
				width: 100%;
				border: 1px solid var(--r-border);
				border-radius: var(--r-radius);
				padding: 10px 12px;
				background: var(--r-panel);
				color: var(--r-text);
				min-width: 0;
			}

			.rental-field textarea {
				min-height: 96px;
				resize: vertical;
			}

			.rental-status {
				margin-top: 12px;
				color: var(--r-muted);
				font-size: 0.92rem;
			}

			.rental-status[data-state="error"] {
				color: var(--r-danger);
			}

			@media (max-width: 760px) {
				.rental-shell {
					padding-inline: 14px;
				}

				.rental-section {
					padding: 36px 0;
				}

				.rental-section-header {
					display: grid;
				}

				.rental-form-grid {
					grid-template-columns: 1fr;
				}
			}

			@media (max-width: 380px) {
				.rental-shell {
					padding-inline: 10px;
				}

				.rental-panel {
					padding: 16px;
				}
			}
		</style>
	</head>
	<body>
		<header class="rental-topbar">
	<div class="rental-shell rental-nav">
		<a href="/" class="rental-brand">ALM Rentals</a>
		<nav aria-label="Rental navigation">
			<a href="/marketplace">Marketplace</a>
			<a href="/owner">Owner</a>
			<a href="/owner/assets/new">List asset</a>
		</nav>

		{
			user?.email ? (
				<div class="rental-account">
					<span class="rental-user">{user.email}</span>
					<button class="rental-link-button" type="button" data-rental-logout>
	Logout
</button>
				</div>
			) : (
				<a class="rental-login-link" href={loginHref}>Login / register</a>
			)
		}
	</div>
</header>
		<main>
			<slot />
		</main>
		<footer class="rental-footer">
			<div class="rental-shell">
				<span>Backend-owned workflow. Astro-owned pages.</span>
			</div>
		</footer>
		<script is:inline>
	const logoutButton = document.querySelector("[data-rental-logout]");

	if (logoutButton) {
		logoutButton.addEventListener("click", async () => {
			logoutButton.setAttribute("disabled", "disabled");
			logoutButton.textContent = "Logging out...";

			try {
				const response = await fetch("/_emdash/api/auth/logout", {
					method: "POST",
					credentials: "same-origin",
					headers: {
						"X-EmDash-Request": "1",
					},
				});

				if (!response.ok) {
					const payload = await response.json().catch(() => ({}));
					const message =
						payload && payload.error && payload.error.message
							? payload.error.message
							: "Logout failed.";
					throw new Error(message);
				}

				window.location.assign("/login");
			} catch (error) {
				logoutButton.removeAttribute("disabled");
				logoutButton.textContent = "Logout";
				alert(error instanceof Error ? error.message : "Logout failed.");
			}
		});
	}
</script>
		<style>
			.rental-topbar {
				position: sticky;
				top: 0;
				z-index: 10;
				border-bottom: 1px solid var(--r-border);
				background: color-mix(in srgb, var(--r-bg) 92%, white);
				backdrop-filter: blur(16px);
			}

			.rental-nav {
				display: flex;
				align-items: center;
				gap: 22px;
				min-height: 64px;
			}

			.rental-brand {
				font-weight: 900;
				color: var(--r-brand-strong);
			}

			.rental-nav nav {
				display: flex;
				flex-wrap: wrap;
				gap: 14px;
				margin-left: auto;
			}

			.rental-nav nav a,
			.rental-user,
			 .rental-login-link,
            .rental-link-button {
				color: var(--r-muted);
				font-size: 0.92rem;
				font-weight: 650;
				overflow-wrap: anywhere;
			}

			.rental-footer {
				border-top: 1px solid var(--r-border);
				padding: 28px 0;
				color: var(--r-muted);
			}

			@media (max-width: 760px) {
				.rental-nav {
					align-items: flex-start;
					flex-direction: column;
					padding-top: 14px;
					padding-bottom: 14px;
				}

				.rental-nav nav {
					margin-left: 0;
				}
			}

			.rental-account {
	display: inline-flex;
	align-items: center;
	flex-wrap: wrap;
	gap: 10px;
}

.rental-logout-form {
	margin: 0;
}

.rental-login-link,
.rental-link-button {
	border: 1px solid var(--r-border);
	border-radius: var(--r-radius);
	padding: 8px 12px;
	background: var(--r-panel);
	color: var(--r-brand-strong);
	font-size: 0.92rem;
	font-weight: 800;
	text-decoration: none;
}

.rental-link-button {
	cursor: pointer;
}

.rental-link-button:hover,
.rental-login-link:hover {
	border-color: var(--r-brand);
}
		</style>
	</body>
</html>

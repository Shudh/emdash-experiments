---
interface Props {
	card: Record<string, unknown>;
	responses?: Array<Record<string, unknown>>;
}

const { card, responses = [] } = Astro.props;
const cardResponses = responses.filter((response) => response.card_id === card.id);

function parseJsonObject(value: string): Record<string, unknown> {
	try {
		const parsed = JSON.parse(value);
		return parsed && typeof parsed === "object" && !Array.isArray(parsed)
			? parsed as Record<string, unknown>
			: {};
	} catch {
		return {};
	}
}

function objectValue(value: unknown): Record<string, unknown> {
	if (value && typeof value === "object" && !Array.isArray(value)) {
		return value as Record<string, unknown>;
	}

	if (typeof value === "string") {
		return parseJsonObject(value);
	}

	return {};
}

function textValue(value: unknown, fallback = ""): string {
	if (typeof value === "string") return value;
	if (typeof value === "number" || typeof value === "boolean") return String(value);
	return fallback;
}

function humanizeSnake(value: unknown, fallback = "Workflow card"): string {
	const raw = textValue(value, fallback);
	return raw
		.split("_")
		.filter(Boolean)
		.map((part) => part.charAt(0).toUpperCase() + part.slice(1))
		.join(" ");
}

function cardSpec(): Record<string, unknown> {
	return objectValue(card.card_spec);
}

function displayTitle(): string {
	return textValue(cardSpec().displayTitle, humanizeSnake(card.card_type));
}

function displayState(): string {
	return textValue(cardSpec().displayState, textValue(card.card_state, "open"));
}

function answerText(response: Record<string, unknown>): string {
	const answer = objectValue(response.answer_value);
	const amount = answer.amount;
	const reference = answer.reference;
	const text = answer.text ?? answer.value ?? response.message;

	if (amount || reference) {
		return [
			amount ? `Amount: ${String(amount)}` : "",
			reference ? `Reference: ${String(reference)}` : "",
		].filter(Boolean).join(" · ");
	}

	return textValue(text, "Answered");
}
---

<article class="rental-panel workflow-card">
	<div class="workflow-card-head">
		<div>
			<p class="rental-kicker">{displayTitle()}</p>
			<p>{String(card.prompt ?? "Workflow request")}</p>
		</div>
		<div class="rental-badges">
			<span class="rental-badge">{String(card.card_type ?? "card")}</span>
			<span class="rental-badge">{displayState()}</span>
			<span class="rental-badge">by {String(card.created_by_role ?? "actor")}</span>
		</div>
	</div>

	{cardResponses.length ? (
		<div class="workflow-card-responses">
			{cardResponses.map((response) => (
				<p class="rental-muted">{answerText(response)}</p>
			))}
		</div>
	) : null}
</article>

<style>
	.workflow-card {
		display: grid;
		gap: 12px;
	}

	.workflow-card-head {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		gap: 12px;
		align-items: start;
	}

	.workflow-card-head p {
		margin: 0;
	}

	.workflow-card-responses {
		display: grid;
		gap: 6px;
		border-top: 1px solid var(--r-border);
		padding-top: 10px;
	}

	@media (max-width: 720px) {
		.workflow-card-head {
			grid-template-columns: 1fr;
		}
	}
</style>
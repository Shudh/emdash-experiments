---
interface Props {
	prefix: string;
	label?: string;
	required?: boolean;
	accept?: string;
}

const {
	prefix,
	label = "Upload image or PDF",
	required = false,
	accept = "image/*,application/pdf",
} = Astro.props;

const id = `media-${prefix.replace(/[^a-zA-Z0-9_-]/g, "-")}`;
---

<div class="rental-field full" data-wf1-media-upload>
	<label for={id}>{label}</label>
	<input id={id} type="file" accept={accept} data-media-file required={required} />
	<input type="hidden" name={`${prefix}.mediaId`} data-media-id />
	<input type="hidden" name={`${prefix}.storageKey`} data-media-storage-key />
	<input type="hidden" name={`${prefix}.mimeType`} data-media-mime-type />
	<input type="hidden" name={`${prefix}.filename`} data-media-filename />
	<input type="hidden" name={`${prefix}.url`} data-media-url />
	<p class="rental-muted" data-media-status></p>
</div>

<script>
	async function uploadWf1Media(file: File) {
		const body = new FormData();
		body.append("file", file);

		const response = await fetch("/_emdash/api/media", {
			method: "POST",
			credentials: "same-origin",
			headers: {
				"X-EmDash-Request": "1",
			},
			body,
		});

		const payload = await response.json().catch(() => ({}));

		if (!response.ok) {
			throw new Error(payload?.error?.message ?? "Media upload failed");
		}

		return payload?.data?.item ?? payload?.item;
	}

	for (const root of document.querySelectorAll<HTMLElement>("[data-wf1-media-upload]")) {
		const fileInput = root.querySelector<HTMLInputElement>("[data-media-file]");
		const status = root.querySelector<HTMLElement>("[data-media-status]");

		fileInput?.addEventListener("change", async () => {
			const file = fileInput.files?.[0];

			if (!file) {
				return;
			}

			if (status) {
				status.textContent = "Uploading...";
			}

			try {
				const item = await uploadWf1Media(file);

				const mediaIdInput = root.querySelector<HTMLInputElement>("[data-media-id]");
				const storageKeyInput = root.querySelector<HTMLInputElement>("[data-media-storage-key]");
				const mimeTypeInput = root.querySelector<HTMLInputElement>("[data-media-mime-type]");
				const filenameInput = root.querySelector<HTMLInputElement>("[data-media-filename]");
				const urlInput = root.querySelector<HTMLInputElement>("[data-media-url]");

				if (mediaIdInput) mediaIdInput.value = String(item.id ?? "");
				if (storageKeyInput) mediaIdInput && (storageKeyInput.value = String(item.storageKey ?? ""));
				if (mimeTypeInput) mimeTypeInput.value = String(item.mimeType ?? file.type);
				if (filenameInput) filenameInput.value = String(item.filename ?? file.name);
				if (urlInput) urlInput.value = String(item.url ?? "");

				if (status) {
					status.textContent = "Uploaded.";
				}
			} catch (error) {
				if (status) {
					status.textContent = error instanceof Error ? error.message : "Upload failed";
				}

				fileInput.value = "";
			}
		});
	}
</script>
---
import Wf1Base from "../../../components/wf1/Wf1Base.astro";
import Wf1ApplicationList from "../../../components/wf1/Wf1ApplicationList.astro";

export const prerender = false;

type JsonObject = Record<string, unknown>;

async function loadDashboard() {
	try {
		const response = await fetch(new URL("/api/wf1-rental/owner/dashboard", Astro.url), {
			headers: {
				Accept: "application/json",
				Cookie: Astro.request.headers.get("cookie") ?? "",
			},
		});
		const payload = (await response.json()) as {
			data?: { assets?: Array<JsonObject>; applicationRows?: Array<JsonObject> };
			error?: { message?: string };
		};
		return {
			ok: response.ok,
			assets: payload.data?.assets ?? [],
			applicationRows: payload.data?.applicationRows ?? [],
			error: payload.error?.message,
		};
	} catch (error) {
		return {
			ok: false,
			assets: [],
			applicationRows: [],
			error: error instanceof Error ? error.message : "Dashboard unavailable",
		};
	}
}

function rowsFrom(value: unknown): Array<JsonObject> {
	return Array.isArray(value)
		? value.filter((item): item is JsonObject => item !== null && typeof item === "object" && !Array.isArray(item))
		: [];
}

function numberTime(value: unknown): number {
	if (typeof value !== "string") return 0;

	const timestamp = Date.parse(value);
	return Number.isFinite(timestamp) ? timestamp : 0;
}

function latestStamp(row: JsonObject): number {
	return Math.max(
		numberTime(row.updated_at),
		numberTime(row.created_at),
		numberTime(row.published_at),
		numberTime(row.submitted_at),
	);
}

function latestApplicationStamp(application: JsonObject): number {
	const instance = application.instance && typeof application.instance === "object" && !Array.isArray(application.instance)
		? application.instance as JsonObject
		: {};
	const interest = application.interest && typeof application.interest === "object" && !Array.isArray(application.interest)
		? application.interest as JsonObject
		: application;

	return Math.max(latestStamp(application), latestStamp(instance), latestStamp(interest));
}

function latestFirst(rows: Array<JsonObject>): Array<JsonObject> {
	return [...rows].sort((left, right) => latestStamp(right) - latestStamp(left));
}

function latestApplicationsFirst(rows: Array<JsonObject>): Array<JsonObject> {
	return [...rows].sort((left, right) => latestApplicationStamp(right) - latestApplicationStamp(left));
}

const dashboard = await loadDashboard();
const assetRows = latestFirst(dashboard.assets).map((asset) => ({
	asset,
	applications: latestApplicationsFirst(rowsFrom(asset.applications)),
}));
---

<Wf1Base title="WF1 owner dashboard" description="WF1 owner dashboard">
	<section class="rental-section">
		<div class="rental-shell">
			<div class="rental-section-header">
				<div>
					<p class="rental-kicker">Owner</p>
					<h1>Dashboard</h1>
					<p class="rental-muted">Latest assets first. Each asset shows applications, Application State, and projection-derived actions.</p>
				</div>
				<a class="rental-button" href="/wf1/owner/assets/new">Create asset</a>
			</div>
			{!dashboard.ok ? (
				<div class="rental-panel">
					<h2>Login required</h2>
					<p class="rental-muted">{dashboard.error ?? "Owner dashboard requires a session."}</p>
				</div>
			) : (
				<div class="asset-sections">
					{assetRows.length ? assetRows.map((row) => (
						<section class="rental-panel asset-management">
							<div class="asset-head">
								<div>
									<p class="rental-kicker">{String(row.asset.asset_kind ?? "asset")}</p>
									<h2>{String(row.asset.title ?? "Untitled asset")}</h2>
									<p class="rental-muted">{String(row.asset.location_label ?? "Location pending")}</p>
								</div>
								<div class="rental-badges">
									<span class="rental-badge">Asset State: {String(row.asset.business_state ?? "draft")}</span>
									<span class="rental-badge">{String(row.asset.visibility_state ?? "private")}</span>
								</div>
							</div>
							<div class="asset-links">
								<a class="rental-button secondary" href={`/wf1/marketplace/assets/${row.asset.id}`}>View listing</a>
							</div>
							<h3>Applications</h3>
							<Wf1ApplicationList applications={row.applications} />
						</section>
					)) : (
						<div class="rental-panel"><p class="rental-muted">No owned assets yet.</p></div>
					)}
				</div>
			)}
		</div>
	</section>
</Wf1Base>

<style>
	.asset-sections,
	.asset-management {
		display: grid;
		gap: 16px;
	}

	.asset-head,
	.asset-links {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
	}
</style>
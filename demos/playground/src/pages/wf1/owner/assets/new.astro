---
import Wf1Base from "../../../../components/wf1/Wf1Base.astro";

export const prerender = false;
---

<Wf1Base title="Create WF1 asset" description="Create a WF1 rental asset">
	<section class="rental-section">
		<div class="rental-shell create-grid">
			<div>
				<p class="rental-kicker">Owner asset</p>
				<h1>Create draft asset</h1>
				<p class="rental-muted">Eva creates the property here. Workflow starts later when Rakesh expresses interest.</p>
			</div>
			<form class="rental-panel create-form" id="asset-form">
				<div class="rental-form-grid">
					<div class="rental-field"><label for="assetKind">Asset kind</label><select id="assetKind" name="assetKind"><option value="flat">Flat</option><option value="car">Car</option><option value="equipment">Equipment</option></select></div>
					<div class="rental-field"><label for="title">Title</label><input id="title" name="title" required /></div>
					<div class="rental-field"><label for="locationLabel">Location</label><input id="locationLabel" name="locationLabel" value="Bangalore" /></div>
					<div class="rental-field"><label for="publicPrice">Price</label><input id="publicPrice" name="publicPrice" type="number" value="60000" required /></div>
					<div class="rental-field"><label for="minimumMonths">Minimum months</label><input id="minimumMonths" name="minimumMonths" type="number" value="11" /></div>
					<div class="rental-field"><label for="bedrooms">Bedrooms</label><input id="bedrooms" name="bedrooms" type="number" value="2" /></div>
					<div class="rental-field"><label for="furnishing">Furnishing</label><input id="furnishing" name="furnishing" value="semi_furnished" /></div>
					<div class="rental-field"><label for="walls">Physical condition</label><input id="walls" name="walls" value="freshly_painted" /></div>
					<div class="rental-field full"><label for="depositPolicy">Owner rental conditions</label><textarea id="depositPolicy" name="depositPolicy">Two months deposit covers chargeable damage.</textarea></div>
					<div class="rental-field"><label><input name="publish" type="checkbox" /> Publish to marketplace</label></div>
				</div>
				<section class="form-section" aria-labelledby="inventory-heading">
					<div class="section-head">
						<div><p class="rental-kicker">Inventory</p><h2 id="inventory-heading">Asset config items</h2></div>
						<div class="section-actions">
							<button class="rental-button secondary" type="button" id="add-starter-inventory">Add starter flat inventory</button>
							<button class="rental-button secondary" type="button" id="add-inventory-row">Add row</button>
						</div>
					</div>
					<div class="inventory-editor" id="inventory-editor"></div>
				</section>
				<button class="rental-button" type="submit">Create asset</button>
				<p class="rental-status" id="asset-status"></p>
			</form>
		</div>
	</section>
</Wf1Base>

<script>
	const form = document.querySelector<HTMLFormElement>("#asset-form");
	const status = document.querySelector<HTMLElement>("#asset-status");
	const inventoryEditor = document.querySelector<HTMLElement>("#inventory-editor");
	const addInventoryRowButton = document.querySelector<HTMLButtonElement>("#add-inventory-row");
	const addStarterInventoryButton = document.querySelector<HTMLButtonElement>("#add-starter-inventory");

	type InventoryItem = { itemLabel: string; itemKind: string; itemGroup: string; quantity: string; ownerDeclaredState: string; conditionDetails: string; };

	const starterInventory: InventoryItem[] = [
		{ itemLabel: "Geyser", itemKind: "appliance", itemGroup: "bathroom", quantity: "1", ownerDeclaredState: "working", conditionDetails: "Heats water, no leakage." },
		{ itemLabel: "Fridge", itemKind: "appliance", itemGroup: "kitchen", quantity: "1", ownerDeclaredState: "working", conditionDetails: "Silent, cooling is ok." },
		{ itemLabel: "Washing machine", itemKind: "appliance", itemGroup: "utility", quantity: "1", ownerDeclaredState: "working", conditionDetails: "" },
		{ itemLabel: "RO purifier", itemKind: "appliance", itemGroup: "kitchen", quantity: "1", ownerDeclaredState: "working", conditionDetails: "" },
		{ itemLabel: "Fans", itemKind: "fixture", itemGroup: "all rooms", quantity: "4", ownerDeclaredState: "working", conditionDetails: "" },
		{ itemLabel: "Lights", itemKind: "fixture", itemGroup: "all rooms", quantity: "8", ownerDeclaredState: "working", conditionDetails: "" },
		{ itemLabel: "Curtains", itemKind: "furnishing", itemGroup: "bedrooms", quantity: "4", ownerDeclaredState: "good", conditionDetails: "" },
		{ itemLabel: "Wardrobe", itemKind: "furniture", itemGroup: "bedroom", quantity: "2", ownerDeclaredState: "good", conditionDetails: "" },
		{ itemLabel: "Sofa", itemKind: "furniture", itemGroup: "living room", quantity: "1", ownerDeclaredState: "worn", conditionDetails: "Minor fabric marks." },
		{ itemLabel: "Dining table", itemKind: "furniture", itemGroup: "dining", quantity: "1", ownerDeclaredState: "good", conditionDetails: "" },
		{ itemLabel: "Bed", itemKind: "furniture", itemGroup: "bedroom", quantity: "2", ownerDeclaredState: "good", conditionDetails: "" },
		{ itemLabel: "Mattress", itemKind: "furnishing", itemGroup: "bedroom", quantity: "2", ownerDeclaredState: "good", conditionDetails: "" },
		{ itemLabel: "Keys", itemKind: "access", itemGroup: "main door", quantity: "2", ownerDeclaredState: "handed over", conditionDetails: "Two physical keys." },
		{ itemLabel: "Remote controls", itemKind: "accessory", itemGroup: "living room", quantity: "2", ownerDeclaredState: "working", conditionDetails: "" },
	];

	function htmlEscape(value = "") { return value.replaceAll('"', "&quot;"); }
	function addInventoryRow(item: Partial<InventoryItem> = {}) {
		if (!inventoryEditor) return;
		const row = document.createElement("article");
		row.className = "inventory-row";
		row.innerHTML = `<label>Item label<input name="itemLabel" value="${htmlEscape(item.itemLabel)}" /></label><label>Item kind<input name="itemKind" value="${htmlEscape(item.itemKind ?? "fixture")}" /></label><label>Room / group<input name="itemGroup" value="${htmlEscape(item.itemGroup)}" /></label><label>Quantity<input name="quantity" type="number" value="${htmlEscape(item.quantity ?? "1")}" /></label><label>Owner declared state<input name="ownerDeclaredState" value="${htmlEscape(item.ownerDeclaredState ?? "working")}" /></label><label>Condition details<textarea name="conditionDetails">${item.conditionDetails ?? ""}</textarea></label><button class="rental-button secondary remove-row" type="button">Delete row</button>`;
		row.querySelector(".remove-row")?.addEventListener("click", () => row.remove());
		inventoryEditor.append(row);
	}
	function collectInventoryRows() {
		return Array.from(document.querySelectorAll<HTMLElement>(".inventory-row"), (row) => {
			const scoped = (name: string) => (row.querySelector<HTMLInputElement | HTMLTextAreaElement>(`[name="${name}"]`)?.value ?? "").trim();
			return { itemKind: scoped("itemKind") || "fixture", itemGroup: scoped("itemGroup"), itemLabel: scoped("itemLabel"), ownerDeclaredState: scoped("ownerDeclaredState") || "working", itemSpec: { quantity: Number(scoped("quantity") || "1"), room: scoped("itemGroup"), conditionDetails: scoped("conditionDetails") } };
		}).filter((item) => item.itemLabel);
	}
	async function postJson(url: string, body: Record<string, unknown>) {
		const response = await fetch(url, { method: "POST", headers: { "Content-Type": "application/json", "X-EmDash-Request": "1" }, body: JSON.stringify(body) });
		const payload = await response.json().catch(() => ({}));
		if (!response.ok) throw new Error(payload?.error?.message ?? `${url} failed`);
		return payload.data;
	}
	form?.addEventListener("submit", async (event) => {
		event.preventDefault();
		const data = new FormData(form);
		if (status) status.textContent = "Creating asset...";
		try {
			const ownerConditionsSpec = { depositPolicy: data.get("depositPolicy"), documentsRequired: [] };
			const addData = await postJson("/api/wf1-rental/owner/assets/add", { assetKind: data.get("assetKind"), title: data.get("title"), locationLabel: data.get("locationLabel"), publicPrice: Number(data.get("publicPrice")), currency: "INR", ownerConditionsSpec });
			const assetId = addData.asset.id;
			await postJson(`/api/wf1-rental/owner/assets/${assetId}/config`, { publicPrice: Number(data.get("publicPrice")), minimumMonths: Number(data.get("minimumMonths")), configSpec: { bedrooms: Number(data.get("bedrooms")), furnishing: data.get("furnishing") }, conditionSpec: { walls: data.get("walls") }, ownerConditionsSpec, items: collectInventoryRows() });
			if (data.get("publish")) await postJson(`/api/wf1-rental/owner/assets/${assetId}/publish-to-marketplace`, {});
			location.href = `/wf1/marketplace/assets/${assetId}`;
		} catch (error) {
			if (status) status.textContent = error instanceof Error ? error.message : "Create asset failed";
		}
	});
	addInventoryRow({ itemLabel: "Geyser", itemKind: "appliance", itemGroup: "bathroom", quantity: "1", ownerDeclaredState: "working", conditionDetails: "Heats water, no leakage." });
	addInventoryRowButton?.addEventListener("click", () => addInventoryRow());
	addStarterInventoryButton?.addEventListener("click", () => { inventoryEditor?.replaceChildren(); starterInventory.forEach(addInventoryRow); });
	(window as unknown as { __rentalFormsReady?: boolean }).__rentalFormsReady = true;
</script>

<style>
	.create-grid,.create-form,.inventory-editor{display:grid;gap:16px}.create-grid{grid-template-columns:minmax(260px,.65fr) minmax(0,1.35fr);gap:28px;align-items:start}.form-section{display:grid;gap:14px;border-top:1px solid var(--r-border);padding-top:18px}.section-head,.section-actions{display:flex;flex-wrap:wrap;gap:12px}.section-head{align-items:end;justify-content:space-between}.inventory-row{display:grid;grid-template-columns:repeat(4,minmax(130px,1fr));gap:10px;border:1px solid var(--r-border);border-radius:var(--r-radius);padding:12px;background:var(--r-bg)}.inventory-row label{display:grid;gap:6px;color:var(--r-muted);font-size:.84rem;font-weight:750}.inventory-row input,.inventory-row textarea{width:100%;border:1px solid var(--r-border);border-radius:var(--r-radius);padding:9px 10px;background:var(--r-panel);color:var(--r-text)}@media (max-width:900px){.create-grid{grid-template-columns:1fr}.inventory-row{grid-template-columns:repeat(2,minmax(0,1fr))}}@media (max-width:560px){.inventory-row{grid-template-columns:1fr}}
</style>

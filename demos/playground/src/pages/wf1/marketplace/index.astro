---
import Wf1Base from "../../../components/wf1/Wf1Base.astro";

export const prerender = false;

async function loadAssets() {
	try {
		const response = await fetch(new URL("/api/wf1-rental/marketplace/assets", Astro.url), {
			headers: {
				Accept: "application/json",
				Cookie: Astro.request.headers.get("cookie") ?? "",
			},
		});
		const payload = await response.json() as { data?: { items?: Array<Record<string, unknown>> } };
		return response.ok ? payload.data?.items ?? [] : [];
	} catch {
		return [];
	}
}

const assets = await loadAssets();
---

<Wf1Base title="WF1 marketplace" description="WF1 workflow marketplace">
	<section class="rental-section">
		<div class="rental-shell">
			<div class="rental-section-header">
				<div>
					<p class="rental-kicker">Marketplace</p>
					<h1>Published assets</h1>
					<p class="rental-muted">Applicants select a workflow definition when they express interest.</p>
				</div>
				<a class="rental-button secondary" href="/wf1/owner/assets/new">List asset</a>
			</div>
			{assets.length ? (
				<div class="rental-grid" data-marketplace-grid>
					{assets.map((asset) => (
						<article class="rental-panel asset-card">
							<p class="rental-kicker">{String(asset.asset_kind ?? "asset")}</p>
							<h2><a href={`/wf1/marketplace/assets/${asset.id}`}>{String(asset.title ?? "Untitled asset")}</a></h2>
							<p class="rental-muted">{String(asset.location_label ?? "Location pending")}</p>
							<div class="rental-badges">
								<span class="rental-badge">Asset State: {String(asset.business_state ?? "listed")}</span>
								<span class="rental-badge">{String(asset.visibility_state ?? "marketplace")}</span>
							</div>
						</article>
					))}
				</div>
			) : (
				<div class="rental-panel">
					<p class="rental-muted">No marketplace assets are currently listed.</p>
				</div>
			)}
		</div>
	</section>
</Wf1Base>

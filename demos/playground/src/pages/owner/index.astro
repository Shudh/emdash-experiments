---
import ActionForm from "../../components/rental/ActionForm.astro";
import AssetCard from "../../components/rental/AssetCard.astro";
import RentalBase from "../../layouts/RentalBase.astro";

export const prerender = false;

async function loadDashboard() {
	try {
		const response = await fetch(new URL("/api/rental/owner/dashboard", Astro.url), {
			headers: {
				Accept: "application/json",
				Cookie: Astro.request.headers.get("cookie") ?? "",
			},
		});
		const payload = await response.json() as {
			data?: {
				assets?: Array<Record<string, unknown>>;
				inbox?: Array<Record<string, unknown>>;
			};
			error?: { message?: string };
		};
		return {
			ok: response.ok,
			assets: payload.data?.assets ?? [],
			inbox: payload.data?.inbox ?? [],
			error: payload.error?.message,
		};
	} catch (error) {
		return {
			ok: false,
			assets: [],
			inbox: [],
			error: error instanceof Error ? error.message : "Dashboard unavailable",
		};
	}
}

const dashboard = await loadDashboard();
const pendingInboxCount = dashboard.inbox.filter((interest) => String(interest.interest_state ?? "") === "submitted").length;

function hasAction(asset: Record<string, unknown>, actionId: string) {
	const actions = Array.isArray(asset.availableActions) ? asset.availableActions : [];
	return actions.some(
		(action) =>
			!!action &&
			typeof action === "object" &&
			"id" in action &&
			(action as { id?: unknown }).id === actionId,
	);
}
---

<RentalBase title="Owner dashboard" description="Owner rental dashboard">
	<section class="rental-section">
		<div class="rental-shell">
			<div class="rental-section-header">
				<div>
					<p class="rental-kicker">Owner</p>
					<h1>Dashboard</h1>
					<p class="rental-muted">Owned assets, submitted interests, negotiation tasks, and handover work.</p>
				</div>
				<a class="rental-button" href="/owner/assets/new">Create asset</a>
			</div>
			{
				!dashboard.ok ? (
					<div class="rental-panel">
						<h2>Login required</h2>
						<p class="rental-muted">{dashboard.error ?? "Owner dashboard requires a session."}</p>
					</div>
				) : (
					<div class="dashboard-grid">
						<section class="rental-panel inbox-panel">
							<div class="inbox-head">
								<h2>Submitted interest inbox</h2>
								<span class="rental-badge">{pendingInboxCount} pending interests</span>
							</div>
							<div class="inbox-list">
								{dashboard.inbox.length ? (
									dashboard.inbox.map((interest) => (
										<a href={`/interests/${interest.id}`} class="inbox-item">
											<strong>{String(interest.asset_title ?? "Asset")}</strong>
											<span>{String(interest.name ?? interest.official_email ?? "Interested renter")}</span>
											<span>Official email: {String(interest.official_email ?? "pending")}</span>
											<span>Employer: {String(interest.employer_name ?? "pending")}</span>
											<span>Offer: {String(interest.offered_price ?? "pending")}</span>
											<div class="rental-badges">
												<span class="rental-badge">{String(interest.interest_state ?? "submitted")}</span>
												<span class="rental-badge">{String(interest.pending_request_count ?? 0)} pending requests</span>
											</div>
											<span class="rental-button secondary">View details</span>
										</a>
									))
								) : (
									<p class="rental-muted">No submitted interests yet.</p>
								)}
							</div>
						</section>
						<section>
							<h2>Owned assets</h2>
							<div class="rental-grid">
								{dashboard.assets.length ? (
									dashboard.assets.map((asset) => (
										<div class="asset-management">
											<AssetCard asset={{ ...asset, viewer: { relationship: "owner" } }} href={`/marketplace/assets/${asset.id}`} />
											<div class="rental-panel asset-state-actions">
												<div class="rental-badges">
													<span class="rental-badge">status: {String(asset.status ?? "draft")}</span>
													<span class="rental-badge">business_state: {String(asset.business_state ?? "draft")}</span>
													<span class="rental-badge">visibility_state: {String(asset.visibility_state ?? "private")}</span>
												</div>
												{
													asset.status === "published" && asset.business_state === "listed" && asset.visibility_state === "marketplace" ? (
														<button class="rental-button secondary" disabled>Already published</button>
													) : hasAction(asset, "handover.start_move_in") || (asset.active_agreement_id && asset.business_state === "booked") ? (
														<ActionForm
															title="Start move-in handover"
															description="Open a move-in handover for the accepted agreement."
															action={`/api/rental/handover/${asset.id}/start`}
															submitLabel="Start move-in"
															successRedirect="/handover/:id"
														>
															<input type="hidden" name="handoverKind" value="move_in" />
														</ActionForm>
													) : hasAction(asset, "handover.start_move_out") || (asset.active_agreement_id && asset.business_state === "rented") ? (
														<ActionForm
															title="Start move-out handover"
															description="Open the return handover for this active rental."
															action={`/api/rental/handover/${asset.id}/start`}
															submitLabel="Start move-out"
															successRedirect="/handover/:id"
														>
															<input type="hidden" name="handoverKind" value="move_out" />
														</ActionForm>
													) : asset.business_state === "maintenance" ? (
														<div class="state-action-copy">
															<p class="rental-muted">Maintenance/private. Relist and return-to-draft are backend-supported follow-up actions for this UI.</p>
															<span class="rental-badge">Delete not implemented</span>
														</div>
													) : (
														<p class="rental-muted">State actions appear when the backend allows a transition. Delete is not implemented.</p>
													)
												}
											</div>
										</div>
									))
								) : (
									<div class="rental-panel"><p class="rental-muted">No owned assets yet.</p></div>
								)}
							</div>
						</section>
						<section class="rental-panel">
							<h2>Active negotiation tasks</h2>
							<p class="rental-muted">Open each inbox item to ask questions, request documents, counter, reject, or accept final terms.</p>
						</section>
						<section class="rental-panel">
							<h2>Handover tasks</h2>
							<p class="rental-muted">Handover sessions appear after final terms create restricted asset access.</p>
						</section>
					</div>
				)
			}
		</div>
	</section>
</RentalBase>

<style>
	.dashboard-grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 18px;
		align-items: start;
	}

	.dashboard-grid section {
		display: grid;
		gap: 16px;
	}

	.inbox-list {
		display: grid;
		gap: 10px;
	}

	.inbox-head {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
	}

	.inbox-item {
		display: grid;
		gap: 5px;
		border: 1px solid var(--r-border);
		border-radius: var(--r-radius);
		padding: 14px;
		background: var(--r-bg);
	}

	.inbox-item span:not(.rental-badge) {
		color: var(--r-muted);
	}

	.inbox-panel {
		border-width: 2px;
	}

	.asset-management,
	.asset-state-actions,
	.state-action-copy {
		display: grid;
		gap: 12px;
	}

	.asset-state-actions .rental-action-form {
		padding: 0;
		border: 0;
		background: transparent;
	}
</style>

---
import Wf1Base from "../components/wf1/Wf1Base.astro";

export const prerender = false;

type JsonObject = Record<string, unknown>;

const user = Astro.locals.user as { email?: string | null } | undefined;
const cookie = Astro.request.headers.get("cookie") ?? "";
const loginHref = `/login?redirect=${encodeURIComponent("/wf1")}`;

async function wf1Get(path: string): Promise<JsonObject | null> {
	try {
		const response = await fetch(new URL(path, Astro.url), {
			headers: {
				Accept: "application/json",
				...(cookie ? { Cookie: cookie } : {}),
			},
		});

		const payload = (await response.json()) as { data?: JsonObject };

		return response.ok ? payload.data ?? null : null;
	} catch {
		return null;
	}
}

function rowsFrom(value: unknown): Array<JsonObject> {
	return Array.isArray(value)
		? value.filter((item): item is JsonObject => item !== null && typeof item === "object" && !Array.isArray(item))
		: [];
}

function viewerFor(asset: JsonObject): JsonObject {
	return asset.viewer && typeof asset.viewer === "object" && !Array.isArray(asset.viewer)
		? asset.viewer as JsonObject
		: {};
}

function numberTime(value: unknown): number {
	if (typeof value !== "string") return 0;

	const timestamp = Date.parse(value);
	return Number.isFinite(timestamp) ? timestamp : 0;
}

function latestStamp(row: JsonObject): number {
	return Math.max(
		numberTime(row.updated_at),
		numberTime(row.created_at),
		numberTime(row.published_at),
		numberTime(row.submitted_at),
	);
}

function latestFirst(rows: Array<JsonObject>): Array<JsonObject> {
	return [...rows].sort((left, right) => latestStamp(right) - latestStamp(left));
}

function assetHref(asset: JsonObject): string {
	return `/wf1/marketplace/assets/${String(asset.id ?? "")}`;
}

function applicationHref(asset: JsonObject): string {
	const viewer = viewerFor(asset);
	const workflowInstanceId = typeof viewer.workflowInstanceId === "string" ? viewer.workflowInstanceId : "";

	return workflowInstanceId ? `/wf1/workspaces/${workflowInstanceId}` : assetHref(asset);
}

function applicationAssetsFromMarketplace(assets: Array<JsonObject>): Array<JsonObject> {
	return latestFirst(
		assets.filter((asset) => {
			const viewer = viewerFor(asset);
			return String(viewer.relationship ?? "") === "interested_applicant";
		}),
	);
}

const [ownerDashboard, marketplaceData] = await Promise.all([
	user ? wf1Get("/api/wf1-rental/owner/dashboard") : Promise.resolve(null),
	wf1Get("/api/wf1-rental/marketplace/assets"),
]);

const marketplaceAssets = latestFirst(rowsFrom(marketplaceData?.items));
const ownedAssets = latestFirst(rowsFrom(ownerDashboard?.assets));
const applicationRows = latestFirst(rowsFrom(ownerDashboard?.applicationRows));
const myApplications = applicationAssetsFromMarketplace(marketplaceAssets);
const latestApplicationHref = myApplications[0] ? applicationHref(myApplications[0]) : "/wf1/marketplace";
---

<Wf1Base title="WF1 rentals" description="WF1 asset lifecycle landing page">
	<section class="landing-hero">
		<div class="rental-shell hero-grid">
			<div class="hero-copy">
				<p class="rental-kicker">Asset lifecycle management</p>
				<h1>Clean rentals.</h1>
				<p class="rental-muted">WF1 routes for assets, applications, task cards, gates, and evidence.</p>

				<div class="hero-actions">
					<a class="rental-button" href="/wf1/marketplace">Marketplace</a>
					<a class="rental-button secondary" href="/wf1/owner">Owner</a>
					<a class="rental-button secondary" href="/wf1/owner/assets/new">List asset</a>
					{
						user?.email ? (
							<a class="rental-button secondary" href={latestApplicationHref}>My applications</a>
						) : (
							<a class="rental-button secondary" href={loginHref}>Login / register</a>
						)
					}
				</div>
			</div>

			<div class="hero-product rental-panel launchpad">
				<a class="launch-card" href="/wf1/marketplace">
					<span>Marketplace</span>
					<strong>{marketplaceAssets.length}</strong>
				</a>
				<a class="launch-card" href="/wf1/owner">
					<span>Owner assets</span>
					<strong>{ownedAssets.length}</strong>
				</a>
				<a class="launch-card" href={latestApplicationHref}>
					<span>My applications</span>
					<strong>{myApplications.length}</strong>
				</a>
				<a class="launch-card" href="/wf1/owner">
					<span>Owner inbox</span>
					<strong>{applicationRows.length}</strong>
				</a>
			</div>
		</div>
	</section>

	{
		user?.email && myApplications.length ? (
			<section id="my-applications" class="rental-section compact-section">
				<div class="rental-shell">
					<div class="rental-section-header">
						<div>
							<p class="rental-kicker">My applications</p>
							<h2>Latest first.</h2>
						</div>
						<a class="rental-button secondary" href="/wf1/marketplace">Browse marketplace</a>
					</div>

					<div class="application-grid">
						{myApplications.map((asset) => (
							<article class="rental-panel application-card">
								<p class="rental-kicker">{String(asset.asset_kind ?? "asset")}</p>
								<h3>
									<a href={applicationHref(asset)}>{String(asset.title ?? "Untitled asset")}</a>
								</h3>
								<p class="rental-muted">{String(asset.location_label ?? "Location pending")}</p>
								<div class="rental-badges">
									<span class="rental-badge">Asset State: {String(asset.business_state ?? "listed")}</span>
									<span class="rental-badge">{String(asset.visibility_state ?? "marketplace")}</span>
								</div>
								<a class="rental-button" href={applicationHref(asset)}>Open application workspace</a>
							</article>
						))}
					</div>
				</div>
			</section>
		) : null
	}

	<section class="rental-section subtle">
		<div class="rental-shell wf1-explain-grid">
			<article class="rental-panel">
				<p class="rental-kicker">For owners</p>
				<h2>List assets.</h2>
				<p class="rental-muted">Create a flat, publish it to WF1 marketplace, then review applications from the owner dashboard.</p>
				<a class="rental-button secondary" href="/wf1/owner/assets/new">Create asset</a>
			</article>

			<article class="rental-panel">
				<p class="rental-kicker">For tenants</p>
				<h2>Track applications.</h2>
				<p class="rental-muted">Applied flats appear under My applications, latest first, with one-click workspace access.</p>
				<a class="rental-button secondary" href="/wf1/marketplace">Open marketplace</a>
			</article>

			<article class="rental-panel">
				<p class="rental-kicker">For managers</p>
				<h2>See states.</h2>
				<p class="rental-muted">Every workspace separates Asset State from Application State. Actions move state; cards collect work.</p>
				<a class="rental-button secondary" href="/wf1">WF1 home</a>
			</article>
		</div>
	</section>
</Wf1Base>

<style>
	.landing-hero {
		padding: 42px 0 30px;
	}

	.hero-grid {
		display: grid;
		grid-template-columns: minmax(0, 1.1fr) minmax(280px, 0.9fr);
		gap: 24px;
		align-items: center;
	}

	.hero-copy h1 {
		max-width: 640px;
		font-size: clamp(2.2rem, 6vw, 4.2rem);
	}

	.hero-copy p:not(.rental-kicker) {
		max-width: 620px;
		font-size: 1.05rem;
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
		margin-top: 22px;
	}

	.hero-product {
		display: grid;
		gap: 12px;
		background:
			linear-gradient(135deg, rgba(234, 88, 12, 0.12), rgba(251, 146, 60, 0.10)),
			var(--r-panel);
	}

	.launchpad {
		grid-template-columns: repeat(2, minmax(0, 1fr));
	}

	.launch-card {
		display: grid;
		gap: 8px;
		border: 1px solid var(--r-border);
		border-radius: var(--r-radius);
		padding: 14px;
		background: var(--r-bg);
		text-decoration: none;
	}

	.launch-card span {
		color: var(--r-muted);
		font-weight: 750;
	}

	.launch-card strong {
		color: var(--r-brand-strong);
		font-size: 1.8rem;
	}

	.compact-section {
		padding-top: 28px;
	}

	.application-grid,
	.wf1-explain-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
		gap: 16px;
	}

	.application-card {
		display: grid;
		gap: 12px;
		align-content: start;
	}

	.application-card h3 a {
		color: inherit;
		text-decoration: none;
	}

	.application-card h3 a:hover {
		text-decoration: underline;
	}

	.subtle {
		background: rgba(255, 237, 213, 0.42);
	}

	@media (max-width: 900px) {
		.hero-grid,
		.launchpad {
			grid-template-columns: 1fr;
		}
	}
</style>
---
import ActionForm from "../../components/rental/ActionForm.astro";
import SpecTable from "../../components/rental/SpecTable.astro";
import WorkflowCard from "../../components/workflow-rental/WorkflowCard.astro";
import WorkflowRentalBase from "../../components/workflow-rental/WorkflowRentalBase.astro";
import WorkflowTimeline from "../../components/workflow-rental/WorkflowTimeline.astro";

export const prerender = false;

const interestId = Astro.params.interestId;

async function loadWorkspace() {
	if (!interestId) return null;

	try {
		const response = await fetch(new URL(`/api/wf-rental/interests/${interestId}/workspace`, Astro.url), {
			headers: {
				Accept: "application/json",
				Cookie: Astro.request.headers.get("cookie") ?? "",
			},
		});

		const payload = await response.json() as { data?: Record<string, unknown> };
		return response.ok ? payload.data ?? null : null;
	} catch {
		return null;
	}
}

function objectValue(value: unknown): Record<string, unknown> {
	return value && typeof value === "object" && !Array.isArray(value)
		? value as Record<string, unknown>
		: {};
}

function arrayValue(value: unknown): Array<Record<string, unknown>> {
	return Array.isArray(value) ? value.filter((item) => item && typeof item === "object") as Array<Record<string, unknown>> : [];
}

function textValue(value: unknown, fallback = ""): string {
	if (typeof value === "string") return value;
	if (typeof value === "number" || typeof value === "boolean") return String(value);
	return fallback;
}

const workspace = await loadWorkspace();
const asset = objectValue(workspace?.asset);
const interest = objectValue(workspace?.interest);
const instance = objectValue(workspace?.instance);
const projection = objectValue(workspace?.projection);
const stage = objectValue(projection.stage);
const cards = arrayValue(workspace?.cards);
const responses = arrayValue(workspace?.responses);
const events = arrayValue(workspace?.events);
const statusPills = Array.isArray(projection.statusPills) ? projection.statusPills.map(String) : [];
const availableCardTypes = arrayValue(projection.availableCardTypes);
const availableActions = arrayValue(projection.availableActions);
const pendingCardsForViewer = arrayValue(projection.pendingCardsForViewer);
const unresolvedRequiredCards = arrayValue(projection.unresolvedRequiredCards);
const viewerRole = textValue(workspace?.viewerRole, "unknown");
const workflowInstanceId = textValue(instance.id);
const stageLabel = textValue(stage.label, textValue(instance.workflow_state, "Workflow"));
const stageMessage = textValue(stage.message, "Workflow state is ready.");
const waitingMessage = textValue(projection.waitingMessage);
const primaryNextStep = textValue(projection.primaryNextStep);

function answerSchemaKind(card: Record<string, unknown>): string {
	return textValue(objectValue(card.answer_schema).kind, "free_text");
}

function cardTypeUi(cardType: Record<string, unknown>): Record<string, unknown> {
	return objectValue(cardType.ui);
}

function cardTypeDefaultPrompt(cardType: Record<string, unknown>): string {
	const ui = cardTypeUi(cardType);
	return textValue(ui.defaultPrompt, textValue(cardType.label, "Workflow task"));
}

function cardTypePromptLabel(cardType: Record<string, unknown>): string {
	const ui = cardTypeUi(cardType);
	return textValue(ui.promptLabel, "Task message");
}

function cardTypeSubmitLabel(cardType: Record<string, unknown>): string {
	const ui = cardTypeUi(cardType);
	return textValue(ui.submitLabel, textValue(cardType.label, "Create card"));
}

function cardTypeHelpText(cardType: Record<string, unknown>): string {
	const ui = cardTypeUi(cardType);
	return textValue(ui.helpText);
}
---

<WorkflowRentalBase title="Workflow negotiation" description="Shared workflow rental negotiation">
	<section class="rental-section">
		<div class="rental-shell negotiation-grid">
			{
				workspace ? (
					<>
						<aside class="rental-panel">
							<p class="rental-kicker">Asset summary</p>
							<h1>{textValue(asset.title, "Asset")}</h1>
							<p class="rental-muted">{textValue(asset.location_label, "Location pending")}</p>

							<div class="rental-badges">
								{statusPills.length ? (
									statusPills.map((pill) => <span class="rental-badge">{pill}</span>)
								) : (
									<>
										<span class="rental-badge">{textValue(asset.business_state, "state")}</span>
										<span class="rental-badge">{textValue(asset.visibility_state, "visibility")}</span>
										<span class="rental-badge">{textValue(instance.workflow_state, textValue(interest.interest_state, "interest"))}</span>
										<span class="rental-badge">role: {viewerRole}</span>
									</>
								)}
							</div>

							<div class={`workflow-stage stage-${textValue(stage.tone, "neutral")}`}>
								<p class="rental-kicker">Current stage</p>
								<h2>{stageLabel}</h2>
								<p>{stageMessage}</p>
								{primaryNextStep ? <p class="rental-muted">Next: {primaryNextStep}</p> : null}
							</div>

							<SpecTable title="Renter details" spec={{
								name: interest.name,
								official_email: interest.official_email,
								employer_name: interest.employer_name,
								offered_price: interest.offered_price,
							}} />

							<SpecTable title="Accepted owner conditions" spec={objectValue(interest.accepted_conditions_snapshot)} />
						</aside>

						<div class="thread-column">
							{pendingCardsForViewer.length ? (
								<section class="rental-panel pending-panel">
									<div class="pending-head">
										<h2>Your pending task cards</h2>
										<span class="rental-badge">{pendingCardsForViewer.length} pending</span>
									</div>

									<div class="pending-list">
										{pendingCardsForViewer.map((card) => {
											const kind = answerSchemaKind(card);
											return (
												<ActionForm title={textValue(card.prompt, "Workflow request")} action={`/api/wf-rental/workflow/cards/${card.id}/answer`} submitLabel="Answer" successRedirect={`/wf/interests/${interestId}`}>
													{kind === "amount_proof" ? (
														<>
															<div class="rental-field">
																<label for={`amount-${card.id}`}>Amount</label>
																<input id={`amount-${card.id}`} name="answer.amount" type="number" data-number="true" />
															</div>
															<div class="rental-field full">
																<label for={`reference-${card.id}`}>Reference</label>
																<input id={`reference-${card.id}`} name="answer.reference" required />
															</div>
														</>
													) : kind === "yes_no" ? (
														<div class="rental-field">
															<label for={`answer-${card.id}`}>Answer</label>
															<select id={`answer-${card.id}`} name="answer.value" required>
																<option value="yes">Yes</option>
																<option value="no">No</option>
															</select>
														</div>
													) : (
														<div class="rental-field full">
															<label for={`answer-${card.id}`}>Answer</label>
															<textarea id={`answer-${card.id}`} name="answer.text" required>I will provide this.</textarea>
														</div>
													)}
													<input type="hidden" name="message" value={`Answered request: ${textValue(card.prompt, card.id as string)}`} />
												</ActionForm>
											);
										})}
									</div>
								</section>
							) : waitingMessage ? (
								<section class="rental-panel wait-panel">
									<h2>No action needed now</h2>
									<p class="rental-muted">{waitingMessage}</p>
								</section>
							) : null}

							{availableActions.length || availableCardTypes.length ? (
								<section class="rental-panel">
									<h2>Available next work</h2>

									<div class="action-grid">
										{availableActions.map((action) => {
											const warnings = Array.isArray(action.warnings) ? action.warnings.map(String) : [];
											const blocked = action.blocked === true;
											return (
												<div class="workflow-action-card">
													{warnings.length ? warnings.map((warning) => <p class="rental-muted">{warning}</p>) : null}
													{blocked ? (
														<button class="rental-button secondary" disabled>{textValue(action.label, "Action blocked")}</button>
													) : (
														<ActionForm title={textValue(action.label, "Run workflow action")} action="/api/wf-rental/workflow/actions" submitLabel={textValue(action.label, "Run action")} successRedirect={`/wf/interests/${interestId}`}>
															<input type="hidden" name="workflowInstanceId" value={workflowInstanceId} />
															<input type="hidden" name="actionId" value={textValue(action.id)} />
														</ActionForm>
													)}
												</div>
											);
										})}

										{availableCardTypes.map((cardType) => (
											<ActionForm title={textValue(cardType.label, "Create workflow card")} action="/api/wf-rental/workflow/cards" submitLabel={cardTypeSubmitLabel(cardType)} successRedirect={`/wf/interests/${interestId}`}>
												<input type="hidden" name="workflowInstanceId" value={workflowInstanceId} />
												<input type="hidden" name="cardType" value={textValue(cardType.id)} />
												<div class="rental-field full">
													<label for={`prompt-${textValue(cardType.id)}`}>{cardTypePromptLabel(cardType)}</label>
													<textarea id={`prompt-${textValue(cardType.id)}`} name="prompt" required>{cardTypeDefaultPrompt(cardType)}</textarea>
												</div>
												{cardTypeHelpText(cardType) ? <p class="rental-muted">{cardTypeHelpText(cardType)}</p> : null}
											</ActionForm>
										))}
									</div>
								</section>
							) : null}

							<section class="rental-panel">
								<h2>Workflow cards</h2>
								<div class="card-list">
									{cards.length ? cards.map((card) => <WorkflowCard card={card} responses={responses} />) : <p class="rental-muted">No workflow cards yet.</p>}
								</div>
							</section>

							{unresolvedRequiredCards.length ? (
								<section class="rental-panel">
									<h2>Unresolved required cards</h2>
									<p class="rental-muted">{unresolvedRequiredCards.length} required task card{unresolvedRequiredCards.length === 1 ? " is" : "s are"} still unresolved.</p>
								</section>
							) : null}

							<WorkflowTimeline events={events} />
						</div>
					</>
				) : (
					<div class="rental-panel">
						<h1>Negotiation unavailable</h1>
						<p class="rental-muted">Login as a workflow participant to view this thread.</p>
					</div>
				)
			}
		</div>
	</section>
</WorkflowRentalBase>

<style>
	.negotiation-grid {
		display: grid;
		grid-template-columns: 340px minmax(0, 1fr);
		gap: 18px;
		align-items: start;
	}

	.negotiation-grid aside,
	.thread-column,
	.card-list,
	.pending-list {
		display: grid;
		gap: 18px;
	}

	.action-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 18px;
	}

	.workflow-stage {
		display: grid;
		gap: 6px;
		border: 1px solid var(--r-border);
		border-radius: var(--r-radius);
		padding: 14px;
		background: var(--r-panel-soft);
	}

	.workflow-stage h2,
	.workflow-stage p {
		margin: 0;
	}

	.stage-accepted {
		border-color: rgba(55, 125, 95, 0.4);
		background: rgba(55, 125, 95, 0.1);
	}

	.stage-danger {
		border-color: rgba(160, 40, 40, 0.4);
		background: rgba(160, 40, 40, 0.1);
	}

	.workflow-action-card {
		display: grid;
		gap: 10px;
	}

	.pending-head {
		display: flex;
		justify-content: space-between;
		gap: 10px;
	}

	@media (max-width: 900px) {
		.negotiation-grid,
		.action-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
---
import ActionForm from "../../components/rental/ActionForm.astro";
import SpecTable from "../../components/rental/SpecTable.astro";
import ThreadPanel from "../../components/rental/ThreadPanel.astro";
import RentalBase from "../../layouts/RentalBase.astro";

export const prerender = false;

const interestId = Astro.params.interestId;

async function loadThread() {
	if (!interestId) return null;
	try {
		const response = await fetch(new URL(`/api/rental/negotiations/${interestId}`, Astro.url), {
			headers: {
				Accept: "application/json",
				Cookie: Astro.request.headers.get("cookie") ?? "",
			},
		});
		const payload = await response.json() as { data?: Record<string, unknown> };
		return response.ok ? payload.data ?? null : null;
	} catch {
		return null;
	}
}

const thread = await loadThread();
const asset = thread?.asset as Record<string, unknown> | undefined;
const interest = thread?.interest as Record<string, unknown> | undefined;
const rounds = (thread?.rounds as Array<Record<string, unknown>> | undefined) ?? [];
const viewerRole = String(thread?.viewerRole ?? "unknown");
const isOwner = viewerRole === "owner";
const isRenter = viewerRole === "renter";
const agreementId = typeof asset?.active_agreement_id === "string" ? asset.active_agreement_id : "";
const hasAgreement = Boolean(agreementId);

function objectValue(value: unknown): Record<string, unknown> {
	return value && typeof value === "object" && !Array.isArray(value)
		? (value as Record<string, unknown>)
		: {};
}

function terms(round: Record<string, unknown>) {
	return objectValue(round.terms_spec ?? round.termsSpec);
}

function card(round: Record<string, unknown>) {
	return objectValue(terms(round).card);
}

function cardAnswer(round: Record<string, unknown>) {
	return objectValue(terms(round).cardAnswer);
}

const answeredCardIds = new Set(
	rounds.map((round) => String(cardAnswer(round).cardId ?? "")).filter(Boolean),
);
const requestCards = rounds.filter((round) => Object.keys(card(round)).length);
const pendingCards = requestCards.filter((round) => {
	const cardId = String(card(round).cardId ?? "");
	return cardId && !answeredCardIds.has(cardId);
});
const canShowRenterNegotiation = isRenter && !hasAgreement && (rounds.length > 0 || pendingCards.length > 0);
---

<RentalBase title="Negotiation" description="Shared rental negotiation">
	<section class="rental-section">
		<div class="rental-shell negotiation-grid">
			{
				thread ? (
					<>
						<aside class="rental-panel">
							<p class="rental-kicker">Asset summary</p>
							<h1>{String(asset?.title ?? "Asset")}</h1>
							<p class="rental-muted">{String(asset?.location_label ?? "Location pending")}</p>
							<div class="rental-badges">
								<span class="rental-badge">{String(asset?.business_state ?? "state")}</span>
								<span class="rental-badge">{String(asset?.visibility_state ?? "visibility")}</span>
								<span class="rental-badge">{String(interest?.interest_state ?? "interest")}</span>
								<span class="rental-badge">role: {viewerRole}</span>
							</div>
							{
								agreementId && (
									<div class="agreement-result">
										<strong>Agreement accepted</strong>
										<span title={agreementId}>Final terms are frozen in agreement {agreementId}.</span>
										<span>Next step: booking amount confirmation or move-in handover.</span>
										<span class="rental-muted">Printable agreement data is available from the immutable agreement snapshot. Signed PDF upload/share is a follow-up using EmDash media.</span>
									</div>
								)
							}
							<SpecTable title="Renter details" spec={{
								name: interest?.name,
								official_email: interest?.official_email,
								employer_name: interest?.employer_name,
								offered_price: interest?.offered_price,
							}} />
							<SpecTable title="Accepted owner conditions" spec={interest?.accepted_conditions_snapshot as Record<string, unknown>} />
						</aside>
						<div class="thread-column">
							<ThreadPanel title="Pre-agreement thread" rounds={rounds} />
							{
								isRenter && !rounds.length && !hasAgreement ? (
									<div class="rental-panel wait-panel">
										<h2>Interest sent to owner</h2>
										<p class="rental-muted">
											Interest sent to owner / owner AI agent. Please await review and document requests.
										</p>
										<span class="rental-badge">No pending requests yet</span>
									</div>
								) : null
							}
							{
								isRenter && pendingCards.length ? (
									<section class="rental-panel pending-panel">
										<div class="pending-head">
											<h2>Pending requests</h2>
											<span class="rental-badge">{pendingCards.length} pending</span>
										</div>
										<div class="pending-list">
											{pendingCards.map((round) => {
												const requestCard = card(round);
												const cardId = String(requestCard.cardId ?? "");
												return (
													<ActionForm title={String(requestCard.prompt ?? "Owner request")} action={`/api/rental/negotiations/${interestId}/add-round`} submitLabel="Answer" successRedirect={`/interests/${interestId}`}>
														<input type="hidden" name="roundPhase" value="pre_agreement" />
														<input type="hidden" name="roundKind" value="answer" />
														<input type="hidden" name="roundState" value="answered" />
														<input type="hidden" name="termsSpec.cardAnswer.cardId" value={cardId} />
														<input type="hidden" name="termsSpec.cardAnswer.cardState" value="answered" />
														<div class="rental-field full">
															<label for={`answer-${cardId}`}>Answer</label>
															<textarea id={`answer-${cardId}`} name="termsSpec.cardAnswer.answerText" required>I will provide this.</textarea>
														</div>
														<div class="rental-field full">
															<label for={`options-${cardId}`}>Selected options</label>
															<textarea id={`options-${cardId}`} name="termsSpec.cardAnswer.selectedOptions" data-lines="true">Yes</textarea>
														</div>
														<div class="rental-field full">
															<label for={`attachment-${cardId}`}>Attachment/reference note</label>
															<input id={`attachment-${cardId}`} name="termsSpec.cardAnswer.attachmentNote" placeholder="UPI reference, document note, or EmDash media reference" />
														</div>
														<input type="hidden" name="message" value={`Answered request: ${String(requestCard.prompt ?? cardId)}`} />
													</ActionForm>
												);
											})}
										</div>
									</section>
								) : null
							}
							{
								hasAgreement ? (
									<section class="rental-panel next-step-panel">
										<h2>Booking and handover next steps</h2>
										<p class="rental-muted">Owner can request booking payment confirmation as a request card. Tenant can answer with reference text or an EmDash media reference placeholder.</p>
									</section>
								) : null
							}
							<div class="action-grid">
								{
									isOwner && !hasAgreement && (
										<>
											<ActionForm title="Create request card" action={`/api/rental/negotiations/${interestId}/add-round`} submitLabel="Ask question" successRedirect={`/interests/${interestId}`}>
												<input type="hidden" name="roundPhase" value="pre_agreement" />
												<input type="hidden" name="roundKind" value="question" />
												<input type="hidden" name="roundState" value="proposed" />
												<input type="hidden" name="termsSpec.card.cardId" value={`card_${Date.now()}`} />
												<input type="hidden" name="termsSpec.card.cardState" value="pending" />
												<div class="rental-field full">
													<label for="owner-question">Question</label>
													<textarea id="owner-question" name="termsSpec.card.prompt" required>Please upload company ID and salary slip.</textarea>
												</div>
												<div class="rental-field full">
													<label for="card-type">Request type</label>
													<select id="card-type" name="termsSpec.card.cardType">
														<option value="document_upload">Document upload</option>
														<option value="free_text">Free text</option>
														<option value="free_text_with_attachment">Free text with attachment</option>
														<option value="mcq_single">MCQ single</option>
														<option value="mcq_single_with_attachment">MCQ single with attachment</option>
														<option value="mcq_multi">MCQ multi</option>
														<option value="mcq_multi_with_attachment">MCQ multi with attachment</option>
														<option value="payment_confirmation">Payment confirmation</option>
														<option value="owner_action_request">Owner action request</option>
													</select>
												</div>
												<div class="rental-field full">
													<label for="card-options">Options</label>
													<textarea id="card-options" name="termsSpec.card.options" data-lines="true">Yes
No
Need discussion</textarea>
												</div>
												<div class="rental-field">
													<label>
														<input name="termsSpec.card.attachmentRequired" type="checkbox" checked />
														Attachment/reference required
													</label>
												</div>
												<input type="hidden" name="termsSpec.card.attachmentKind" value="document_or_reference" />
												<input type="hidden" name="message" value="Owner created a request card." />
											</ActionForm>
											<ActionForm title="Owner reject" action={`/api/rental/negotiations/${interestId}/add-round`} submitLabel="Reject" successRedirect={`/interests/${interestId}`}>
												<input type="hidden" name="roundPhase" value="pre_agreement" />
												<input type="hidden" name="roundKind" value="rejection" />
												<input type="hidden" name="roundState" value="rejected" />
												<div class="rental-field full">
													<label for="owner-reject">Reason</label>
													<textarea id="owner-reject" name="message">Application rejected.</textarea>
												</div>
											</ActionForm>
											<ActionForm title="Owner counter" action={`/api/rental/negotiations/${interestId}/add-round`} submitLabel="Counter" successRedirect={`/interests/${interestId}`}>
												<input type="hidden" name="roundPhase" value="pre_agreement" />
												<input type="hidden" name="roundKind" value="counter" />
												<input type="hidden" name="roundState" value="countered" />
												<div class="rental-field">
													<label for="counter-price">Price</label>
													<input id="counter-price" name="price" type="number" data-number="true" />
												</div>
												<div class="rental-field full">
													<label for="counter-message">Message</label>
													<textarea id="counter-message" name="message">Counter at listed rent.</textarea>
												</div>
											</ActionForm>
											<ActionForm title="Accept final terms" action={`/api/rental/negotiations/${interestId}/accept-final-terms`} submitLabel="Accept final terms" successRedirect="/owner">
												<input type="hidden" name="agreementKind" value="flat_rental" />
												<div class="rental-field">
													<label for="effectiveFrom">Effective from</label>
													<input id="effectiveFrom" name="effectiveFrom" value="2026-07-01" />
												</div>
												<div class="rental-field full">
													<label for="extraTerms-note">Extra term</label>
													<input id="extraTerms-note" name="extraTerms.note" value="Accepted from thin Astro UI." />
												</div>
											</ActionForm>
										</>
									)
								}
								{
									canShowRenterNegotiation && (
										<>
											<ActionForm title="Rent concession offer" action={`/api/rental/negotiations/${interestId}/add-round`} submitLabel="Offer" successRedirect={`/interests/${interestId}`}>
												<input type="hidden" name="roundPhase" value="pre_agreement" />
												<input type="hidden" name="roundKind" value="offer" />
												<input type="hidden" name="roundState" value="offered" />
												<div class="rental-field">
													<label for="offer-price">Price</label>
													<input id="offer-price" name="price" type="number" data-number="true" />
												</div>
												<div class="rental-field">
													<label for="offer-deposit">Deposit</label>
													<input id="offer-deposit" name="depositAmount" type="number" data-number="true" />
												</div>
												<div class="rental-field full">
													<label for="offer-message">Message</label>
													<textarea id="offer-message" name="message">I can move in quickly if rent is reduced.</textarea>
												</div>
											</ActionForm>
											<ActionForm title="Renter counter final terms" action={`/api/rental/negotiations/${interestId}/add-round`} submitLabel="Counter final terms" successRedirect={`/interests/${interestId}`}>
												<input type="hidden" name="roundPhase" value="pre_agreement" />
												<input type="hidden" name="roundKind" value="counter" />
												<input type="hidden" name="roundState" value="countered" />
												<div class="rental-field full">
													<label for="renter-counter-message">Message</label>
													<textarea id="renter-counter-message" name="message">I can accept with the updated start date.</textarea>
												</div>
											</ActionForm>
										</>
									)
								}
							</div>
						</div>
					</>
				) : (
					<div class="rental-panel">
						<h1>Negotiation unavailable</h1>
						<p class="rental-muted">Login as a participant to view this thread.</p>
					</div>
				)
			}
		</div>
	</section>
</RentalBase>

<style>
	.negotiation-grid {
		display: grid;
		grid-template-columns: 340px minmax(0, 1fr);
		gap: 18px;
		align-items: start;
	}

	.negotiation-grid aside,
	.thread-column {
		display: grid;
		gap: 18px;
	}

	.action-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 18px;
	}

	.agreement-result {
		display: grid;
		gap: 4px;
		border: 1px solid var(--r-border);
		border-radius: var(--r-radius);
		padding: 12px;
		background: var(--r-panel-soft);
		color: var(--r-brand-strong);
		overflow-wrap: anywhere;
	}

	.wait-panel,
	.pending-panel,
	.next-step-panel,
	.pending-list {
		display: grid;
		gap: 14px;
	}

	.pending-head {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
	}

	@media (max-width: 980px) {
		.negotiation-grid,
		.action-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
